<!-- pages/pet/pet.wxml -->
<view class="pet-immersive-page">

  <!-- 顶部状态栏与品牌 -->
  <view class="top-nav-bar flex align-center justify-between">
    <view class="flex align-center" style="gap: 12rpx;">
      <text style="font-size: 38rpx;">🐾</text>
      <view class="flex flex-col">
        <text class="brand-title">自律搭子 · 3D养成乐园</text>
        <text class="brand-sub">Our Teacher 陪伴进化体系</text>
      </view>
    </view>
    
    <view class="flex align-center" style="gap: 12rpx;">
      <!-- 勋章馆入口 -->
      <view class="badge-nav-pill flex align-center" bindtap="onOpenBadgeModal" wx:if="{{hasPet}}">
        <text style="font-size: 24rpx; margin-right: 6rpx;">🏅</text>
        <text style="font-size: 22rpx; font-weight: 800; color: #D97706;">勋章馆 ({{unlockedBadgeCount}}/6)</text>
      </view>
      <!-- 刷新按钮 -->
      <view class="refresh-pill" bindtap="onRefreshPage">
        <text style="font-size: 20rpx; color: #10B981; font-weight: 700;">🔄</text>
      </view>
    </view>
  </view>

  <!-- 状态 0：特性开关已关闭（全网下架 / 未开启） -->
  <block wx:if="{{!petSystemEnabled}}">
    <view class="disabled-state-box flex flex-col align-center justify-center">
      <view class="disabled-icon-wrap">
        <text style="font-size: 80rpx;">🐾</text>
        <view class="disabled-lock-badge">🔒</view>
      </view>
      <text class="disabled-title">自律搭子暂未开放</text>
      <text class="disabled-desc">该功能当前已由管理员在云端全网下架或维护调整，敬请期待后续上线！</text>
      
      <button class="btn-back-home" bindtap="onGoHome">
        🏠 返回首页看板
      </button>
    </view>
  </block>

  <!-- 页面主体加载态 -->
  <block wx:elif="{{loading}}">
    <view class="loading-container flex flex-col align-center justify-center">
      <view class="magic-spinner"></view>
      <text class="loading-text">正在唤醒 3D 自律搭子...</text>
    </view>
  </block>

  <!-- 状态 A：未领养状态（神兽蛋破壳孵化向导） -->
  <block wx:elif="{{!hasPet}}">
    <view class="adopt-showcase-flow">
      
      <!-- 引导标语 -->
      <view class="adopt-banner-card">
        <view class="flex align-center" style="gap: 10rpx; margin-bottom: 8rpx;">
          <text style="font-size: 32rpx;">🥚</text>
          <text style="font-size: 30rpx; font-weight: 900; color: #0F172A;">孵化你的 3D 神兽搭子</text>
        </view>
        <text class="banner-desc">
          每位自律者都拥有一颗专属神兽蛋。通过每日运动打卡注入能量，见证它从破壳幼体蜕变为终极传奇神兽！
        </text>
      </view>

      <!-- 3D 浮岛神兽蛋展台 -->
      <view class="adopt-3d-stage-box flex flex-col align-center">
        
        <view class="stage-3d-viewport flex align-center justify-center">
          <view class="ambient-sunbeam"></view>
          
          <!-- 神兽蛋 (带孵化摇晃动效与破壳光芒) -->
          <view class="egg-model-anchor {{hatchingStep > 0 ? 'egg-cracking-shake' : 'egg-idle-wobble'}}" bindtap="onTapEgg">
            <text class="egg-large-emoji">{{currentTypeInfo.eggEmoji}}</text>
            <view class="egg-crack-overlay" wx:if="{{hatchingStep >= 1}}">⚡</view>
            <view class="egg-shine-glow" wx:if="{{hatchingStep >= 2}}"></view>
            <view class="pet-dynamic-shadow"></view>
          </view>

          <!-- 3D 浮岛基座 -->
          <view class="stage-3d-island-disc">
            <view class="disc-top-ring"></view>
            <view class="disc-bottom-base"></view>
          </view>
        </view>

        <!-- 蛋属性标签 -->
        <view class="type-capsule" style="background: {{currentTypeInfo.themeBg}}; color: {{currentTypeInfo.themeColor}};">
          <text>{{currentTypeInfo.eggName}} · {{currentTypeInfo.tag}}</text>
        </view>
        <text class="type-motto">“{{currentTypeInfo.quote}}”</text>
      </view>

      <!-- 5 大神兽蛋选择 -->
      <view class="type-switch-panel">
        <text class="panel-label">选择你的专属神兽蛋：</text>
        <view class="type-grid">
          <view wx:for="{{types}}" wx:key="type" 
                class="type-item {{selectedType === item.type ? 'active' : ''}}" 
                bindtap="onSelectType" data-type="{{item.type}}">
            <text class="type-icon">{{item.eggEmoji}}</text>
            <text class="type-text">{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 起名面板 -->
      <view class="name-edit-panel">
        <text class="panel-label">为即将破壳的搭子起个名字：</text>
        <view class="input-row flex align-center">
          <input class="name-ipt" type="text" placeholder="例如：木木 / 小燃 / 豆豆" value="{{petName}}" bindinput="onInputName" maxlength="12" />
          <view class="dice-btn" bindtap="onRandomName">
            <text>🎲 换一个</text>
          </view>
        </view>

        <view class="candidate-row flex align-center">
          <text style="font-size: 22rpx; color: #94A3B8;">常用名：</text>
          <view wx:for="{{candidateNames}}" wx:key="*this" class="tag-name" bindtap="onSelectCandidateName" data-name="{{item}}">
            {{item}}
          </view>
        </view>
      </view>

      <!-- 孵化按钮 -->
      <view class="adopt-btn-wrap">
        <button class="btn-3d-adopt" bindtap="onStartHatchCeremony" loading="{{adopting}}">
          🥚 开启破壳仪式 · 唤醒搭子
        </button>
      </view>

    </view>
  </block>

  <!-- 状态 B：已领养状态（Our Teacher 3D 浮岛主舞台） -->
  <block wx:else>
    <view class="living-stage-wrapper">
      
      <!-- 顶部轻量浮动 HUD -->
      <view class="floating-hud-bar flex align-center justify-between">
        <view class="flex align-center" style="gap: 12rpx;">
          <text class="hud-pet-name">{{pet.name}}</text>
          <view class="hud-level-tag">Lv.{{pet.level}}</view>
          <!-- 进化阶数徽章 -->
          <view class="stage-rank-tag stage-rank-{{petStageRank}}">{{petStageName}}</view>
        </view>
        <view class="hud-streak-tag flex align-center">
          <text style="font-size: 24rpx; margin-right: 6rpx;">🔥</text>
          <text style="font-size: 22rpx; font-weight: 800; color: #EA580C;">陪伴第 {{pet.streakDays}} 天</text>
        </view>
      </view>

      <!-- 🌟 Our Teacher 风格 3D 核心景深互动舞台 -->
      <view class="virtual-3d-world">
        
        <!-- 环境光效与微尘粒子 -->
        <view class="world-sun-ray"></view>
        <view class="world-sparkle sp1">✨</view>
        <view class="world-sparkle sp2">🍃</view>
        <view class="world-sparkle sp3">✨</view>

        <!-- 进阶光环粒子 (Lv.5+ 进阶光芒 / Lv.10+ 究极神兽光芒) -->
        <view class="evolution-aura-ring evo-{{petStageRank}}" wx:if="{{petStageRank >= 2}}"></view>

        <!-- 悬浮台词气泡 -->
        <view class="speech-bubble-3d animate-bubble-float" wx:if="{{pet.dialogue}}">
          <text class="bubble-msg">“{{pet.dialogue}}”</text>
          <view class="bubble-arrow"></view>
        </view>

        <!-- 3D 宠物本体与触碰物理系统 -->
        <view class="pet-3d-character-stage flex align-center justify-center" bindtap="onTapPet">
          
          <!-- 迸发爱心粒子 -->
          <view class="heart-burst-particle {{heartAnim ? 'animate-heart-fly' : ''}}" wx:if="{{heartAnim}}">
            <text class="burst-text">❤️</text>
          </view>

          <!-- 飞行动画食物 (投喂抛物线) -->
          <view class="flying-food-projectile {{isFeeding ? 'animate-food-parabola' : ''}}" wx:if="{{isFeeding}}">
            <text class="food-emoji">{{foodIcon}}</text>
          </view>

          <!-- 浮动 EXP 飘字 -->
          <view class="floating-exp-gain {{isFeeding ? 'animate-exp-up' : ''}}" wx:if="{{isFeeding}}">
            <text class="exp-text">+10 EXP ✨</text>
          </view>

          <!-- 3D 活体宠物模型（支持待机呼吸、触碰Q弹、干饭咀嚼） -->
          <view class="pet-mesh-container {{isFeeding ? 'animate-pet-chew' : (isTouched ? 'animate-pet-squish' : 'animate-idle-breathe')}}">
            <image class="pet-cutout-img" src="{{pet.avatarUrl}}" mode="aspectFit"></image>
            <view class="pet-floor-shadow {{isFeeding ? 'shadow-chew' : (isTouched ? 'shadow-squish' : 'shadow-breathe')}}"></view>
          </view>

          <!-- 3D 悬浮草木浮岛底座 -->
          <view class="stage-3d-island-disc">
            <view class="disc-top-ring"></view>
            <view class="disc-bottom-base"></view>
          </view>

        </view>

        <!-- 心情胶囊栏 -->
        <view class="mood-bar-row flex align-center justify-center">
          <view class="mood-pill mood-{{pet.mood}} flex align-center">
            <text class="mood-icon">{{pet.mood === 'HAPPY' ? '😄' : (pet.mood === 'HUNGRY' ? '🥺' : (pet.mood === 'WANT_EXERCISE' ? '🏃' : '🌱'))}}</text>
            <text class="mood-text">{{pet.moodText}}</text>
          </view>
        </view>

        <!-- 互动指引 -->
        <view class="touch-hint-label">
          <text>👆 轻触身体抚摸它，它会 Q 弹跳动与你对话</text>
        </view>

      </view>

      <!-- 游戏化数值仪表盘 -->
      <view class="gamified-stats-deck">
        
        <!-- 饱食度 -->
        <view class="stat-gauge-cell">
          <view class="flex justify-between align-center" style="margin-bottom: 10rpx;">
            <view class="flex align-center" style="gap: 10rpx;">
              <text style="font-size: 28rpx;">🍖</text>
              <text class="gauge-name">饱食度 (不运动就挨饿哦)</text>
            </view>
            <text class="gauge-number" style="color: {{pet.fullness < 30 ? '#EF4444' : '#10B981'}};">{{pet.fullness}} / 100</text>
          </view>
          <view class="gauge-track">
            <view class="gauge-fill" style="width: {{pet.fullness}}%; background: {{pet.fullness < 30 ? '#EF4444' : 'linear-gradient(90deg, #34D399, #10B981)'}};"></view>
          </view>
        </view>

        <!-- 成长进度与进化预览 -->
        <view class="stat-gauge-cell" style="margin-top: 24rpx;">
          <view class="flex justify-between align-center" style="margin-bottom: 10rpx;">
            <view class="flex align-center" style="gap: 10rpx;">
              <text style="font-size: 28rpx;">📈</text>
              <text class="gauge-name">成长进度 (升级还差 {{pet.maxExp - pet.exp}} 经验)</text>
            </view>
            <text class="gauge-number" style="color: #6366F1;">{{pet.exp}} / {{pet.maxExp}}</text>
          </view>
          <view class="gauge-track">
            <view class="gauge-fill" style="width: {{(pet.exp / pet.maxExp) * 100}}%; background: linear-gradient(90deg, #6366F1, #8B5CF6);"></view>
          </view>
          <view class="evolution-next-tip flex align-center justify-between" style="margin-top: 10rpx;">
            <text style="font-size: 20rpx; color: #64748B;">下一形态：{{nextStageGoalText}}</text>
            <text style="font-size: 20rpx; font-weight: 700; color: #8B5CF6;">{{petStageProgressText}}</text>
          </view>
        </view>

        <!-- 亲密度与背包 -->
        <view class="stat-pills-row flex justify-between" style="margin-top: 24rpx;">
          <view class="pill-box flex align-center justify-center">
            <text style="font-size: 30rpx; margin-right: 8rpx;">❤️</text>
            <text style="font-size: 24rpx; color: #475569;">亲密度: <text style="font-weight: 900; color: #E11D48;">{{pet.intimacy}}</text></text>
          </view>
          <view class="pill-box flex align-center justify-center">
            <text style="font-size: 30rpx; margin-right: 8rpx;">🎒</text>
            <text style="font-size: 24rpx; color: #475569;">食物背包: <text style="font-weight: 900; color: #10B981;">{{pet.foodCount}}</text> 份</text>
          </view>
        </view>

      </view>

      <!-- 核心 3D 操作按键区 -->
      <view class="action-deck-card flex flex-col">
        <view class="flex justify-between" style="gap: 18rpx;">
          
          <button class="btn-3d-action btn-3d-feed flex align-center justify-center" bindtap="onFeedPet" disabled="{{isFeeding || pet.foodCount <= 0}}">
            <text style="font-size: 34rpx; margin-right: 10rpx;">🥣</text>
            <text style="font-weight: 900;">{{pet.foodCount > 0 ? '立即投喂 (' + pet.foodCount + ')' : '暂无食物'}}</text>
          </button>

          <button class="btn-3d-action btn-3d-exercise flex align-center justify-center" bindtap="onGoExercise">
            <text style="font-size: 34rpx; margin-right: 10rpx;">🏃</text>
            <text style="font-weight: 900;">去运动打卡</text>
          </button>

        </view>

        <view class="daily-reward-tip flex align-center" style="margin-top: 20rpx;">
          <text style="font-size: 28rpx; margin-right: 12rpx;">💡</text>
          <text class="tip-content">
            每次在首页完成运动打卡（快走/慢跑/力量等），即可为搭子免费赚取 1 份营养粮！
          </text>
        </view>
      </view>

    </view>
  </block>

  <!-- 🌟 勋章馆弹窗 (Badge Showcase Modal) -->
  <view class="badge-modal-backdrop {{showBadgeModal ? 'show' : ''}}" bindtap="onCloseBadgeModal">
    <view class="badge-modal-sheet" catchtap="noBubble">
      
      <view class="sheet-header flex justify-between align-center">
        <view class="flex align-center" style="gap: 10rpx;">
          <text style="font-size: 36rpx;">🏅</text>
          <text class="sheet-title">自律成就勋章馆</text>
        </view>
        <text class="sheet-close" bindtap="onCloseBadgeModal">✕</text>
      </view>
      <text class="sheet-subtitle">每一次打卡与投喂，都在见证你与搭子的蜕变！</text>

      <!-- 勋章网格列表 -->
      <view class="badge-grid-list">
        <view wx:for="{{badgeList}}" wx:key="id" 
              class="badge-card-item {{item.unlocked ? 'unlocked' : 'locked'}}" 
              bindtap="onTapBadgeItem" data-item="{{item}}">
          
          <view class="badge-icon-wrap">
            <text class="badge-emoji">{{item.icon}}</text>
            <view class="badge-lock-tag" wx:if="{{!item.unlocked}}">🔒</view>
            <view class="badge-check-tag" wx:if="{{item.unlocked}}">✓</view>
          </view>
          
          <text class="badge-name">{{item.name}}</text>
          <text class="badge-req">{{item.unlocked ? '已解锁' : item.req}}</text>
        </view>
      </view>

      <!-- 选中勋章详情展示卡 -->
      <view class="badge-detail-card flex align-center" wx:if="{{selectedBadge}}">
        <text style="font-size: 54rpx; margin-right: 18rpx;">{{selectedBadge.icon}}</text>
        <view class="flex flex-col flex-1">
          <view class="flex align-center" style="gap: 10rpx;">
            <text style="font-size: 28rpx; font-weight: 900; color: #0F172A;">{{selectedBadge.name}}</text>
            <view class="badge-status-pill {{selectedBadge.unlocked ? 'unlocked' : 'locked'}}">
              {{selectedBadge.unlocked ? '✨ 达成成就' : '🔒 待解锁'}}
            </view>
          </view>
          <text style="font-size: 22rpx; color: #64748B; margin-top: 6rpx;">{{selectedBadge.desc}}</text>
        </view>
      </view>

    </view>
  </view>

  <!-- 🌟 形态进化庆祝全屏弹窗 (Evolution Celebration Modal) -->
  <view class="evo-modal-backdrop {{showEvolutionModal ? 'show' : ''}}">
    <view class="evo-modal-card flex flex-col align-center">
      <view class="evo-fireworks">🎉✨🌟✨🎉</view>
      <text class="evo-title">恭喜搭子完成形态进化！</text>
      <text class="evo-subtitle">自律的力量让它完成了华丽蜕变！</text>

      <view class="evo-stage-avatar-box">
        <view class="evo-radiant-glow"></view>
        <image class="evo-pet-avatar" src="{{pet.avatarUrl}}" mode="aspectFit"></image>
      </view>

      <view class="evo-rank-badge">
        <text style="font-size: 28rpx; font-weight: 900; color: #FFFFFF;">🌟 {{petStageName}} 🌟</text>
      </view>
      <text class="evo-quote">“多亏了主人的每天自律，我变得更强更有力量啦！”</text>

      <button class="btn-evo-confirm" bindtap="onCloseEvolutionModal">
        💪 收到！继续保持自律
      </button>
    </view>
  </view>

</view>
