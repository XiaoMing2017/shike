<!-- pages/pet/pet.wxml — 《Pocket Love》风格 2.5D 微缩自律生活系统 -->
<view class="pet-page-container">

  <!-- 顶部沉浸式导航栏 -->
  <view class="custom-nav-bar flex align-center justify-between">
    <view class="flex align-center" style="gap: 12rpx;">
      <text class="nav-title-text">🏡 自律搭子乐园</text>
      <text class="nav-sub-tag">Pocket Love 治愈微缩</text>
    </view>
    <view class="flex align-center" style="gap: 16rpx;" wx:if="{{hasPet}}">
      <view class="nav-badge-pill flex align-center" bindtap="onOpenBadgeModal">
        <text class="badge-icon">🏆</text>
        <text class="badge-num">勋章墙</text>
      </view>
      <view class="nav-dex-pill flex align-center" bindtap="onOpenDexModal">
        <text class="dex-icon">📖</text>
        <text class="dex-text">图鉴</text>
      </view>
    </view>
  </view>

  <!-- 页面 Loading -->
  <view class="loading-state-box flex flex-direction align-center justify-center" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在唤醒你的自律小屋...</text>
  </view>

  <!-- 状态 A：未领养（破壳领养仪式） -->
  <block wx:elif="{{!hasPet}}">
    <view class="adoption-card-wrapper animate-fade-in">
      <view class="adopt-hero-header text-center">
        <view class="hero-sparkle-title">✨ 选择你的第一位自律搭子</view>
        <text class="hero-sub-desc">像《Pocket Love》一样，与软萌搭子住进微缩阳光小屋，陪伴你每天轻盈自律！</text>
      </view>

      <!-- 5 种搭子轮播卡片 -->
      <view class="egg-species-selector flex justify-between">
        <view wx:for="{{types}}" wx:key="type" 
              class="species-tab-item {{selectedType === item.type ? 'active' : ''}}"
              bindtap="onSelectType" data-type="{{item.type}}">
          <text class="tab-emoji">{{item.icon}}</text>
          <text class="tab-name">{{item.name}}</text>
        </view>
      </view>

      <!-- 选中的搭子展示舞台 -->
      <view class="adopt-pet-preview-stage flex flex-direction align-center justify-center">
        <view class="preview-halo-ring"></view>
        <image class="preview-pet-sprite animate-float" src="{{currentTypeInfo.stages[0].image}}" mode="aspectFit"></image>
        <view class="preview-shadow"></view>
        <view class="preview-tag-badge">{{currentTypeInfo.tag}}</view>
      </view>

      <!-- 搭子专属简介与初始食粮 -->
      <view class="adopt-pet-intro-card">
        <view class="flex justify-between align-center" style="margin-bottom: 12rpx;">
          <text class="intro-species-name">{{currentTypeInfo.name}}</text>
          <text class="intro-fav-food">专属喜好：{{currentTypeInfo.food}}</text>
        </view>
        <text class="intro-quote-text">“{{currentTypeInfo.quote}}”</text>
      </view>

      <!-- 取一个温暖的名字 -->
      <view class="naming-input-box">
        <view class="naming-label flex justify-between align-center">
          <text>给搭子起个名字吧：</text>
          <text class="naming-hint">支持随时修改</text>
        </view>
        <input class="pet-name-input" type="text" value="{{petName}}" bindinput="onInputName" maxlength="8" placeholder="输入可爱的名字" />
        <view class="candidate-names-row flex align-center">
          <text class="cand-label">推荐：</text>
          <view class="cand-tags-list flex align-center" style="gap: 10rpx;">
            <text wx:for="{{candidateNames}}" wx:key="*this" class="cand-tag" bindtap="onPickCandidateName" data-name="{{item}}">{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 直接领养按钮 -->
      <view class="adopt-btn-wrap">
        <button class="btn-3d-adopt" bindtap="onDirectAdopt" loading="{{adopting}}">
          💖 领养 {{petName || currentTypeInfo.name}} · 开启自律生活
        </button>
      </view>
    </view>
  </block>

  <!-- 状态 B：已领养（《Pocket Love》微缩自律生活主舞台） -->
  <block wx:else>
    <view class="living-stage-wrapper">
      
      <!-- 顶部浮动 HUD -->
      <view class="floating-hud-bar flex align-center justify-between">
        <view class="flex align-center" style="gap: 12rpx;">
          <text class="hud-pet-name">{{pet.name}}</text>
          <text class="hud-species-tag">{{currentStageInfo.name}}</text>
          <view class="hud-level-tag">Lv.{{pet.level}}</view>
        </view>
        <view class="stage-rank-tag stage-rank-{{petStageRank}}">{{currentStageInfo.stageTitle}}</view>
      </view>

      <!-- 🌟 2.5D 治愈等轴测微缩自律小屋核心互动舞台 -->
      <view class="virtual-3d-world">
        
        <!-- 3D 沉浸式阳光原木自律小屋场景底图 (纯净无重影) -->
        <image class="world-scene-bg" src="{{currentSceneBg || '/images/pets/scene_cozy_diorama_clean.jpg'}}" mode="aspectFill" />

        <!-- 昼夜光影氛围滤镜层 -->
        <view class="lighting-overlay lighting-{{lightingMode}}"></view>

        <!-- 环境光效与微尘粒子 -->
        <view class="world-sun-ray" wx:if="{{lightingMode === 'DAY'}}"></view>
        <view class="world-sparkle sp1">✨</view>
        <view class="world-sparkle sp2">🍃</view>
        <view class="world-sparkle sp3">🌸</view>

        <!-- 🌟 主角萌宠（如🐰小白兔）在房间各个家具间平滑跳跃漫步与自律生活互动 -->
        <view class="pet-25d-dynamic-anchor {{isMovingSpot ? 'pet-hopping-move' : ''}} pet-facing-{{petFacing}}"
              style="bottom: {{currentSpot.bottom}}; left: {{currentSpot.left}};"
              catchtap="onTapPet">
          
          <!-- 🌟 Pocket Love 风格头顶生动自律生活胶囊 -->
          <view class="pocket-emote-pill {{isTouched ? 'pill-bounce-joy' : 'pill-float-gentle'}}" wx:if="{{!isMovingSpot}}">
            <text class="emote-text">{{currentSpot.emoteBadge || '🌸 悠闲自律中'}}</text>
          </view>

          <!-- 起跳/落地可爱卡通扬尘微粒 -->
          <view class="dust-puff-anim" wx:if="{{showDustPuff}}"></view>

          <!-- 迸发爱心粒子 -->
          <view class="heart-burst-particle {{heartAnim ? 'animate-heart-fly' : ''}}" wx:if="{{heartAnim}}">
            <text class="burst-text">❤️</text>
          </view>

          <!-- 飞行动画食物 (投喂抛物线) -->
          <view class="flying-food-projectile {{isFeeding ? 'animate-food-parabola' : ''}}" wx:if="{{isFeeding}}">
            <text class="food-emoji">{{foodIcon}}</text>
          </view>

          <!-- 浮动 EXP 飘字 -->
          <view class="floating-exp-gain {{isFeeding ? 'animate-exp-up' : ''}}" wx:if="{{isFeeding}}">
            <text class="exp-text">+10 能量 ✨</text>
          </view>

          <!-- 🌟 灵动活体萌宠容器 (根据自律打卡状态触发专属动作) -->
          <view class="pet-mesh-container stage-size-{{petStageRank}} {{isFeeding ? 'animate-pet-chew' : (isTouched ? 'animate-bunny-joy' : ('state-' + (petAnimState || currentSpot.actionState || 'IDLE')))}}">
            
            <!-- 手绘精美主体立绘 (如小白兔) -->
            <image class="pet-cutout-img" src="{{activePetImage || '/images/pets/sprite_bunny.png'}}" mode="aspectFit"></image>

            <!-- 🐰 灵动双耳自然摇晃物理层 -->
            <view class="bunny-ear-twitch-layer {{isTouched ? 'ears-excited' : 'ears-sway-loop'}}"></view>

            <!-- 🌟 自然灵动眨眼蒙皮层 -->
            <view class="pet-25d-eyelid-overlay {{isTouched ? 'eyes-joy-smile' : (petAnimState === 'DEEP_SLEEP' || currentSpotId === 'BED' ? 'eyes-sleeping-closed' : 'eyes-blink-loop')}}">
              <view class="eyelid-mask eye-left"></view>
              <view class="eyelid-mask eye-right"></view>
            </view>

            <!-- 🌟 脸颊粉晕微呼吸动效 -->
            <view class="pet-25d-blush-aura {{isTouched ? 'blush-excited' : ''}}"></view>

            <!-- 🌟 6 大家具打卡专属动态生活道具 -->
            <!-- 1. 露台小花园：跳绳燃脂与飞旋小彩绳 -->
            <view class="spot-prop-item prop-rope-jump" wx:if="{{currentSpotId === 'GARDEN'}}">
              <view class="jump-rope-arc"></view>
              <text class="prop-emoji">🔥</text>
            </view>
            
            <!-- 2. 客厅沙发：享用减脂轻食沙拉与木勺 -->
            <view class="spot-prop-item prop-salad-bowl" wx:if="{{currentSpotId === 'SOFA'}}">
              <text class="prop-emoji">🥗</text>
            </view>
            
            <!-- 3. 水吧补水角：咕嘟喝温水杯与水润微光 -->
            <view class="spot-prop-item prop-water-cup" wx:if="{{currentSpotId === 'WATER_BAR'}}">
              <text class="prop-emoji">💧</text>
            </view>

            <!-- 4. 雕花暖床：被窝安睡浮动 zZ 气泡 -->
            <view class="spot-prop-item prop-sleep-zz" wx:if="{{currentSpotId === 'BED'}}">
              <text class="prop-emoji-zz">zZ</text>
            </view>

            <!-- 5. 专注书桌：整理手账日历与小铅笔 -->
            <view class="spot-prop-item prop-desk-study" wx:if="{{currentSpotId === 'DESK'}}">
              <text class="prop-emoji">✍️</text>
            </view>

            <!-- 6. 梳妆穿衣镜：身材管理量腰围与自信光芒 -->
            <view class="spot-prop-item prop-mirror-shine" wx:if="{{currentSpotId === 'DRESSER'}}">
              <text class="prop-emoji">🪞</text>
            </view>

            <!-- 🌟 地面真实接触物理阴影（随呼吸与跳跃联动） -->
            <view class="pet-floor-shadow {{isMovingSpot ? 'shadow-hop-shrink' : (isFeeding ? 'shadow-chew' : (isTouched ? 'shadow-joy' : 'shadow-25d-breath'))}}"></view>
          </view>

        </view>

        <!-- 🌟 悬浮动态闺蜜台词气泡 -->
        <view class="speech-bubble-3d animate-bubble-float {{aiThinking ? 'bubble-thinking' : ''}}">
          <view class="flex align-center" wx:if="{{aiThinking}}">
            <text class="bubble-msg" style="color: #EC4899;">💭 搭子正在组织温暖的语言...</text>
          </view>
          <block wx:else>
            <text class="bubble-msg">“{{petDialogue || pet.dialogue}}”</text>
          </block>
          <view class="bubble-arrow"></view>
        </view>

        <!-- ☀️ 昼夜光影与 📸 拍照快捷浮动条 -->
        <view class="cozy-tools-dock flex align-center">
          <view class="tool-btn-pill" catchtap="onToggleLightingMode" hover-class="btn-hover">
            <text class="tool-icon">{{lightingMode === 'NIGHT' ? '🌙' : (lightingMode === 'SUNSET' ? '🌅' : '☀️')}}</text>
            <text class="tool-label">{{lightingMode === 'NIGHT' ? '夜光' : (lightingMode === 'SUNSET' ? '黄昏' : '日光')}}</text>
          </view>
          <view class="tool-btn-pill" catchtap="onOpenPolaroidModal" hover-class="btn-hover">
            <text class="tool-icon">📸</text>
            <text class="tool-label">拍照</text>
          </view>
          <view class="tool-btn-pill" catchtap="onOpenSceneModal" hover-class="btn-hover">
            <text class="tool-icon">🎨</text>
            <text class="tool-label">换景</text>
          </view>
        </view>

        <!-- 🎵 治愈黑胶唱片机组件 -->
        <view class="cozy-vinyl-dock {{isPlayingMusic ? 'is-playing' : ''}}" catchtap="onToggleMusicPlayer">
          <view class="vinyl-disc-wrap {{isPlayingMusic ? 'animate-vinyl-spin' : ''}}">
            <view class="vinyl-center-label">🌸</view>
          </view>
          <view class="vinyl-track-info flex align-center">
            <text class="vinyl-track-name">{{currentSongName || 'Flower'}}</text>
            <text class="vinyl-note-badge" wx:if="{{isPlayingMusic}}">♪</text>
          </view>
          <view class="floating-music-notes" wx:if="{{isPlayingMusic}}">
            <text class="m-note n1">♪</text>
            <text class="m-note n2">♫</text>
          </view>
        </view>

        <!-- 🛋️ 房间家具点位快捷导览条 -->
        <view class="room-spot-dock-bar flex align-center justify-center">
          <view wx:for="{{roomSpots}}" wx:key="id" 
                class="spot-dock-item {{currentSpotId === item.id ? 'active' : ''}}"
                catchtap="onSelectRoomSpot" data-id="{{item.id}}">
            <text class="dock-icon">{{item.icon}}</text>
            <text class="dock-name">{{item.name}}</text>
          </view>
        </view>

        <!-- 心情胶囊栏与陪伴天数 -->
        <view class="mood-bar-row flex align-center justify-center" style="gap: 14rpx;">
          <view class="mood-pill mood-{{pet.mood}} flex align-center">
            <text class="mood-icon">{{pet.mood === 'HAPPY' ? '😄' : (pet.mood === 'WAITING' ? '💭' : (pet.mood === 'HUNGRY' ? '🥺' : '🌸'))}}</text>
            <text class="mood-text">{{pet.moodText}}</text>
          </view>
          <view class="hud-streak-tag flex align-center">
            <text style="font-size: 22rpx; margin-right: 4rpx;">🔥</text>
            <text style="font-size: 20rpx; font-weight: 800; color: #EA580C;">连续自律第 {{pet.streakDays}} 天</text>
          </view>
        </view>

        <!-- 互动指引 -->
        <view class="touch-hint-label">
          <text>👆 轻触兔子蹦跳抚摸 · 完成打卡触发专属生活动作</text>
        </view>

      </view>

      <!-- 🎋 自律心声与闺蜜互动 -->
      <view class="treehole-chat-deck">
        <view class="flex justify-between align-center" style="margin-bottom: 16rpx;">
          <view class="flex align-center" style="gap: 8rpx;">
            <text style="font-size: 30rpx;">🎋</text>
            <text style="font-size: 26rpx; font-weight: 900; color: #0F172A;">自律心声 · 听听搭子怎么说</text>
          </view>
          <text style="font-size: 20rpx; color: #EC4899; font-weight: 700;">闺蜜专属夸夸 ✨</text>
        </view>
        <text style="font-size: 22rpx; color: #64748B; margin-bottom: 16rpx; display: block;">选择你此刻的自律状态，让搭子为你充充电：</text>

        <!-- 情绪胶囊矩阵 -->
        <view class="interactive-chips-grid">
          <view class="chip-action-btn" bindtap="onTapQuickPrompt" data-prompt="今天按时完成了运动燃脂，快夸夸我！">
            <text class="chip-emoji">🏃</text>
            <text class="chip-title">运动打卡求表扬</text>
          </view>
          <view class="chip-action-btn" bindtap="onTapQuickPrompt" data-prompt="今天喝了好多水，感觉身体很轻盈！">
            <text class="chip-emoji">💧</text>
            <text class="chip-title">饮水充足求夸奖</text>
          </view>
          <view class="chip-action-btn" bindtap="onTapQuickPrompt" data-prompt="今天工作好累好想偷懒，快给我一点坚持下去的动力！">
            <text class="chip-emoji">🥺</text>
            <text class="chip-title">今天好累求抱抱</text>
          </view>
          <view class="chip-action-btn" bindtap="onTapQuickPrompt" data-prompt="晚上特别嘴馋想吃高热量炸鸡宵夜，快帮我稳住心态！">
            <text class="chip-emoji">🍗</text>
            <text class="chip-title">嘴馋想吃宵夜</text>
          </view>
          <view class="chip-action-btn" bindtap="onTapQuickPrompt" data-prompt="按时吃了健康的减脂餐，打卡完毕！">
            <text class="chip-emoji">🥗</text>
            <text class="chip-title">吃完减脂餐打卡</text>
          </view>
          <view class="chip-action-btn" bindtap="onTapQuickPrompt" data-prompt="准备睡觉啦，晚安！明天也要一起加油哦！">
            <text class="chip-emoji">🌙</text>
            <text class="chip-title">互道晚安美容觉</text>
          </view>
        </view>
      </view>

      <!-- 🎮 自律成长仪表盘与赚粮任务卡片 -->
      <view class="gamified-stats-deck">
        
        <!-- 饱食度 -->
        <view class="stat-gauge-cell">
          <view class="flex justify-between align-center" style="margin-bottom: 10rpx;">
            <view class="flex align-center" style="gap: 10rpx;">
              <text style="font-size: 28rpx;">🍎</text>
              <text class="gauge-name">饱食度 (零压力自然代谢)</text>
            </view>
            <text class="gauge-number" style="color: {{pet.fullness < 30 ? '#F43F5E' : '#10B981'}};">{{pet.fullness}} / 100</text>
          </view>
          <view class="gauge-track">
            <view class="gauge-fill" style="width: {{pet.fullness}}%; background: {{pet.fullness < 30 ? '#F43F5E' : 'linear-gradient(90deg, #34D399, #10B981)'}};"></view>
          </view>
        </view>

        <!-- 成长进度 -->
        <view class="stat-gauge-cell" style="margin-top: 24rpx;">
          <view class="flex justify-between align-center" style="margin-bottom: 10rpx;">
            <view class="flex align-center" style="gap: 10rpx;">
              <text style="font-size: 28rpx;">🌸</text>
              <text class="gauge-name">成长蜕变 (距离下一阶段还差 {{pet.maxExp - pet.exp}} 能量)</text>
            </view>
            <text class="gauge-number" style="color: #EC4899;">{{pet.exp}} / {{pet.maxExp}}</text>
          </view>
          <view class="gauge-track">
            <view class="gauge-fill" style="width: {{(pet.exp / pet.maxExp) * 100}}%; background: linear-gradient(90deg, #F472B6, #EC4899);"></view>
          </view>
          <view class="evolution-next-tip flex align-center justify-between" style="margin-top: 10rpx;">
            <text style="font-size: 20rpx; color: #64748B;">成长目标：{{nextStageGoalText}}</text>
            <text style="font-size: 20rpx; font-weight: 700; color: #EC4899;">{{petStageProgressText}}</text>
          </view>
        </view>

        <!-- 亲密度与粮仓 -->
        <view class="stat-pills-row flex justify-between" style="margin-top: 24rpx;">
          <view class="pill-box flex align-center justify-center">
            <text style="font-size: 30rpx; margin-right: 8rpx;">❤️</text>
            <view class="flex flex-direction">
              <text class="p-val">{{pet.intimacy}}</text>
              <text class="p-lbl">亲密度</text>
            </view>
          </view>
          <view class="pill-box flex align-center justify-center">
            <text style="font-size: 30rpx; margin-right: 8rpx;">🥕</text>
            <view class="flex flex-direction">
              <text class="p-val">{{pet.foodCount || 0}}</text>
              <text class="p-lbl">粮仓库存</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 🌾 真实打卡驱动赚粮任务面板 -->
      <view class="daily-food-quests-card">
        <view class="flex justify-between align-center" style="margin-bottom: 20rpx;">
          <view class="flex align-center" style="gap: 10rpx;">
            <text style="font-size: 32rpx;">🌾</text>
            <text style="font-size: 28rpx; font-weight: 900; color: #0F172A;">自律赚粮 · 今日生活联动</text>
          </view>
          <view class="quest-count-badge">已完成 {{earnedFoodCount}} / 5</view>
        </view>

        <view class="quest-list-wrapper">
          <!-- 1. 每日签到 -->
          <view class="quest-item-row flex justify-between align-center">
            <view class="flex align-center" style="gap: 16rpx;">
              <view class="quest-icon-wrap bg-checkin">🌱</view>
              <view class="flex flex-direction">
                <text class="quest-title">每日乐园打卡签到</text>
                <text class="quest-reward">+1 爱心粮 · 整理手账 ✍️</text>
              </view>
            </view>
            <view class="quest-action-box">
              <button class="btn-quest-done" wx:if="{{foodTasks.checkin}}" disabled>已完成 ✨</button>
              <button class="btn-quest-go" wx:else bindtap="onDailyCheckin">签到</button>
            </view>
          </view>

          <!-- 2. 运动打卡 -->
          <view class="quest-item-row flex justify-between align-center">
            <view class="flex align-center" style="gap: 16rpx;">
              <view class="quest-icon-wrap bg-exercise">🏃</view>
              <view class="flex flex-direction">
                <text class="quest-title">完成今日运动燃脂</text>
                <text class="quest-reward">+1 爱心粮 · 露台跳绳 🔥</text>
              </view>
            </view>
            <view class="quest-action-box">
              <button class="btn-quest-done" wx:if="{{foodTasks.exercise}}" disabled>已完成 ✨</button>
              <button class="btn-quest-go" wx:else bindtap="onGoExercise">去运动</button>
            </view>
          </view>

          <!-- 3. 饮食打卡 -->
          <view class="quest-item-row flex justify-between align-center">
            <view class="flex align-center" style="gap: 16rpx;">
              <view class="quest-icon-wrap bg-diet">🥗</view>
              <view class="flex flex-direction">
                <text class="quest-title">记录三餐饮食打卡</text>
                <text class="quest-reward">+1 爱心粮 · 享用轻食 🥗</text>
              </view>
            </view>
            <view class="quest-action-box">
              <button class="btn-quest-done" wx:if="{{foodTasks.diet}}" disabled>已完成 ✨</button>
              <button class="btn-quest-go" wx:else bindtap="onGoDiet">去记餐</button>
            </view>
          </view>

          <!-- 4. 喝水打卡 -->
          <view class="quest-item-row flex justify-between align-center">
            <view class="flex align-center" style="gap: 16rpx;">
              <view class="quest-icon-wrap bg-water">💧</view>
              <view class="flex flex-direction">
                <text class="quest-title">完成饮水自律目标</text>
                <text class="quest-reward">+1 爱心粮 · 水吧补水 💧</text>
              </view>
            </view>
            <view class="quest-action-box">
              <button class="btn-quest-done" wx:if="{{foodTasks.water}}" disabled>已完成 ✨</button>
              <button class="btn-quest-go" wx:else bindtap="onGoWater">去喝水</button>
            </view>
          </view>

          <!-- 5. 体重记录 -->
          <view class="quest-item-row flex justify-between align-center">
            <view class="flex align-center" style="gap: 16rpx;">
              <view class="quest-icon-wrap bg-weight">⚖️</view>
              <view class="flex flex-direction">
                <text class="quest-title">晨起记录体态体重</text>
                <text class="quest-reward">+1 爱心粮 · 镜前照体态 🪞</text>
              </view>
            </view>
            <view class="quest-action-box">
              <button class="btn-quest-done" wx:if="{{foodTasks.weight}}" disabled>已完成 ✨</button>
              <button class="btn-quest-go" wx:else bindtap="onGoWeight">去称重</button>
            </view>
          </view>
        </view>
      </view>

      <!-- 底部核心投喂与抚摸操作栏 -->
      <view class="bottom-action-dock flex justify-between align-center">
        <view class="btn-dock-touch flex flex-direction align-center justify-center" bindtap="onTapPet" hover-class="btn-hover">
          <text class="dock-emoji">👋</text>
          <text class="dock-txt">抚摸互动</text>
        </view>
        <view class="btn-dock-feed flex align-center justify-center" bindtap="onFeedPet" hover-class="btn-hover" style="opacity: {{pet.foodCount > 0 ? 1 : 0.8}};">
          <text style="font-size: 36rpx; margin-right: 12rpx;">{{foodIcon}}</text>
          <text style="font-size: 28rpx; font-weight: 900; color: #FFFFFF;">爱心投喂 (余 {{pet.foodCount || 0}})</text>
        </view>
      </view>

    </view>
  </block>

  <!-- 📸 拍立得瞬间相册弹窗 -->
  <view class="modal-mask flex align-center justify-center" wx:if="{{showPolaroidModal}}" catchtap="onClosePolaroidModal">
    <view class="polaroid-card-modal animate-scale-up" catchtap="noBubble">
      <view class="polaroid-top-bar flex justify-between align-center">
        <text class="p-modal-title">📸 今日自律拍立得</text>
        <text class="p-close-btn" catchtap="onClosePolaroidModal">✕</text>
      </view>
      <view class="polaroid-photo-frame">
        <image class="polaroid-scene-bg" src="{{currentSceneBg || '/images/pets/scene_cozy_diorama_clean.jpg'}}" mode="aspectFill" />
        <image class="polaroid-pet-cutout animate-bunny-joy" src="{{activePetImage || '/images/pets/sprite_bunny.png'}}" mode="aspectFit" />
        <view class="polaroid-lighting-tint lighting-{{lightingMode}}"></view>
        <view class="polaroid-photo-watermark">
          <text>食刻 · 自律生活</text>
        </view>
      </view>
      <view class="polaroid-caption-box">
        <text class="p-date-tag">{{polaroidDate}}</text>
        <view class="p-quote-row flex justify-between align-center">
          <text class="p-quote-text">“{{polaroidQuote}}”</text>
          <text class="p-refresh-icon" catchtap="onRefreshPolaroidQuote">🔄</text>
        </view>
      </view>
      <view class="polaroid-action-wrap">
        <button class="btn-save-polaroid" catchtap="onSavePolaroidCard" loading="{{polaroidSaving}}">💖 保存分享卡片</button>
      </view>
    </view>
  </view>

  <!-- 🎨 场景选择弹窗 -->
  <view class="modal-mask flex align-center justify-center" wx:if="{{showSceneModal}}" catchtap="onCloseSceneModal">
    <view class="scene-picker-modal animate-scale-up" catchtap="noBubble">
      <view class="flex justify-between align-center" style="margin-bottom: 20rpx;">
        <text style="font-size: 30rpx; font-weight: 900; color: #0F172A;">🎨 选择生活场景</text>
        <text class="p-close-btn" catchtap="onCloseSceneModal">✕</text>
      </view>
      <view class="scene-grid-list">
        <view wx:for="{{sceneList}}" wx:key="id" 
              class="scene-card-item {{currentSceneId === item.id ? 'active' : ''}}"
              catchtap="onSelectScene" data-id="{{item.id}}">
          <image class="scene-card-cover" src="{{item.image}}" mode="aspectFill"></image>
          <view class="scene-card-info">
            <view class="flex align-center justify-between">
              <text class="sc-name">{{item.name}}</text>
              <text class="sc-tag">{{item.tag}}</text>
            </view>
            <text class="sc-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 📖 搭子全图鉴弹窗 -->
  <view class="modal-mask flex align-center justify-center" wx:if="{{showDexModal}}" catchtap="onCloseDexModal">
    <view class="dex-card-modal animate-scale-up" catchtap="noBubble">
      <view class="flex justify-between align-center" style="margin-bottom: 20rpx;">
        <text style="font-size: 30rpx; font-weight: 900; color: #0F172A;">📖 自律搭子全图鉴</text>
        <text class="p-close-btn" catchtap="onCloseDexModal">✕</text>
      </view>
      <!-- 顶部种类切换 Tab -->
      <view class="dex-species-tabs flex justify-between">
        <view wx:for="{{types}}" wx:key="type"
              class="dex-tab-item {{selectedDexType === item.type ? 'active' : ''}}"
              catchtap="onSelectDexTab" data-type="{{item.type}}">
          <text>{{item.icon}} {{item.name}}</text>
        </view>
      </view>
      <!-- 3 阶段形态展示 -->
      <view class="dex-stages-scroll">
        <view wx:for="{{selectedDexInfo.stages}}" wx:key="rank" class="dex-stage-card flex align-center">
          <image class="dex-stage-img" src="{{item.image}}" mode="aspectFit"></image>
          <view class="dex-stage-info flex flex-direction">
            <view class="flex align-center justify-between">
              <text class="st-name">{{item.name}}</text>
              <text class="st-req">{{item.reqText}}</text>
            </view>
            <text class="st-quote">“{{item.quote}}”</text>
            <text class="st-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 🏆 自律勋章墙弹窗 -->
  <view class="modal-mask flex align-center justify-center" wx:if="{{showBadgeModal}}" catchtap="onCloseBadgeModal">
    <view class="badge-wall-modal animate-scale-up" catchtap="noBubble">
      <view class="flex justify-between align-center" style="margin-bottom: 20rpx;">
        <text style="font-size: 30rpx; font-weight: 900; color: #0F172A;">🏆 自律成就勋章墙</text>
        <text class="p-close-btn" catchtap="onCloseBadgeModal">✕</text>
      </view>
      <view class="badge-grid-box flex flex-wrap justify-between">
        <view wx:for="{{badgeList}}" wx:key="id"
              class="badge-cell-item {{selectedBadge.id === item.id ? 'active' : ''}} {{item.unlocked ? 'unlocked' : 'locked'}}"
              catchtap="onTapBadgeItem" data-item="{{item}}">
          <text class="badge-cell-icon">{{item.icon}}</text>
          <text class="badge-cell-name">{{item.name}}</text>
        </view>
      </view>
      <!-- 选中的勋章详情 -->
      <view class="badge-detail-card" wx:if="{{selectedBadge}}">
        <view class="flex align-center justify-between" style="margin-bottom: 8rpx;">
          <text class="b-det-name">{{selectedBadge.name}}</text>
          <text class="b-det-status {{selectedBadge.unlocked ? 'is-unlocked' : 'is-locked'}}">{{selectedBadge.unlocked ? '✨ 已点亮' : '🔒 未解锁'}}</text>
        </view>
        <text class="b-det-req">解锁条件：{{selectedBadge.req}}</text>
        <text class="b-det-desc">{{selectedBadge.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 🌟 成长进化庆典弹窗 -->
  <view class="modal-mask flex align-center justify-center" wx:if="{{showEvolutionModal}}" catchtap="onCloseEvolutionModal">
    <view class="evolution-celebrate-modal animate-scale-up text-center" catchtap="noBubble">
      <view class="evo-sparkle-bg"></view>
      <text class="evo-main-title">🎉 恭喜达成成长蜕变！</text>
      <text class="evo-sub-title">自律的力量让搭子迎来了崭新形态 ✨</text>
      <view class="evo-image-wrap flex justify-center align-center">
        <image class="evo-hero-img animate-float" src="{{activePetImage}}" mode="aspectFit"></image>
      </view>
      <text class="evo-stage-title">{{currentStageInfo.name}}</text>
      <text class="evo-quote-text">“{{currentStageInfo.quote}}”</text>
      <button class="btn-evo-confirm" catchtap="onCloseEvolutionModal">继续美好自律 💖</button>
    </view>
  </view>

</view>