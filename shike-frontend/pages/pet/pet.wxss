/* pages/pet/pet.wxss — 《Pocket Love》风格 2.5D 微缩自律生活系统完整样式 */

page {
  background-color: #FDFBF7;
  min-height: 100vh;
  box-sizing: border-box;
}

.pet-page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: 160rpx;
  background: #FDFBF7;
}

/* ================= 1. 顶部沉浸式导航栏 ================= */
.custom-nav-bar {
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-title-text {
  font-size: 32rpx;
  font-weight: 900;
  color: #0F172A;
}

.nav-sub-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #EC4899;
  background: #FDF2F8;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.nav-badge-pill, .nav-dex-pill {
  background: #F8FAFC;
  border: 1.5rpx solid #E2E8F0;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #475569;
}

.nav-badge-pill:active, .nav-dex-pill:active {
  transform: scale(0.95);
}

/* Loading 状态 */
.loading-state-box {
  padding: 120rpx 0;
}
.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 5rpx solid #F1F5F9;
  border-top-color: #EC4899;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 24rpx; color: #94A3B8; }

/* ================= 2. 破壳领养仪式界面 ================= */
.adoption-card-wrapper {
  padding: 32rpx;
}

.adopt-hero-header {
  margin-bottom: 28rpx;
}
.hero-sparkle-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #0F172A;
  margin-bottom: 8rpx;
}
.hero-sub-desc {
  font-size: 22rpx;
  color: #64748B;
}

.egg-species-selector {
  margin-bottom: 24rpx;
  gap: 12rpx;
}
.species-tab-item {
  flex: 1;
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 24rpx;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.species-tab-item.active {
  border-color: #EC4899;
  background: #FFF1F2;
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 20rpx rgba(236, 72, 153, 0.15);
}
.tab-emoji { font-size: 36rpx; margin-bottom: 6rpx; }
.tab-name { font-size: 20rpx; font-weight: 800; color: #334155; }
.species-tab-item.active .tab-name { color: #BE185D; }

.adopt-pet-preview-stage {
  position: relative;
  width: 100%;
  height: 380rpx;
  background: radial-gradient(circle at center, #FFF1F2 0%, #FFFFFF 70%);
  border-radius: 32rpx;
  border: 2rpx solid #FCE7F3;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.preview-halo-ring {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(244, 114, 182, 0.2) 0%, transparent 70%);
  border-radius: 50%;
}
.preview-pet-sprite {
  width: 200rpx;
  height: 200rpx;
  z-index: 5;
}
.preview-shadow {
  width: 140rpx;
  height: 20rpx;
  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  margin-top: -10rpx;
}
.preview-tag-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #F43F5E;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.adopt-pet-intro-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1.5rpx solid #F1F5F9;
  margin-bottom: 24rpx;
}
.intro-species-name { font-size: 28rpx; font-weight: 900; color: #0F172A; }
.intro-fav-food { font-size: 22rpx; font-weight: 800; color: #E11D48; }
.intro-quote-text { font-size: 24rpx; color: #64748B; font-style: italic; display: block; }

.naming-input-box {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1.5rpx solid #F1F5F9;
  margin-bottom: 32rpx;
}
.naming-label { font-size: 24rpx; font-weight: 800; color: #334155; margin-bottom: 14rpx; }
.naming-hint { font-size: 20rpx; color: #94A3B8; }
.pet-name-input {
  background: #F8FAFC;
  border: 1.5rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #0F172A;
  margin-bottom: 16rpx;
}
.cand-label { font-size: 20rpx; color: #64748B; margin-right: 8rpx; }
.cand-tag {
  background: #F1F5F9;
  font-size: 20rpx;
  font-weight: 700;
  color: #475569;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}
.cand-tag:active { background: #FCE7F3; color: #BE185D; }

.btn-3d-adopt {
  background: linear-gradient(135deg, #F43F5E 0%, #EC4899 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  border-radius: 40rpx;
  box-shadow: 0 10rpx 24rpx rgba(236, 72, 153, 0.35);
  border: none;
  padding: 20rpx 0;
}

/* ================= 3. 已领养状态：《Pocket Love》2.5D 微缩自律小屋 ================= */
.living-stage-wrapper {
  display: flex;
  flex-direction: column;
}

/* 顶部轻量浮动 HUD */
.floating-hud-bar {
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}
.hud-pet-name { font-size: 28rpx; font-weight: 900; color: #0F172A; }
.hud-species-tag { font-size: 20rpx; color: #64748B; }
.hud-level-tag {
  background: linear-gradient(135deg, #EC4899, #F43F5E);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 900;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}
.stage-rank-tag {
  font-size: 20rpx;
  font-weight: 800;
  color: #047857;
  background: #ECFDF5;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #A7F3D0;
}

/* 🌟 2.5D 等轴测微缩自律小屋舞台 */
.virtual-3d-world {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: #FDFBF7;
  overflow: hidden;
  border-radius: 0 0 24rpx 24rpx;
}

.world-scene-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  pointer-events: none;
}

/* 昼夜氛围滤镜 */
.lighting-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  transition: background 0.6s ease;
  z-index: 4;
}
.lighting-overlay.lighting-DAY { background: rgba(255, 255, 255, 0.02); }
.lighting-overlay.lighting-SUNSET {
  background: linear-gradient(135deg, rgba(251, 146, 60, 0.22) 0%, rgba(244, 114, 182, 0.22) 100%);
  mix-blend-mode: multiply;
}
.lighting-overlay.lighting-NIGHT {
  background: linear-gradient(135deg, rgba(15, 23, 42, 0.38) 0%, rgba(30, 41, 59, 0.45) 100%);
}

.world-sun-ray {
  position: absolute;
  top: -80rpx;
  left: 20%;
  width: 400rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.6) 0%, transparent 70%);
  transform: rotate(25deg);
  pointer-events: none;
  z-index: 3;
}

.world-sparkle {
  position: absolute;
  font-size: 26rpx;
  pointer-events: none;
  z-index: 3;
  animation: sparkleFloat 4s ease-in-out infinite alternate;
}
.sp1 { top: 16%; left: 14%; }
.sp2 { top: 32%; right: 16%; animation-delay: 1.5s; }
.sp3 { bottom: 24%; left: 20%; animation-delay: 2.5s; }
@keyframes sparkleFloat {
  0% { transform: translateY(0) scale(0.8); opacity: 0.3; }
  100% { transform: translateY(-24rpx) scale(1.2); opacity: 0.9; }
}

/* ================= 4. 《Pocket Love》主角活体萌宠容器与多关节动画 ================= */
.pet-25d-dynamic-anchor {
  position: absolute;
  z-index: 12;
  transition: bottom 0.6s cubic-bezier(0.34, 1.3, 0.64, 1), left 0.6s cubic-bezier(0.34, 1.3, 0.64, 1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.pet-facing-right { transform: translateX(-50%) scaleX(1); }
.pet-facing-left { transform: translateX(-50%) scaleX(-1); }

/* Pocket Love 风格头顶生活状态胶囊 */
.pocket-emote-pill {
  position: absolute;
  top: -42rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  border: 2rpx solid #FBCFE8;
  border-radius: 30rpx;
  padding: 4rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(244, 114, 182, 0.25);
  z-index: 25;
  white-space: nowrap;
  pointer-events: none;
}
.pocket-emote-pill .emote-text {
  font-size: 20rpx;
  font-weight: 900;
  color: #BE185D;
}
.pill-float-gentle { animation: emotePillFloat 2.6s ease-in-out infinite; }
@keyframes emotePillFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}
.pill-bounce-joy { animation: emotePillBounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes emotePillBounce {
  0% { transform: scale(1); }
  50% { transform: scale(1.18) translateY(-10rpx); }
  100% { transform: scale(1); }
}

/* 起跳扬尘卡通微粒 */
.dust-puff-anim {
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 20rpx;
  background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.9) 0%, rgba(240, 230, 210, 0.4) 60%, transparent 100%);
  border-radius: 50%;
  animation: dustPuff 0.4s ease-out forwards;
}
@keyframes dustPuff {
  0% { transform: scale(0.3); opacity: 1; }
  100% { transform: scale(1.6); opacity: 0; }
}

/* 抛物线卡通起跳漫步 */
.pet-hopping-move {
  animation: petParabolicHop 0.6s cubic-bezier(0.25, 1, 0.5, 1);
}
@keyframes petParabolicHop {
  0% { transform: translateY(0) scaleY(0.85); }
  25% { transform: translateY(-65rpx) scaleY(1.2); }
  65% { transform: translateY(-15rpx) scaleY(0.9); }
  100% { transform: translateY(0) scaleY(1); }
}

/* 角色骨骼容器 */
.pet-mesh-container {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: transform 0.3s ease;
}
.pet-cutout-img {
  width: 200rpx;
  height: 200rpx;
}

/* 兔子摇耳次级物理摆动 */
.bunny-ear-twitch-layer {
  position: absolute;
  top: 10rpx;
  width: 100rpx;
  height: 50rpx;
  pointer-events: none;
}
.ears-sway-loop { animation: earSway 3.2s ease-in-out infinite; }
@keyframes earSway {
  0%, 100% { transform: rotate(0deg); }
  30% { transform: rotate(-4deg); }
  70% { transform: rotate(4deg); }
}
.ears-excited { animation: earExcited 0.4s ease-in-out infinite alternate; }
@keyframes earExcited {
  0% { transform: scale(1.1) rotate(-8deg); }
  100% { transform: scale(1.1) rotate(8deg); }
}

/* 眨眼蒙皮与深睡闭眼 */
.pet-25d-eyelid-overlay {
  position: absolute;
  top: 38%;
  left: 32%;
  width: 72rpx;
  height: 24rpx;
  display: flex;
  justify-content: space-between;
  pointer-events: none;
  z-index: 12;
}
.eyelid-mask {
  width: 20rpx;
  height: 18rpx;
  background: transparent;
  border-radius: 50%;
  transition: all 0.15s ease;
}
.eyes-blink-loop .eyelid-mask {
  animation: eyeBlink 3.8s ease-in-out infinite;
}
@keyframes eyeBlink {
  0%, 94%, 100% { transform: scaleY(0); }
  96%, 98% { transform: scaleY(1); background: #334155; }
}
.eyes-sleeping-closed .eyelid-mask {
  height: 100% !important;
  opacity: 1 !important;
  background: #334155 !important;
  border-radius: 50% !important;
  transform: scaleY(0.25) !important;
}

/* 脸颊粉晕微呼吸 */
.pet-25d-blush-aura {
  position: absolute;
  top: 50%;
  left: 28%;
  width: 88rpx;
  height: 20rpx;
  background: radial-gradient(ellipse at center, rgba(251, 113, 133, 0.4) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  animation: blushPulse 3s ease-in-out infinite;
}
@keyframes blushPulse {
  0%, 100% { opacity: 0.5; transform: scale(0.95); }
  50% { opacity: 0.9; transform: scale(1.08); }
}

/* 地面接触阴影 */
.pet-floor-shadow {
  position: absolute;
  bottom: -16rpx;
  width: 140rpx;
  height: 22rpx;
  background: radial-gradient(ellipse at center, rgba(15, 23, 42, 0.22) 0%, transparent 75%);
  border-radius: 50%;
  z-index: 5;
  transition: transform 0.2s, opacity 0.2s;
}
.shadow-25d-breath { animation: shadowBreath 2.4s ease-in-out infinite; }
@keyframes shadowBreath {
  0%, 100% { transform: scale(1); opacity: 0.22; }
  50% { transform: scale(1.06); opacity: 0.28; }
}
.shadow-hop-shrink { transform: scale(0.35) !important; opacity: 0.08 !important; }

/* 🌟 6 大自律打卡专属生活动作状态机 */
/* 1. 🏃 露台跳绳燃脂 */
.state-EXERCISING { animation: bunnyJumpRope 0.75s ease-in-out infinite; }
@keyframes bunnyJumpRope {
  0%, 100% { transform: translateY(0) scale(1, 0.96); }
  40% { transform: translateY(-26rpx) scale(0.95, 1.08); }
  80% { transform: translateY(0) scale(1.05, 0.92); }
}

/* 2. 🥗 客厅沙发享用轻食 */
.state-EATING_MEAL { animation: bunnyMunchSalad 1.8s ease-in-out infinite; }
@keyframes bunnyMunchSalad {
  0%, 100% { transform: translateY(0) scale(1, 1); }
  25% { transform: translateY(-4rpx) scale(1.03, 0.97) rotate(-1deg); }
  50% { transform: translateY(0) scale(0.98, 1.02); }
  75% { transform: translateY(-4rpx) scale(1.02, 0.98) rotate(1deg); }
}

/* 3. 💧 水吧健康补水 */
.state-DRINKING_WATER { animation: bunnyDrinkWater 2s ease-in-out infinite; }
@keyframes bunnyDrinkWater {
  0%, 100% { transform: translateY(0) scale(1, 1); }
  35% { transform: translateY(-6rpx) scale(1.04, 0.96) rotate(-2deg); }
  70% { transform: translateY(-2rpx) scale(0.98, 1.02) rotate(1deg); }
}

/* 4. 🌙 雕花暖床深度安睡 */
.state-DEEP_SLEEP { animation: bunnyDeepSleep 3.6s ease-in-out infinite; }
@keyframes bunnyDeepSleep {
  0%, 100% { transform: translateY(2rpx) scale(1.03, 0.94); }
  50% { transform: translateY(-4rpx) scale(0.97, 1.04); }
}

/* 5. ✍️ 书桌整理自律手账 */
.state-STUDYING { animation: bunnyStudying 2.2s ease-in-out infinite; }
@keyframes bunnyStudying {
  0%, 100% { transform: translateY(0) scale(0.97, 1.02); }
  30% { transform: translateY(-6rpx) scale(1.02, 0.98) rotate(-1deg); }
  70% { transform: translateY(-2rpx) scale(0.99, 1.01) rotate(1deg); }
}

/* 6. 🪞 梳妆穿衣镜身材管理 */
.state-CHECKING_MIRROR { animation: bunnyMirrorCheck 2.8s ease-in-out infinite; }
@keyframes bunnyMirrorCheck {
  0%, 100% { transform: translateY(0) scale(1, 1); }
  30% { transform: translateY(-8rpx) scale(0.96, 1.06) rotate(-2deg); }
  60% { transform: translateY(-4rpx) scale(1.02, 0.98) rotate(2deg); }
}

/* 7. 触碰开心高跳 */
.animate-bunny-joy { animation: bunnyJoyBounce 0.85s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes bunnyJoyBounce {
  0% { transform: translateY(0) scale(1, 1); }
  25% { transform: translateY(-50rpx) scale(0.92, 1.15) rotate(-3deg); }
  55% { transform: translateY(0) scale(1.12, 0.85) rotate(3deg); }
  75% { transform: translateY(-20rpx) scale(0.96, 1.06); }
  100% { transform: translateY(0) scale(1, 1); }
}

/* 🌟 动态生活道具 */
.spot-prop-item {
  position: absolute;
  z-index: 15;
  pointer-events: none;
}
.prop-emoji { font-size: 34rpx; }
.prop-emoji-zz { font-size: 26rpx; font-weight: 900; color: #6366F1; animation: floatZz 2s infinite; }
@keyframes floatZz {
  0% { transform: translate(0, 0) scale(0.6); opacity: 0; }
  50% { transform: translate(10rpx, -16rpx) scale(1.1); opacity: 1; }
  100% { transform: translate(20rpx, -32rpx) scale(0.8); opacity: 0; }
}

.prop-rope-jump {
  bottom: -6rpx;
  right: -16rpx;
  animation: ropeArcSpin 0.75s ease-in-out infinite;
}
.jump-rope-arc {
  width: 90rpx;
  height: 60rpx;
  border-bottom: 4rpx dashed #F43F5E;
  border-radius: 50%;
  position: absolute;
  bottom: 0;
  left: -20rpx;
}
@keyframes ropeArcSpin {
  0%, 100% { transform: scaleY(0.4) translateY(0); }
  50% { transform: scaleY(1.2) translateY(-14rpx); }
}

.prop-salad-bowl {
  top: 30%;
  right: -16rpx;
  animation: saladMunchFloat 1.8s ease-in-out infinite;
}
@keyframes saladMunchFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-6rpx) scale(1.08); }
}

.prop-water-cup {
  top: 25%;
  right: -14rpx;
  animation: waterCupGlow 2s ease-in-out infinite;
}
@keyframes waterCupGlow {
  0%, 100% { transform: scale(1); filter: drop-shadow(0 0 4rpx #38BDF8); }
  50% { transform: scale(1.12) translateY(-4rpx); filter: drop-shadow(0 0 10rpx #38BDF8); }
}

.prop-sleep-zz { top: -14rpx; right: -10rpx; }

.prop-desk-study {
  top: 20%;
  right: -18rpx;
  animation: deskPencilWrite 1.5s ease-in-out infinite alternate;
}
@keyframes deskPencilWrite {
  0% { transform: rotate(-5deg) translateY(0); }
  100% { transform: rotate(10deg) translateY(-4rpx); }
}

.prop-mirror-shine {
  top: 15%;
  left: -16rpx;
  animation: mirrorSparkle 2s ease-in-out infinite alternate;
}
@keyframes mirrorSparkle {
  0% { transform: scale(0.9) rotate(-4deg); }
  100% { transform: scale(1.15) rotate(4deg); filter: drop-shadow(0 0 8rpx #F472B6); }
}

/* 迸发爱心与飞行动画 */
.heart-burst-particle {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 36rpx;
  z-index: 20;
  pointer-events: none;
  animation: heartFly 0.8s ease-out forwards;
}
@keyframes heartFly {
  0% { transform: translate(-50%, 0) scale(0.5); opacity: 1; }
  100% { transform: translate(-50%, -60rpx) scale(1.3); opacity: 0; }
}

.flying-food-projectile {
  position: absolute;
  bottom: 0;
  left: 50%;
  font-size: 32rpx;
  z-index: 20;
  pointer-events: none;
  animation: foodParabola 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}
@keyframes foodParabola {
  0% { transform: translate(-100rpx, 60rpx) scale(0.5); opacity: 1; }
  50% { transform: translate(-50rpx, -80rpx) scale(1.2); }
  100% { transform: translate(0, 0) scale(0.8); opacity: 0; }
}

.floating-exp-gain {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 22;
  pointer-events: none;
  animation: expFloat 1s ease-out forwards;
}
.exp-text {
  font-size: 24rpx;
  font-weight: 900;
  color: #10B981;
  background: rgba(255, 255, 255, 0.95);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.2);
}
@keyframes expFloat {
  0% { transform: translate(-50%, 0) scale(0.8); opacity: 0; }
  30% { transform: translate(-50%, -20rpx) scale(1.1); opacity: 1; }
  100% { transform: translate(-50%, -50rpx) scale(0.9); opacity: 0; }
}

/* ================= 5. 悬浮台词气泡、工具栏与黑胶唱机 ================= */
.speech-bubble-3d {
  position: absolute;
  top: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  border: 2rpx solid #FBCFE8;
  border-radius: 24rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(244, 114, 182, 0.2);
  z-index: 20;
  max-width: 80%;
  text-align: center;
}
.bubble-msg { font-size: 22rpx; font-weight: 800; color: #831843; }
.bubble-arrow {
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid rgba(255, 255, 255, 0.95);
}

.cozy-tools-dock {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 25;
  gap: 12rpx;
}
.tool-btn-pill {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(6px);
  border: 1.5rpx solid rgba(226, 232, 240, 0.8);
  border-radius: 30rpx;
  padding: 6rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.tool-icon { font-size: 24rpx; }
.tool-label { font-size: 20rpx; font-weight: 800; color: #475569; }

.cozy-vinyl-dock {
  position: absolute;
  bottom: 110rpx;
  right: 24rpx;
  z-index: 25;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(6px);
  border: 1.5rpx solid rgba(226, 232, 240, 0.8);
  border-radius: 30rpx;
  padding: 6rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.vinyl-disc-wrap {
  width: 44rpx;
  height: 44rpx;
  background: #0F172A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #334155;
}
.animate-vinyl-spin { animation: spin 4s linear infinite; }
.vinyl-center-label { font-size: 20rpx; }
.vinyl-track-name { font-size: 20rpx; font-weight: 800; color: #0F172A; }
.vinyl-note-badge { font-size: 20rpx; color: #EC4899; }
.floating-music-notes {
  position: absolute;
  top: -20rpx;
  right: 10rpx;
  pointer-events: none;
}
.m-note {
  position: absolute;
  font-size: 22rpx;
  color: #EC4899;
  font-weight: 900;
  animation: noteFloat 2s ease-in-out infinite;
}
.n1 { animation-delay: 0s; }
.n2 { animation-delay: 1s; left: 16rpx; }
@keyframes noteFloat {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  50% { transform: translateY(-16rpx) scale(1.1); opacity: 1; }
  100% { transform: translateY(-32rpx) scale(0.8); opacity: 0; }
}

/* 🛋️ 家具点位导览条 */
.room-spot-dock-bar {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border: 1.5rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 36rpx;
  padding: 8rpx 16rpx;
  gap: 12rpx;
  z-index: 25;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}
.spot-dock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}
.spot-dock-item.active {
  background: #ECFDF5;
  transform: scale(1.05);
}
.spot-dock-item .dock-icon { font-size: 26rpx; }
.spot-dock-item .dock-name {
  font-size: 18rpx;
  font-weight: 800;
  color: #64748B;
  white-space: nowrap;
}
.spot-dock-item.active .dock-name { color: #047857; }

.mood-bar-row {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 25;
}
.mood-pill {
  background: rgba(255, 255, 255, 0.9);
  border: 1.5rpx solid #E2E8F0;
  border-radius: 24rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #334155;
}
.hud-streak-tag {
  background: #FFF7ED;
  border: 1.5rpx solid #FFEDD5;
  border-radius: 24rpx;
  padding: 4rpx 14rpx;
}

.touch-hint-label {
  position: absolute;
  bottom: 96rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(100, 116, 139, 0.85);
  background: rgba(255, 255, 255, 0.7);
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  pointer-events: none;
  z-index: 20;
}

/* ================= 6. 自律心声与闺蜜互动 ================= */
.treehole-chat-deck {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  margin: 24rpx 32rpx 0 32rpx;
  border: 1.5rpx solid #F1F5F9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}
.interactive-chips-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}
.chip-action-btn {
  background: #F8FAFC;
  border: 1.5rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.chip-action-btn:active {
  background: #FFF1F2;
  border-color: #FBCFE8;
  transform: scale(0.98);
}
.chip-emoji { font-size: 28rpx; }
.chip-title { font-size: 22rpx; font-weight: 800; color: #334155; }

/* ================= 7. 仪表盘与每日自律打卡任务 ================= */
.gamified-stats-deck {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  margin: 24rpx 32rpx 0 32rpx;
  border: 1.5rpx solid #F1F5F9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}
.stat-gauge-cell .gauge-name { font-size: 24rpx; font-weight: 800; color: #334155; }
.stat-gauge-cell .gauge-number { font-size: 24rpx; font-weight: 900; }
.gauge-track {
  width: 100%;
  height: 16rpx;
  background: #F1F5F9;
  border-radius: 16rpx;
  overflow: hidden;
}
.gauge-fill {
  height: 100%;
  border-radius: 16rpx;
  transition: width 0.4s ease;
}

.stat-pills-row .pill-box {
  flex: 1;
  background: #F8FAFC;
  border: 1.5rpx solid #E2E8F0;
  border-radius: 24rpx;
  padding: 16rpx;
  margin: 0 6rpx;
}
.pill-box .p-val { font-size: 28rpx; font-weight: 900; color: #0F172A; }
.pill-box .p-lbl { font-size: 20rpx; color: #64748B; font-weight: 700; }

.daily-food-quests-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  margin: 24rpx 32rpx 0 32rpx;
  border: 1.5rpx solid #F1F5F9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}
.quest-count-badge {
  background: #ECFDF5;
  color: #047857;
  font-size: 22rpx;
  font-weight: 800;
  padding: 4rpx 16rpx;
