}
.quest-list-wrapper { display: flex; flex-direction: column; gap: 16rpx; }
.quest-item-row {
  background: #F8FAFC;
  border: 1.5rpx solid #E2E8F0;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
}
.quest-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.bg-checkin { background: #ECFDF5; }
.bg-exercise { background: #FFF1F2; }
.bg-diet { background: #FFF7ED; }
.bg-water { background: #F0F9FF; }
.bg-weight { background: #FAF5FF; }
.quest-title { font-size: 24rpx; font-weight: 800; color: #0F172A; }
.quest-reward { font-size: 20rpx; color: #64748B; font-weight: 700; }

.btn-quest-go {
  background: linear-gradient(135deg, #10B981, #059669);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  border-radius: 30rpx;
  padding: 8rpx 24rpx;
