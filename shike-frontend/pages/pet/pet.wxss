/* pages/pet/pet.wxss */
page {
  background: linear-gradient(180deg, #F0FDF4 0%, #F8FAFC 35%, #F1F5F9 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

.pet-immersive-page {
  padding: 20rpx 28rpx 60rpx 28rpx;
}

/* 顶部导航 */
.top-nav-bar {
  margin-bottom: 20rpx;
}

.brand-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #0F172A;
  letter-spacing: 0.5rpx;
}

.brand-sub {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 2rpx;
}

.refresh-pill {
  background: rgba(16, 185, 129, 0.12);
  border: 1.5rpx solid rgba(16, 185, 129, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(16, 185, 129, 0.08);
}

/* 加载动画 */
.loading-container {
  padding: 160rpx 0;
}

.magic-spinner {
  width: 70rpx;
  height: 70rpx;
  border: 6rpx solid #E2E8F0;
  border-top-color: #10B981;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #64748B;
  margin-top: 24rpx;
  font-weight: 600;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ================= 状态 A: 领养向导 ================= */
.adopt-showcase-flow {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.adopt-banner-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(240, 253, 244, 0.9));
  border: 2rpx solid rgba(16, 185, 129, 0.25);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 10rpx 25rpx rgba(16, 185, 129, 0.06);
}

.banner-desc {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
}

.adopt-3d-stage-box {
  background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
  border: 2rpx solid #E2E8F0;
  border-radius: 36rpx;
  padding: 30rpx 20rpx 28rpx 20rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.04);
}

.stage-3d-viewport {
  position: relative;
  width: 440rpx;
  height: 440rpx;
}

.ambient-sunbeam {
  position: absolute;
  top: -40rpx;
  left: -40rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(254, 240, 138, 0.35) 0%, rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
}

.pet-model-anchor {
  position: relative;
  width: 360rpx;
  height: 360rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-model-img {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 14rpx 24rpx rgba(15, 23, 42, 0.15));
}

.island-pedestal {
  position: absolute;
  bottom: 24rpx;
  width: 340rpx;
  height: 80rpx;
  background: linear-gradient(180deg, #D1FAE5 0%, #A7F3D0 60%, #6EE7B7 100%);
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  transform: perspective(400px) rotateX(45deg);
  box-shadow: 0 16rpx 28rpx rgba(16, 185, 129, 0.25);
  z-index: 1;
}

.type-capsule {
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  margin-top: 14rpx;
}

.type-motto {
  font-size: 24rpx;
  color: #64748B;
  font-style: italic;
  margin-top: 12rpx;
  text-align: center;
  padding: 0 20rpx;
}

.type-switch-panel, .name-edit-panel {
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 28rpx;
  padding: 24rpx;
}

.panel-label {
  font-size: 26rpx;
  font-weight: 800;
  color: #1E293B;
  margin-bottom: 16rpx;
  display: block;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.type-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 10rpx;
  background: #F1F5F9;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.type-item.active {
  background: #ECFDF5;
  border-color: #10B981;
  color: #047857;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.2);
}

.type-icon { font-size: 28rpx; }
.type-text { font-size: 24rpx; }

.input-row {
  background: #F8FAFC;
  border: 2rpx solid #CBD5E1;
  border-radius: 20rpx;
  padding: 10rpx 18rpx;
}

.name-ipt {
  flex: 1;
  font-size: 28rpx;
  color: #0F172A;
  font-weight: 700;
}

.dice-btn {
  font-size: 22rpx;
  color: #6366F1;
  font-weight: 800;
  padding: 6rpx 14rpx;
  background: #EEF2FF;
  border-radius: 12rpx;
}

.candidate-row {
  margin-top: 14rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag-name {
  font-size: 22rpx;
  color: #475569;
  background: #F1F5F9;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.btn-3d-adopt {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 900;
  padding: 22rpx 0;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 28rpx rgba(16, 185, 129, 0.4);
  border: none;
}

/* ================= 状态 B: 3D 沉浸式互动舞台 ================= */
.living-stage-wrapper {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

/* 顶部轻量 HUD */
.floating-hud-bar {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(16px);
  border: 2rpx solid rgba(226, 232, 240, 0.8);
  border-radius: 28rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.hud-pet-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #0F172A;
}

.hud-level-tag {
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.hud-streak-tag {
  background: #FFF7ED;
  border: 1.5rpx solid #FFEDD5;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
}

/* 3D 虚拟乐园展台 */
.virtual-3d-world {
  position: relative;
  background: radial-gradient(circle at 50% 30%, #FFFFFF 0%, #F0FDF4 55%, #E2E8F0 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 40rpx;
  padding: 30rpx 24rpx 24rpx 24rpx;
  box-shadow: 0 20rpx 50rpx rgba(16, 185, 129, 0.12), inset 0 2rpx 6rpx rgba(255, 255, 255, 0.8);
  overflow: hidden;
}

.world-sun-ray {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(253, 224, 71, 0.28) 0%, rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
}

.world-sparkle {
  position: absolute;
  font-size: 28rpx;
  pointer-events: none;
  animation: floatSparkle 4s ease-in-out infinite;
}

.sp1 { top: 60rpx; left: 60rpx; animation-delay: 0s; }
.sp2 { top: 120rpx; right: 80rpx; animation-delay: 1.2s; }
.sp3 { top: 220rpx; left: 90rpx; animation-delay: 2.4s; }

@keyframes floatSparkle {
  0%, 100% { transform: translateY(0) scale(0.8); opacity: 0.4; }
  50% { transform: translateY(-16rpx) scale(1.1); opacity: 0.9; }
}

/* 3D 悬浮气泡 */
.speech-bubble-3d {
  position: relative;
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 28rpx;
  padding: 16rpx 28rpx;
  margin: 0 auto 16rpx auto;
  max-width: 82%;
  text-align: center;
  box-shadow: 0 10rpx 25rpx rgba(15, 23, 42, 0.06);
  z-index: 10;
}

.bubble-msg {
  font-size: 26rpx;
  color: #1E293B;
  font-weight: 700;
}

.bubble-arrow {
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 14rpx solid #FFFFFF;
}

/* 3D 角色舞台 */
.pet-3d-character-stage {
  position: relative;
  width: 480rpx;
  height: 480rpx;
  margin: 0 auto;
}

.pet-mesh-container {
  position: relative;
  width: 380rpx;
  height: 380rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  transform-origin: 50% 90%;
}

.pet-cutout-img {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 16rpx 28rpx rgba(15, 23, 42, 0.18));
}

/* 触地柔光阴影 */
.pet-floor-shadow {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 260rpx;
  height: 40rpx;
  background: radial-gradient(ellipse, rgba(15, 23, 42, 0.35) 0%, rgba(15, 23, 42, 0) 72%);
  border-radius: 50%;
  z-index: -1;
  transition: all 0.3s ease;
}

/* 3D 浮岛基盘 */
.stage-3d-island-disc {
  position: absolute;
  bottom: 20rpx;
  width: 400rpx;
  height: 100rpx;
  z-index: 2;
  pointer-events: none;
}

.disc-top-ring {
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #D1FAE5 0%, #A7F3D0 70%, #6EE7B7 100%);
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  transform: perspective(400px) rotateX(46deg);
  box-shadow: 0 16rpx 32rpx rgba(16, 185, 129, 0.3);
}

/* 抛物线飞行动画 */
.flying-food-projectile {
  position: absolute;
  bottom: 40rpx;
  right: 60rpx;
  z-index: 20;
}

.food-emoji {
  font-size: 50rpx;
}

.animate-food-parabola {
  animation: foodParabolaFly 0.65s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

@keyframes foodParabolaFly {
  0% {
    transform: translate(0, 0) scale(0.6) rotate(0deg);
    opacity: 1;
  }
  50% {
    transform: translate(-100rpx, -180rpx) scale(1.2) rotate(-180deg);
    opacity: 1;
  }
  100% {
    transform: translate(-180rpx, -120rpx) scale(0.2) rotate(-360deg);
    opacity: 0;
  }
}

/* 爱心迸发动画 */
.heart-burst-particle {
  position: absolute;
  top: 140rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
}

.burst-text { font-size: 56rpx; }

.animate-heart-fly {
  animation: heartPopFly 0.8s ease-out forwards;
}

@keyframes heartPopFly {
  0% { transform: translate(-50%, 0) scale(0.5); opacity: 0; }
  40% { transform: translate(-50%, -60rpx) scale(1.4); opacity: 1; }
  100% { transform: translate(-50%, -140rpx) scale(1); opacity: 0; }
}

/* EXP 飘字 */
.floating-exp-gain {
  position: absolute;
  top: 120rpx;
  right: 80rpx;
  z-index: 25;
}

.exp-text {
  font-size: 32rpx;
  font-weight: 900;
  color: #F59E0B;
  text-shadow: 0 4rpx 10rpx rgba(245, 158, 11, 0.4);
}

.animate-exp-up {
  animation: expFloatUp 0.9s ease-out forwards;
}

@keyframes expFloatUp {
  0% { transform: translateY(0) scale(0.8); opacity: 0; }
  30% { transform: translateY(-30rpx) scale(1.2); opacity: 1; }
  100% { transform: translateY(-90rpx) scale(1); opacity: 0; }
}

/* ================= 3D 活体宠物多维动效体系 ================= */

/* 1. 待机自然呼吸浮动 */
.animate-idle-breathe {
  animation: idle3DBreathe 3.6s ease-in-out infinite;
}

@keyframes idle3DBreathe {
  0% {
    transform: translateY(0rpx) scale(1, 1) rotate(0deg);
  }
  50% {
    transform: translateY(-16rpx) scale(1.025, 0.975) rotate(1.2deg);
  }
  100% {
    transform: translateY(0rpx) scale(1, 1) rotate(0deg);
  }
}

.shadow-breathe {
  animation: shadowBreatheAnim 3.6s ease-in-out infinite;
}

@keyframes shadowBreatheAnim {
  0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.35; }
  50% { transform: translateX(-50%) scale(0.82); opacity: 0.2; }
}

/* 2. 点击果冻 Q 弹反馈 */
.animate-pet-squish {
  animation: jellySquishPop 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes jellySquishPop {
  0% { transform: scale(1, 1); }
  25% { transform: scale(1.18, 0.82) rotate(-3deg); }
  50% { transform: scale(0.88, 1.12) rotate(3deg); }
  75% { transform: scale(1.05, 0.95) rotate(-1deg); }
  100% { transform: scale(1, 1) rotate(0deg); }
}

.shadow-squish {
  animation: shadowSquishAnim 0.55s ease;
}

@keyframes shadowSquishAnim {
  0%, 100% { transform: translateX(-50%) scale(1); }
  25% { transform: translateX(-50%) scale(1.25); }
  50% { transform: translateX(-50%) scale(0.8); }
}

/* 3. 投喂咀嚼跳跃 */
.animate-pet-chew {
  animation: petChewHappy 0.7s ease;
}

@keyframes petChewHappy {
  0% { transform: scale(1); }
  20% { transform: translateY(-24rpx) scale(1.12, 0.9) rotate(-4deg); }
  40% { transform: translateY(0) scale(0.92, 1.08) rotate(4deg); }
  60% { transform: translateY(-12rpx) scale(1.06, 0.95) rotate(-2deg); }
  80% { transform: translateY(0) scale(0.98, 1.02) rotate(1deg); }
  100% { transform: translateY(0) scale(1) rotate(0); }
}

.shadow-chew {
  animation: shadowChewAnim 0.7s ease;
}

@keyframes shadowChewAnim {
  0%, 40%, 80%, 100% { transform: translateX(-50%) scale(1); }
  20% { transform: translateX(-50%) scale(0.7); opacity: 0.15; }
  60% { transform: translateX(-50%) scale(0.85); opacity: 0.25; }
}

/* 心情胶囊 */
.mood-bar-row {
  margin-top: 10rpx;
}

.mood-pill {
  font-size: 24rpx;
  font-weight: 800;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.mood-icon { font-size: 28rpx; margin-right: 8rpx; }

.mood-HAPPY {
  background: #ECFDF5;
  color: #047857;
  border: 1.5rpx solid #A7F3D0;
}

.mood-HUNGRY {
  background: #FEF2F2;
  color: #B91C1C;
  border: 1.5rpx solid #FECACA;
}

.mood-WANT_EXERCISE {
  background: #FFFBEB;
  color: #B45309;
  border: 1.5rpx solid #FDE68A;
}

.mood-NORMAL {
  background: #F0FDF4;
  color: #15803D;
  border: 1.5rpx solid #BBF7D0;
}

.touch-hint-label {
  text-align: center;
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 14rpx;
}

/* ================= 游戏化数值仪表盘 ================= */
.gamified-stats-deck {
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.03);
}

.gauge-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #334155;
}

.gauge-number {
  font-size: 26rpx;
  font-weight: 900;
}

.gauge-track {
  width: 100%;
  height: 18rpx;
  background: #E2E8F0;
  border-radius: 12rpx;
  overflow: hidden;
}

.gauge-fill {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.5s cubic-bezier(0.25, 1, 0.5, 1);
}

.pill-box {
  background: #F8FAFC;
  border: 1.5rpx solid #E2E8F0;
  padding: 14rpx 20rpx;
  border-radius: 24rpx;
  flex: 1;
  margin: 0 8rpx;
}

/* ================= 3D 触感操作 Deck ================= */
.action-deck-card {
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.04);
}

.btn-3d-action {
  flex: 1;
  font-size: 30rpx;
  border-radius: 30rpx;
  padding: 20rpx 0;
  border: none;
  transition: all 0.15s ease;
}

.btn-3d-action:active {
  transform: translateY(4rpx) scale(0.98);
}

.btn-3d-feed {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(16, 185, 129, 0.35);
}

.btn-3d-feed[disabled] {
  background: #E2E8F0 !important;
  color: #94A3B8 !important;
  box-shadow: none !important;
}

.btn-3d-exercise {
  background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(99, 102, 241, 0.35);
}

.daily-reward-tip {
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}

.tip-content {
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.5;
}


/* ================= 下架与维护禁用状态 ================= */
.disabled-state-box {
  padding: 140rpx 40rpx;
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.04);
  text-align: center;
  margin-top: 40rpx;
}

.disabled-icon-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  background: #F1F5F9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.disabled-lock-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  font-size: 32rpx;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 4rpx;
}

.disabled-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #0F172A;
  margin-bottom: 14rpx;
}

.disabled-desc {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.6;
  max-width: 80%;
  margin-bottom: 40rpx;
}

.btn-back-home {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  padding: 18rpx 48rpx;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.3);
  border: none;
}
