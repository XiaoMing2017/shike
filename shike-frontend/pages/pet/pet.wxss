/* pages/pet/pet.wxss */
.pet-immersive-page {
  min-height: 100vh;
  background: #FDFBF7; /* 莫兰迪奶油温润底色 */
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* 顶部导航与状态栏 */
.top-nav-bar {
  padding: 24rpx 28rpx 18rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
  box-sizing: border-box;
}

.nav-brand-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.brand-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #0F172A;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

.brand-sub {
  font-size: 19rpx;
  color: #64748B;
  font-weight: 600;
  margin-top: 2rpx;
  white-space: nowrap;
}

.nav-actions-wrap {
  flex-shrink: 0;
}

.polaroid-nav-pill {
  background: #FFF1F2;
  border: 1.5rpx solid #FECDD3;
  padding: 6rpx 14rpx;
  border-radius: 30rpx;
  white-space: nowrap;
}

.pill-text-rose {
  font-size: 20rpx;
  font-weight: 800;
  color: #E11D48;
  white-space: nowrap;
}

.stage-dex-pill {
  background: #EEF2FF;
  border: 1.5rpx solid #C7D2FE;
  padding: 6rpx 14rpx;
  border-radius: 30rpx;
  white-space: nowrap;
}

.pill-text-indigo {
  font-size: 20rpx;
  font-weight: 800;
  color: #6366F1;
  white-space: nowrap;
}

.badge-nav-pill {
  background: #FEF3C7;
  border: 1.5rpx solid #FDE68A;
  padding: 6rpx 14rpx;
  border-radius: 30rpx;
  white-space: nowrap;
}

.pill-text-amber {
  font-size: 20rpx;
  font-weight: 800;
  color: #D97706;
  white-space: nowrap;
}

.refresh-pill {
  background: #ECFDF5;
  border: 1.5rpx solid #A7F3D0;
  padding: 6rpx 14rpx;
  border-radius: 30rpx;
  white-space: nowrap;
}

/* ================= 3D 核心互动舞台 ================= */
.virtual-3d-world {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: radial-gradient(circle at 50% 30%, #FFF1F2 0%, #F0FDF4 55%, #FDFBF7 100%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.world-sun-ray {
  position: absolute;
  top: -80rpx;
  left: 20%;
  width: 400rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0) 70%);
  transform: rotate(25deg);
  pointer-events: none;
}

.world-sparkle {
  position: absolute;
  font-size: 28rpx;
  pointer-events: none;
  animation: sparkleFloat 4s ease-in-out infinite alternate;
}
.sp1 { top: 18%; left: 15%; animation-delay: 0s; }
.sp2 { top: 35%; right: 18%; animation-delay: 1.5s; }
.sp3 { bottom: 25%; left: 22%; animation-delay: 2.5s; }

@keyframes sparkleFloat {
  0% { transform: translateY(0) scale(0.8); opacity: 0.3; }
  100% { transform: translateY(-30rpx) scale(1.2); opacity: 0.9; }
}

/* 3D 角色舞台与底座 */
.pet-3d-character-stage {
  position: relative;
  width: 420rpx;
  height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.pet-mesh-container {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: transform 0.3s ease;
}

.pet-cutout-img {
  width: 240rpx;
  height: 240rpx;
}

.pet-floor-shadow {
  position: absolute;
  bottom: -20rpx;
  width: 180rpx;
  height: 26rpx;
  background: radial-gradient(ellipse at center, rgba(15, 23, 42, 0.25) 0%, rgba(15, 23, 42, 0) 75%);
  border-radius: 50%;
  z-index: 5;
}

/* 3D 浮岛底座 */
.stage-3d-island-disc {
  position: absolute;
  bottom: 20rpx;
  width: 320rpx;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.disc-top-ring {
  width: 320rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #86EFAC 0%, #22C55E 100%);
  border-radius: 50%;
  box-shadow: 0 6rpx 20rpx rgba(34, 197, 94, 0.4);
  border: 4rpx solid #DCFCE7;
}

.disc-bottom-base {
  width: 280rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #15803D 0%, #166534 100%);
  border-radius: 0 0 50% 50% / 0 0 100% 100%;
  margin-top: -24rpx;
  box-shadow: 0 12rpx 24rpx rgba(22, 101, 52, 0.3);
}

/* 悬浮台词气泡 */
.speech-bubble-3d {
  position: absolute;
  top: 30rpx;
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 28rpx;
  padding: 14rpx 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
  z-index: 20;
  max-width: 580rpx;
  text-align: center;
}

.bubble-msg {
  font-size: 24rpx;
  font-weight: 700;
  color: #1E293B;
  line-height: 1.4;
}

.bubble-arrow {
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 14rpx solid #FFFFFF;
}

.bubble-thinking {
  background: #FFF1F2 !important;
  border-color: #FECDD3 !important;
}

/* 爱心喷发 */
.heart-burst-particle {
  position: absolute;
  top: 60rpx;
  z-index: 30;
  pointer-events: none;
}
.burst-text { font-size: 48rpx; }

/* 抛物线食物 */
.flying-food-projectile {
  position: absolute;
  bottom: 80rpx;
  left: 20rpx;
  z-index: 30;
  pointer-events: none;
}
.food-emoji { font-size: 52rpx; }

/* 飘字 EXP */
.floating-exp-gain {
  position: absolute;
  top: 40rpx;
  z-index: 30;
  pointer-events: none;
}
.exp-text {
  font-size: 32rpx;
  font-weight: 900;
  color: #EC4899;
  text-shadow: 0 2rpx 8rpx rgba(236, 72, 153, 0.4);
}

/* 动效动画 */
.animate-pet-squish {
  animation: jellySquish 0.5s ease;
}
@keyframes jellySquish {
  0% { transform: scale(1, 1); }
  30% { transform: scale(1.18, 0.82); }
  60% { transform: scale(0.92, 1.1); }
  80% { transform: scale(1.05, 0.95); }
  100% { transform: scale(1, 1); }
}

.animate-pet-chew {
  animation: happyJump 0.8s ease;
}
@keyframes happyJump {
  0%, 100% { transform: translateY(0); }
  40% { transform: translateY(-30rpx) scale(1.08, 0.95); }
  60% { transform: translateY(0) scale(0.95, 1.05); }
}

.animate-idle-breathe {
  animation: petBreathe 3s ease-in-out infinite;
}
@keyframes petBreathe {
  0%, 100% { transform: translateY(0) scale(1, 1); }
  50% { transform: translateY(-8rpx) scale(1.02, 0.98); }
}

.animate-heart-fly {
  animation: heartFlyUp 0.6s ease-out forwards;
}
@keyframes heartFlyUp {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  50% { opacity: 1; transform: translateY(-40rpx) scale(1.2); }
  100% { transform: translateY(-90rpx) scale(1); opacity: 0; }
}

.animate-food-parabola {
  animation: foodArc 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}
@keyframes foodArc {
  0% { transform: translate(0, 0) scale(0.8); opacity: 1; }
  50% { transform: translate(160rpx, -140rpx) scale(1.2); }
  100% { transform: translate(200rpx, -20rpx) scale(0.2); opacity: 0; }
}

.animate-exp-up {
  animation: expFloatUp 0.8s ease-out forwards;
}
@keyframes expFloatUp {
  0% { transform: translateY(0); opacity: 0; }
  30% { opacity: 1; transform: translateY(-20rpx); }
  100% { transform: translateY(-60rpx); opacity: 0; }
}

/* 光环 */
.evolution-aura-ring {
  position: absolute;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  pointer-events: none;
  animation: ringPulse 3s ease-in-out infinite;
}
.evo-2 {
  border: 4rpx solid rgba(236, 72, 153, 0.4);
  box-shadow: 0 0 40rpx rgba(236, 72, 153, 0.3);
}
.evo-3 {
  border: 6rpx solid rgba(245, 158, 11, 0.6);
  box-shadow: 0 0 60rpx rgba(245, 158, 11, 0.5);
}
@keyframes ringPulse {
  0%, 100% { transform: scale(0.95); opacity: 0.5; }
  50% { transform: scale(1.05); opacity: 0.9; }
}

/* 顶部轻量浮动 HUD */
.floating-hud-bar {
  padding: 16rpx 32rpx;
}

.hud-pet-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #0F172A;
}

.hud-species-tag {
  font-size: 22rpx;
  font-weight: 800;
  color: #EC4899;
  background: #FFF1F2;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid #FECDD3;
}

.hud-level-tag {
  font-size: 20rpx;
  font-weight: 800;
  color: #FFFFFF;
  background: #0F172A;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.stage-rank-tag {
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.stage-rank-1 { background: #ECFDF5; color: #047857; }
.stage-rank-2 { background: #FFF1F2; color: #E11D48; }
.stage-rank-3 { background: #FEF3C7; color: #B45309; }

/* 心情胶囊栏与陪伴天数 */
.mood-pill {
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 1.5rpx solid #E2E8F0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.mood-icon { font-size: 24rpx; margin-right: 6rpx; }
.mood-text { font-size: 22rpx; font-weight: 800; color: #334155; }

.hud-streak-tag {
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  background: #FFF7ED;
  border: 1.5rpx solid #FFEDD5;
}

.touch-hint-label {
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 14rpx;
}

/* 🎋 自律心声面板 (莫兰迪奶油风) */
.treehole-chat-deck {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  margin: 24rpx 28rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  border: 1.5rpx solid #F1F5F9;
}

.interactive-chips-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.chip-action-btn {
  background: #FDFBF7;
  border: 1.5rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 18rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  transition: all 0.2s ease;
}

.chip-action-btn:active {
  background: #FFF1F2;
  border-color: #FECDD3;
  transform: scale(0.97);
}

.chip-emoji { font-size: 30rpx; }
.chip-title { font-size: 23rpx; font-weight: 800; color: #334155; }

/* 仪表盘卡片 */
.gamified-stats-deck {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin: 24rpx 28rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  border: 1.5rpx solid #F1F5F9;
}

.gauge-name { font-size: 24rpx; font-weight: 800; color: #334155; }
.gauge-number { font-size: 24rpx; font-weight: 900; }

.gauge-track {
  height: 18rpx;
  background: #F1F5F9;
  border-radius: 20rpx;
  overflow: hidden;
}

.gauge-fill {
  height: 100%;
  border-radius: 20rpx;
  transition: width 0.4s ease;
}

.pill-box {
  background: #F8FAFC;
  border: 1.5rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  width: 47%;
  box-sizing: border-box;
}

/* 操作按键区 */
.action-deck-card {
  margin: 24rpx 28rpx 0;
}

.btn-3d-action {
  flex: 1;
  height: 96rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.btn-3d-feed {
  background: linear-gradient(135deg, #F472B6 0%, #EC4899 100%);
  color: #FFFFFF;
}

.btn-3d-checkin {
  background: linear-gradient(135deg, #FBBF24 0%, #F59E0B 100%);
  color: #FFFFFF;
}

/* 赚粮任务卡片 */
.food-tasks-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin: 24rpx 28rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  border: 1.5rpx solid #F1F5F9;
}

.task-item-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.task-row {
  background: #FDFBF7;
  border: 1.5rpx solid #E2E8F0;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
}

.task-icon { font-size: 34rpx; }
.task-title { font-size: 26rpx; font-weight: 900; color: #0F172A; }
.task-reward { font-size: 20rpx; color: #64748B; margin-top: 4rpx; }

.btn-task {
  font-size: 22rpx;
  font-weight: 800;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  margin: 0;
}

.btn-task.action {
  background: #ECFDF5;
  color: #047857;
  border: 1.5rpx solid #A7F3D0;
}

.btn-task.done {
  background: #F1F5F9;
  color: #94A3B8;
  border: 1.5rpx solid #E2E8F0;
}

/* ================= 📸 小红书自律拍立得弹窗样式 ================= */
.polaroid-modal-backdrop {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(10px);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.polaroid-modal-backdrop.show {
  opacity: 1;
  pointer-events: auto;
}

.polaroid-modal-sheet {
  background: #FDFBF7;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 32rpx 60rpx;
  max-height: 85vh;
  overflow-y: auto;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.15);
}

.sheet-header .sheet-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #0F172A;
}

.sheet-header .sheet-close {
  font-size: 32rpx;
  color: #94A3B8;
  padding: 10rpx;
}

.sheet-subtitle {
  font-size: 22rpx;
  color: #64748B;
  margin: 6rpx 0 24rpx;
  display: block;
}

/* 拍立得相框本体 */
.polaroid-card-frame {
  position: relative;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 28rpx 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #E2E8F0;
  margin: 10rpx 10rpx 30rpx;
}

.polaroid-tape {
  position: absolute;
  top: -14rpx;
  width: 140rpx;
  height: 32rpx;
  background: rgba(254, 205, 211, 0.7);
  border-radius: 6rpx;
  transform: rotate(-3deg);
}

.polaroid-photo-box {
  position: relative;
  width: 100%;
  height: 340rpx;
  background: radial-gradient(circle at 50% 40%, #FFF1F2 0%, #F0FDF4 70%, #FDFBF7 100%);
  border-radius: 16rpx;
  border: 1.5rpx solid #E2E8F0;
  overflow: hidden;
}

.polaroid-pet-img {
  width: 260rpx;
  height: 260rpx;
}

.polaroid-stamp {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: #FFFFFF;
  color: #EC4899;
  font-size: 20rpx;
  font-weight: 900;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid #FECDD3;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.polaroid-caption-wrap {
  margin-top: 24rpx;
  text-align: center;
}

.polaroid-handwriting {
  font-size: 28rpx;
  font-weight: 900;
  color: #0F172A;
  letter-spacing: 0.5rpx;
}

.polaroid-date {
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 8rpx;
}

.polaroid-stats-capsules {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.p-cap {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.btn-save-polaroid {
  background: linear-gradient(135deg, #F472B6 0%, #EC4899 100%);
  color: #FFFFFF;
  border-radius: 30rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 24rpx rgba(236, 72, 153, 0.3);
}

/* 图鉴与勋章馆 Sheet */
.dex-modal-backdrop, .badge-modal-backdrop, .evo-modal-backdrop {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(10px);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.dex-modal-backdrop.show, .badge-modal-backdrop.show, .evo-modal-backdrop.show {
  opacity: 1;
  pointer-events: auto;
}

.dex-modal-sheet, .badge-modal-sheet {
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 32rpx 60rpx;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.15);
}

.dex-stage-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dex-card {
  background: #FDFBF7;
  border: 1.5rpx solid #E2E8F0;
  border-radius: 24rpx;
  padding: 24rpx;
}

.dex-card.current {
  background: #FFF1F2;
  border-color: #FECDD3;
  box-shadow: 0 4rpx 16rpx rgba(236, 72, 153, 0.12);
}

.dex-card.locked { opacity: 0.7; }
.dex-rank-badge { font-size: 20rpx; font-weight: 800; color: #EC4899; background: #FFF1F2; padding: 2rpx 12rpx; border-radius: 8rpx; }
.dex-stage-name { font-size: 26rpx; font-weight: 900; color: #0F172A; }
.dex-status-pill { font-size: 20rpx; font-weight: 800; color: #64748B; background: #E2E8F0; padding: 4rpx 16rpx; border-radius: 20rpx; }
.dex-status-pill.active { background: #ECFDF5; color: #047857; }
.dex-avatar-preview { height: 220rpx; margin: 14rpx 0; }
.dex-avatar-img { width: 200rpx; height: 200rpx; }
.dex-avatar-img.silhouette { filter: brightness(0.2) opacity(0.5); }
.dex-stage-desc { font-size: 22rpx; color: #475569; line-height: 1.5; }

/* 勋章馆 */
.badge-grid-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.badge-card-item {
  background: #FDFBF7;
  border: 1.5rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.badge-card-item.unlocked {
  background: #FEF3C7;
  border-color: #FDE68A;
}
.badge-icon-wrap { position: relative; width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; }
.badge-emoji { font-size: 48rpx; }
.badge-lock-tag, .badge-check-tag {
  position: absolute; bottom: 0; right: 0; font-size: 18rpx;
  background: #0F172A; color: #FFFFFF; border-radius: 50%;
  width: 26rpx; height: 26rpx; line-height: 26rpx; text-align: center;
}
.badge-check-tag { background: #10B981; }
.badge-name { font-size: 22rpx; font-weight: 900; color: #0F172A; margin-top: 8rpx; }
.badge-req { font-size: 18rpx; color: #64748B; margin-top: 2rpx; }
.badge-detail-card { background: #FDFBF7; border: 1.5rpx solid #E2E8F0; border-radius: 20rpx; padding: 20rpx; }
.badge-status-pill { font-size: 20rpx; font-weight: 800; padding: 2rpx 12rpx; border-radius: 10rpx; }
