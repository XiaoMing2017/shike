/* pages/pet/pet.wxss */
.pet-immersive-page {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: 180rpx;
  position: relative;
  box-sizing: border-box;
}

/* 顶部导航与状态栏 */
.top-nav-bar {
  padding: 30rpx 32rpx 20rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
}

.brand-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #0F172A;
  letter-spacing: 0.5rpx;
}

.brand-sub {
  font-size: 20rpx;
  color: #64748B;
  font-weight: 600;
  margin-top: 2rpx;
}

.scene-switch-capsule {
  background: #ECFDF5;
  border: 1.5rpx solid #A7F3D0;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.12);
}

/* ================= 3D 核心生活大场景 ================= */
.virtual-3d-world-scene {
  position: relative;
  width: 100%;
  height: 640rpx;
  overflow: hidden;
  box-shadow: inset 0 -20rpx 30rpx rgba(0, 0, 0, 0.15);
}

.scene-panoramic-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.scene-overlay-soft {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.1) 0%, rgba(0, 0, 0, 0.15) 100%);
  z-index: 2;
}

/* 场景微尘与光线粒子 */
.world-sun-ray {
  position: absolute;
  top: -50rpx;
  left: -50rpx;
  width: 300rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 70%);
  transform: rotate(35deg);
  pointer-events: none;
  z-index: 3;
}

.world-sparkle {
  position: absolute;
  font-size: 28rpx;
  pointer-events: none;
  z-index: 4;
  animation: sparkleFloat 4s ease-in-out infinite alternate;
}
.sp1 { top: 12%; left: 18%; animation-delay: 0s; }
.sp2 { top: 28%; right: 15%; animation-delay: 1.5s; }
.sp3 { bottom: 35%; left: 22%; animation-delay: 2.5s; }

@keyframes sparkleFloat {
  0% { transform: translateY(0) scale(0.85); opacity: 0.4; }
  100% { transform: translateY(-24rpx) scale(1.15); opacity: 0.95; }
}

/* 场景食盆 */
.scene-food-bowl {
  position: absolute;
  z-index: 5;
  transform: translate(-50%, -50%);
  cursor: pointer;
}

.bowl-plate {
  width: 56rpx;
  height: 38rpx;
  background: #FEF3C7;
  border: 2rpx solid #F59E0B;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
}

.bowl-food-item {
  font-size: 24rpx;
  transform: translateY(-4rpx);
}

.bowl-shadow {
  width: 60rpx;
  height: 14rpx;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 50%;
  margin-top: -6rpx;
}

/* ================= 自由漫步活体宠物 ================= */
.roaming-pet-entity {
  position: absolute;
  z-index: 10;
  transform: translate(-50%, -85%);
  transition: left 1.8s cubic-bezier(0.25, 1, 0.5, 1), top 1.8s cubic-bezier(0.25, 1, 0.5, 1);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pet-mesh-container {
  position: relative;
  width: 170rpx;
  height: 170rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease;
}

.pet-cutout-img {
  width: 160rpx;
  height: 160rpx;
  filter: drop-shadow(0 6rpx 12rpx rgba(0, 0, 0, 0.18));
}

/* 触地柔光阴影 */
.pet-floor-shadow {
  position: absolute;
  bottom: 0;
  width: 110rpx;
  height: 24rpx;
  background: radial-gradient(ellipse at center, rgba(15, 23, 42, 0.45) 0%, rgba(15, 23, 42, 0) 70%);
  border-radius: 50%;
  z-index: -1;
}

/* 状态微标 */
.pet-status-mini-bubble {
  position: absolute;
  top: -30rpx;
  background: rgba(15, 23, 42, 0.75);
  color: #FFFFFF;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

/* 悬浮台词气泡 */
.speech-bubble-3d {
  position: absolute;
  top: -95rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1.5rpx solid #10B981;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
  white-space: nowrap;
  z-index: 20;
}

.bubble-msg {
  font-size: 22rpx;
  font-weight: 800;
  color: #0F172A;
}

.bubble-arrow {
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid #10B981;
}

/* 爱心粒子迸发 */
.heart-burst-particle {
  position: absolute;
  top: -60rpx;
  font-size: 40rpx;
  z-index: 25;
}

.animate-heart-fly {
  animation: heartFlyUp 0.8s ease-out forwards;
}

@keyframes heartFlyUp {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  40% { transform: translateY(-40rpx) scale(1.4); opacity: 1; }
  100% { transform: translateY(-100rpx) scale(1); opacity: 0; }
}

/* 投喂抛物线与飘字 */
.flying-food-projectile {
  position: absolute;
  bottom: -40rpx;
  font-size: 48rpx;
  z-index: 30;
}

.animate-food-parabola {
  animation: foodParabolaFly 0.7s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
}

@keyframes foodParabolaFly {
  0% { transform: translate(0, 100rpx) scale(0.5); opacity: 0; }
  50% { transform: translate(-30rpx, -60rpx) scale(1.2); opacity: 1; }
  100% { transform: translate(0, 0) scale(0.8); opacity: 0; }
}

.floating-exp-gain {
  position: absolute;
  top: -70rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #F59E0B;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  z-index: 35;
}

.animate-exp-up {
  animation: expFloatUp 0.8s ease-out forwards;
}

@keyframes expFloatUp {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  50% { transform: translateY(-30rpx) scale(1.2); opacity: 1; }
  100% { transform: translateY(-70rpx) scale(1); opacity: 0; }
}

/* ================= 宠物动作动画 ================= */

/* 1. 待机呼吸 */
.animate-idle-breathe {
  animation: petBreathe 3s ease-in-out infinite alternate;
}

@keyframes petBreathe {
  0% { transform: translateY(0) scale(1, 1); }
  50% { transform: translateY(-6rpx) scale(1.02, 0.98) rotate(0.5deg); }
  100% { transform: translateY(-10rpx) scale(1.04, 0.96) rotate(-0.5deg); }
}

/* 2. 漫步走动小碎步 */
.animate-pet-walk {
  animation: petWalkStep 0.4s ease-in-out infinite alternate;
}

@keyframes petWalkStep {
  0% { transform: translateY(0) rotate(-4deg); }
  100% { transform: translateY(-12rpx) rotate(4deg); }
}

/* 3. 欢快干饭咀嚼 */
.animate-pet-chew {
  animation: petChewHappy 0.5s ease-in-out 3;
}

@keyframes petChewHappy {
  0%, 100% { transform: scale(1, 1); }
  30% { transform: scale(1.15, 0.85) translateY(6rpx); }
  60% { transform: scale(0.9, 1.15) translateY(-14rpx); }
}

/* 4. 触碰撒欢欢跳 */
.animate-pet-happy {
  animation: petHappyJump 0.6s ease-out 1;
}

@keyframes petHappyJump {
  0% { transform: scale(1, 1); }
  30% { transform: scale(1.2, 0.8) translateY(8rpx); }
  60% { transform: scale(0.85, 1.25) translateY(-28rpx); }
  85% { transform: scale(1.05, 0.95) translateY(0); }
  100% { transform: scale(1, 1); }
}

/* 场景底部快捷切换药丸栏 */
.scene-quick-bar {
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  right: 24rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 40rpx;
  padding: 8rpx 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 40;
}

.scene-tab-pill {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 30rpx;
  transition: all 0.2s ease;
}

.scene-tab-pill.active {
  background: #10B981;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.35);
}

.scene-pill-icon {
  font-size: 24rpx;
}

.scene-pill-name {
  font-size: 22rpx;
  font-weight: 800;
}

.scene-tab-pill:not(.active) .scene-pill-name {
  color: #475569;
}

.touch-hint-label {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(8px);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  z-index: 40;
  white-space: nowrap;
}

/* ================= 浮动 HUD 与仪表盘 ================= */
.floating-hud-bar {
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F1F5F9;
}

.hud-pet-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #0F172A;
}

.hud-level-tag {
  background: #10B981;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.scene-cur-badge {
  background: #F1F5F9;
  color: #475569;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.hud-streak-tag {
  background: #FFF7ED;
  border: 1rpx solid #FFEDD5;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 游戏化数值卡片 */
.gamified-stats-deck {
  margin: 24rpx 32rpx;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #E2E8F0;
}

.mood-pill {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: #ECFDF5;
  border: 1rpx solid #A7F3D0;
}

.mood-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #047857;
  margin-left: 6rpx;
}

.stat-gauge-cell {
  width: 100%;
}

.gauge-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
}

.gauge-number {
  font-size: 24rpx;
  font-weight: 900;
}

.gauge-track {
  height: 16rpx;
  background: #E2E8F0;
  border-radius: 10rpx;
  overflow: hidden;
}

.gauge-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.stat-pills-row {
  gap: 20rpx;
}

.pill-box {
  flex: 1;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  padding: 14rpx;
  border-radius: 18rpx;
}

/* 底部操作区 */
.action-deck-card {
  margin: 0 32rpx;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #E2E8F0;
}

.btn-3d-action {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  border: none;
}

.btn-3d-feed {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.3);
}

.btn-3d-exercise {
  background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.3);
}

.daily-reward-tip {
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
}

.tip-content {
  font-size: 22rpx;
  color: #166534;
  line-height: 1.4;
}

/* ================= 领养流程视图 ================= */
.adopt-showcase-flow {
  padding: 24rpx 32rpx;
}

.adopt-banner-card {
  background: linear-gradient(135deg, #ECFDF5 0%, #F0FDF4 100%);
  border: 1.5rpx solid #A7F3D0;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.banner-desc {
  font-size: 24rpx;
  color: #065F46;
  line-height: 1.5;
}

.adopt-3d-stage-box {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #E2E8F0;
  margin-bottom: 24rpx;
}

.stage-3d-viewport {
  position: relative;
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  background-size: cover;
  background-position: center;
  overflow: hidden;
}

.pet-model-anchor {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pet-model-img {
  width: 220rpx;
  height: 220rpx;
  filter: drop-shadow(0 12rpx 20rpx rgba(0, 0, 0, 0.3));
}

.pet-dynamic-shadow {
  width: 140rpx;
  height: 26rpx;
  background: radial-gradient(ellipse at center, rgba(15, 23, 42, 0.45) 0%, rgba(15, 23, 42, 0) 70%);
  border-radius: 50%;
  margin-top: -12rpx;
}

.type-capsule {
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 800;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.type-motto {
  font-size: 22rpx;
  color: #64748B;
  font-style: italic;
  margin-top: 8rpx;
}

.type-switch-panel, .name-edit-panel {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #E2E8F0;
  margin-bottom: 24rpx;
}

.panel-label {
  font-size: 26rpx;
  font-weight: 800;
  color: #0F172A;
  margin-bottom: 16rpx;
  display: block;
}

.type-grid {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  transition: all 0.2s ease;
}

.type-item.active {
  background: #ECFDF5;
  border-color: #10B981;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.2);
}

.type-icon { font-size: 36rpx; }
.type-text { font-size: 22rpx; font-weight: 800; color: #334155; margin-top: 6rpx; }

.input-row {
  gap: 16rpx;
}

.name-ipt {
  flex: 1;
  height: 76rpx;
  background: #F8FAFC;
  border: 1.5rpx solid #CBD5E1;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.dice-btn {
  background: #F1F5F9;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #475569;
}

.candidate-row {
  margin-top: 16rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag-name {
  background: #F1F5F9;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #475569;
}

.btn-3d-adopt {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  height: 96rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.35);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 场景切换弹窗 */
.scene-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
  z-index: 9999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.scene-modal-backdrop.show {
  opacity: 1;
  pointer-events: auto;
}

.scene-modal-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #0F172A;
}

.sheet-close {
  font-size: 32rpx;
  color: #94A3B8;
  padding: 10rpx;
}

.sheet-subtitle {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 6rpx;
  margin-bottom: 24rpx;
  display: block;
}

.scene-card-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.scene-select-card {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.scene-select-card.active {
  border-color: #10B981;
  background: #ECFDF5;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.2);
}

.scene-card-img {
  width: 140rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 18rpx;
}

.scene-card-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F172A;
}

.cur-active-badge {
  background: #10B981;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.scene-card-motto {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 6rpx;
}

/* ================= 禁用与下架状态 ================= */
.disabled-state-box {
  padding: 140rpx 40rpx;
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.04);
  text-align: center;
  margin: 40rpx 32rpx;
}

.disabled-icon-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  background: #F1F5F9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.disabled-lock-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  font-size: 32rpx;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 4rpx;
}

.disabled-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #0F172A;
  margin-bottom: 14rpx;
}

.disabled-desc {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.6;
  max-width: 80%;
  margin-bottom: 40rpx;
}

.btn-back-home {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  padding: 18rpx 48rpx;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.3);
  border: none;
}


/* 睡觉 zZZ 动画 */
.sleep-bubble-anim {
  position: absolute;
  top: -80rpx;
  right: -20rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #6366F1;
  animation: zzzFly 2s ease-in-out infinite;
  z-index: 30;
}

@keyframes zzzFly {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  50% { transform: translateY(-20rpx) scale(1.1); opacity: 1; }
  100% { transform: translateY(-45rpx) scale(1.3); opacity: 0; }
}

/* 宠物心声小胶囊 */
.pet-thought-capsule {
  position: absolute;
  bottom: -32rpx;
  background: rgba(15, 23, 42, 0.80);
  backdrop-filter: blur(10px);
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  white-space: nowrap;
