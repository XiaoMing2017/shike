/* pages/pet/pet.wxss */
.pet-immersive-page {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* 顶部导航与状态栏 */
.top-nav-bar {
  padding: 30rpx 32rpx 20rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
}

.brand-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #0F172A;
  letter-spacing: 0.5rpx;
}

.brand-sub {
  font-size: 20rpx;
  color: #64748B;
  font-weight: 600;
  margin-top: 2rpx;
}

.refresh-pill {
  background: #ECFDF5;
  border: 1.5rpx solid #A7F3D0;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

/* ================= Our Teacher 风格 3D 核心互动舞台 ================= */
.virtual-3d-world {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: radial-gradient(circle at 50% 30%, #E0F2FE 0%, #F0FDF4 55%, #F8FAFC 100%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.world-sun-ray {
  position: absolute;
  top: -80rpx;
  left: 20%;
  width: 400rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0) 70%);
  transform: rotate(25deg);
  pointer-events: none;
}

.world-sparkle {
  position: absolute;
  font-size: 28rpx;
  pointer-events: none;
  animation: sparkleFloat 4s ease-in-out infinite alternate;
}
.sp1 { top: 18%; left: 15%; animation-delay: 0s; }
.sp2 { top: 35%; right: 18%; animation-delay: 1.5s; }
.sp3 { bottom: 25%; left: 22%; animation-delay: 2.5s; }

@keyframes sparkleFloat {
  0% { transform: translateY(0) scale(0.8); opacity: 0.3; }
  100% { transform: translateY(-30rpx) scale(1.2); opacity: 0.9; }
}

/* 3D 角色舞台与底座 */
.pet-3d-character-stage {
  position: relative;
  width: 420rpx;
  height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.pet-mesh-container {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: transform 0.3s ease;
}

.pet-cutout-img {
  width: 250rpx;
  height: 250rpx;
  filter: drop-shadow(0 14rpx 20rpx rgba(16, 185, 129, 0.25));
}

/* 触地动态阴影 */
.pet-floor-shadow {
  position: absolute;
  bottom: 0;
  width: 170rpx;
  height: 36rpx;
  background: radial-gradient(ellipse at center, rgba(16, 185, 129, 0.45) 0%, rgba(16, 185, 129, 0) 70%);
  border-radius: 50%;
  z-index: -1;
  transition: all 0.3s ease;
}

/* 3D 悬浮草木浮岛底座 */
.stage-3d-island-disc {
  position: absolute;
  bottom: 20rpx;
  width: 320rpx;
  height: 90rpx;
  background: linear-gradient(180deg, #34D399 0%, #059669 100%);
  border-radius: 50%;
  box-shadow: 0 16rpx 36rpx rgba(16, 185, 129, 0.35), inset 0 4rpx 10rpx rgba(255, 255, 255, 0.6);
  z-index: 2;
  transform: perspective(400px) rotateX(46deg);
}

.disc-top-ring {
  position: absolute;
  top: 4rpx;
  left: 6rpx;
  right: 6rpx;
  bottom: 6rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
}

.disc-bottom-base {
  position: absolute;
  bottom: -16rpx;
  left: 20rpx;
  right: 20rpx;
  height: 30rpx;
  background: #047857;
  border-radius: 50%;
  z-index: -1;
}

/* 悬浮台词气泡 */
.speech-bubble-3d {
  position: absolute;
  top: 15rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid #10B981;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(16, 185, 129, 0.2);
  white-space: nowrap;
  z-index: 30;
}

.bubble-msg {
  font-size: 24rpx;
  font-weight: 800;
  color: #0F172A;
}

.bubble-arrow {
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid #10B981;
}

/* 爱心粒子 */
.heart-burst-particle {
  position: absolute;
  top: 40rpx;
  font-size: 44rpx;
  z-index: 35;
}

.animate-heart-fly {
  animation: heartFlyUp 0.8s ease-out forwards;
}

@keyframes heartFlyUp {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  40% { transform: translateY(-40rpx) scale(1.4); opacity: 1; }
  100% { transform: translateY(-100rpx) scale(1); opacity: 0; }
}

/* 抛物线飞行动画食物 */
.flying-food-projectile {
  position: absolute;
  bottom: 0;
  font-size: 54rpx;
  z-index: 40;
}

.animate-food-parabola {
  animation: foodParabolaFly 0.7s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
}

@keyframes foodParabolaFly {
  0% { transform: translate(0, 150rpx) scale(0.5); opacity: 0; }
  50% { transform: translate(-40rpx, -100rpx) scale(1.3); opacity: 1; }
  100% { transform: translate(0, 0) scale(0.9); opacity: 0; }
}

.floating-exp-gain {
  position: absolute;
  top: 20rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #F59E0B;
  text-shadow: 0 2rpx 10rpx rgba(245, 158, 11, 0.4);
  z-index: 45;
}

.animate-exp-up {
  animation: expFloatUp 0.8s ease-out forwards;
}

@keyframes expFloatUp {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  50% { transform: translateY(-30rpx) scale(1.2); opacity: 1; }
  100% { transform: translateY(-70rpx) scale(1); opacity: 0; }
}

/* ================= 核心 3D 动作动画 ================= */

/* 1. 待机自然呼吸 */
.animate-idle-breathe {
  animation: idle3DBreathe 3.2s ease-in-out infinite alternate;
}

@keyframes idle3DBreathe {
  0% { transform: translateY(0) scale(1, 1); }
  100% { transform: translateY(-12rpx) scale(1.03, 0.97); }
}

.shadow-breathe {
  animation: shadowBreathe 3.2s ease-in-out infinite alternate;
}

@keyframes shadowBreathe {
  0% { transform: scale(1); opacity: 0.45; }
  100% { transform: scale(0.85); opacity: 0.25; }
}

/* 2. 触碰 Q 弹果冻 */
.animate-pet-squish {
  animation: jellySquishPop 0.6s cubic-bezier(0.25, 1.5, 0.5, 1) 1;
}

@keyframes jellySquishPop {
  0% { transform: scale(1, 1); }
  25% { transform: scale(1.22, 0.78) translateY(12rpx); }
  50% { transform: scale(0.84, 1.2) translateY(-24rpx); }
  75% { transform: scale(1.08, 0.94) translateY(4rpx); }
  100% { transform: scale(1, 1) translateY(0); }
}

.shadow-squish {
  animation: shadowSquish 0.6s ease 1;
}

@keyframes shadowSquish {
  0%, 100% { transform: scale(1); }
  25% { transform: scale(1.25); }
  50% { transform: scale(0.7); }
}

/* 3. 欢快干饭咀嚼 */
.animate-pet-chew {
  animation: petChewHappy 0.45s ease-in-out 3;
}

@keyframes petChewHappy {
  0%, 100% { transform: scale(1, 1); }
  30% { transform: scale(1.15, 0.85) translateY(8rpx); }
  60% { transform: scale(0.9, 1.15) translateY(-16rpx); }
}

.shadow-chew {
  animation: shadowChew 0.45s ease-in-out 3;
}

@keyframes shadowChew {
  0%, 100% { transform: scale(1); }
  60% { transform: scale(0.8); }
}

/* 心情胶囊栏 */
.mood-bar-row {
  margin-top: 10rpx;
}

.mood-pill {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background: #ECFDF5;
  border: 1.5rpx solid #A7F3D0;
}

.mood-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #047857;
  margin-left: 6rpx;
}

.touch-hint-label {
  margin-top: 14rpx;
  color: #94A3B8;
  font-size: 20rpx;
  font-weight: 600;
}

/* ================= 浮动 HUD 与仪表盘 ================= */
.floating-hud-bar {
  padding: 18rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F1F5F9;
}

.hud-pet-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #0F172A;
}

.hud-level-tag {
  background: #10B981;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
}

.hud-streak-tag {
  background: #FFF7ED;
  border: 1rpx solid #FFEDD5;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

/* 游戏化数值卡片 */
.gamified-stats-deck {
  margin: 24rpx 32rpx;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #E2E8F0;
}

.stat-gauge-cell {
  width: 100%;
}

.gauge-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
}

.gauge-number {
  font-size: 24rpx;
  font-weight: 900;
}

.gauge-track {
  height: 16rpx;
  background: #E2E8F0;
  border-radius: 10rpx;
  overflow: hidden;
}

.gauge-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.stat-pills-row {
  gap: 20rpx;
}

.pill-box {
  flex: 1;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  padding: 16rpx;
  border-radius: 20rpx;
}

/* 底部操作区 */
.action-deck-card {
  margin: 0 32rpx;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #E2E8F0;
}

.btn-3d-action {
  flex: 1;
  height: 90rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  border: none;
}

.btn-3d-feed {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.35);
}

.btn-3d-exercise {
  background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
  box-shadow: 0 8rpx 20rpx rgba(99, 102, 241, 0.35);
}

.daily-reward-tip {
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
}

.tip-content {
  font-size: 22rpx;
  color: #166534;
  line-height: 1.4;
}

/* ================= 领养向导视图 ================= */
.adopt-showcase-flow {
  padding: 24rpx 32rpx;
}

.adopt-banner-card {
  background: linear-gradient(135deg, #ECFDF5 0%, #F0FDF4 100%);
  border: 1.5rpx solid #A7F3D0;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.banner-desc {
  font-size: 24rpx;
  color: #065F46;
  line-height: 1.5;
}

.adopt-3d-stage-box {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid #E2E8F0;
  margin-bottom: 24rpx;
}

.stage-3d-viewport {
  position: relative;
  width: 100%;
  height: 380rpx;
  background: radial-gradient(circle at 50% 30%, #E0F2FE 0%, #F0FDF4 55%, #FFFFFF 100%);
  border-radius: 20rpx;
  overflow: hidden;
}

.pet-model-anchor {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pet-model-img {
  width: 240rpx;
  height: 240rpx;
  filter: drop-shadow(0 14rpx 24rpx rgba(16, 185, 129, 0.3));
}

.pet-dynamic-shadow {
  width: 150rpx;
  height: 30rpx;
  background: radial-gradient(ellipse at center, rgba(16, 185, 129, 0.45) 0%, rgba(16, 185, 129, 0) 70%);
  border-radius: 50%;
  margin-top: -12rpx;
}

.type-capsule {
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 800;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.type-motto {
  font-size: 22rpx;
  color: #64748B;
  font-style: italic;
  margin-top: 8rpx;
}

.type-switch-panel, .name-edit-panel {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #E2E8F0;
  margin-bottom: 24rpx;
}

.panel-label {
  font-size: 26rpx;
  font-weight: 800;
  color: #0F172A;
  margin-bottom: 16rpx;
  display: block;
}

.type-grid {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  transition: all 0.2s ease;
}

.type-item.active {
  background: #ECFDF5;
  border-color: #10B981;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.2);
}

.type-icon { font-size: 36rpx; }
.type-text { font-size: 22rpx; font-weight: 800; color: #334155; margin-top: 6rpx; }

.input-row {
  gap: 16rpx;
}

.name-ipt {
  flex: 1;
  height: 76rpx;
  background: #F8FAFC;
  border: 1.5rpx solid #CBD5E1;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.dice-btn {
  background: #F1F5F9;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #475569;
}

.candidate-row {
  margin-top: 16rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag-name {
  background: #F1F5F9;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #475569;
}

.btn-3d-adopt {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  height: 96rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.35);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ================= 禁用与下架状态 ================= */
.disabled-state-box {
  padding: 140rpx 40rpx;
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.04);
  text-align: center;
  margin: 40rpx 32rpx;
}

.disabled-icon-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  background: #F1F5F9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.disabled-lock-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  font-size: 32rpx;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  padding: 4rpx;
}

.disabled-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #0F172A;
  margin-bottom: 14rpx;
}

.disabled-desc {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.6;
  max-width: 80%;
  margin-bottom: 40rpx;
}

.btn-back-home {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  padding: 18rpx 48rpx;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.3);
  border: none;
}
