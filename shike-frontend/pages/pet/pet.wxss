}
.btn-quest-done {
  background: #E2E8F0;
  color: #94A3B8;
  font-size: 22rpx;
  font-weight: 800;
  border-radius: 30rpx;
  padding: 8rpx 24rpx;
  border: none;
}

/* ================= 8. 底部操作栏 ================= */
.bottom-action-dock {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
