<view class="container">
  <!-- 1. 用户信息卡片 -->
  <view class="glass-card user-info-card">
    <view style="display: flex; align-items: center;">
      <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      </button>
      <view class="user-meta">
        <view class="nickname-row flex align-center">
          <input class="nickname-input" type="nickname" placeholder="点击输入昵称" value="{{nickname}}" bindblur="onNicknameBlur" bindinput="onNicknameInput" />
          <text class="edit-icon">✏️</text>
        </view>
        <text class="user-id">咔嚓算卡ID: {{userId}}</text>
        <text class="user-id" style="margin-top: 5rpx; color: #10B981; font-weight: 600; text-decoration: underline;" catchtap="showPointsBill">契约积分: {{points}} pts 📋</text>
      </view>
    </view>
    <view class="signin-btn-container">
      <button class="btn-signin" catchtap="onSignIn" disabled="{{alreadySignedIn}}">
        {{alreadySignedIn ? '已签到' : '签到 +20'}}
      </button>
    </view>
  </view>

  <!-- 历史饮食日历入口 -->
  <view class="glass-card flex justify-between align-center" style="margin-bottom: 24rpx; padding: 24rpx 30rpx; cursor: pointer;" catchtap="onTapHistory">
    <view class="flex align-center" style="gap: 15rpx; align-items: center; display: flex;">
      <text style="font-size: 34rpx;">📅</text>
      <text style="font-weight: 700; color: #1E293B; font-size: 28rpx;">我的饮食日记与卡路里日历</text>
    </view>
    <text style="color: #94A3B8; font-weight: bold; font-size: 26rpx;">></text>
  </view>

  <!-- 🎯 AI 专属计划入口卡片 -->
  <view class="glass-card flex justify-between align-center" style="margin-bottom: 24rpx; padding: 24rpx 30rpx; cursor: pointer; background: linear-gradient(135deg, rgba(238, 242, 255, 0.9) 0%, rgba(243, 244, 246, 0.95) 100%); border: 1rpx solid rgba(99, 102, 241, 0.25);" catchtap="onGoToHomePlan">
    <view class="flex align-center" style="gap: 15rpx; align-items: center; display: flex;">
      <text style="font-size: 34rpx;">🎯</text>
      <view class="flex flex-col">
        <text style="font-weight: 700; color: #1E293B; font-size: 28rpx;">我的专属 AI 运动与膳食计划</text>
        <text style="font-size: 20rpx; color: #6366F1; font-weight: 600;">遵循 RD/CSCS 知识库 · 科学循序渐进</text>
      </view>
    </view>
    <text style="color: #6366F1; font-weight: bold; font-size: 26rpx;">查看 ></text>
  </view>

  <!-- 2. 健康档案编辑 -->
  <view class="glass-card profile-form-card">
    <view class="card-title flex justify-between align-center" catchtap="toggleFormCollapse" style="cursor: pointer;">
      <text>身体健康数据 (用于计算TDEE)</text>
      <text style="color: #10B981; font-size: 24rpx; font-weight: bold;">{{isFormCollapsed ? '展开 ▾' : '收起 ▴'}}</text>
    </view>
    
    <view wx:if="{{!isFormCollapsed}}" class="form-content-wrap" style="margin-top: 20rpx;">
      <view class="form-item flex justify-between align-center">
        <text class="label">年龄 (岁)</text>
        <input class="input" type="number" value="{{age}}" bindinput="onAgeInput" bindblur="onFieldBlur" />
      </view>
      
      <view class="form-item flex justify-between align-center" catchtap="showGenderModal">
        <text class="label">性别</text>
        <view class="picker-val">{{genderOptions[genderIndex].label}} ▾</view>
      </view>
      
      <view class="form-item flex justify-between align-center">
        <text class="label">身高 (cm)</text>
        <input class="input" type="digit" value="{{height}}" bindinput="onHeightInput" bindblur="onFieldBlur" />
      </view>
      
      <view class="form-item flex justify-between align-center">
        <text class="label">当前体重 (kg)</text>
        <input class="input" type="digit" value="{{weight}}" bindinput="onWeightInput" bindblur="onFieldBlur" />
      </view>

      <view class="form-item flex justify-between align-center" catchtap="showTrainingModal">
        <text class="label">训练经验等级</text>
        <view class="picker-val">{{trainingOptions[trainingIndex].label}} ▾</view>
      </view>
 
      <view class="form-item flex justify-between align-center" catchtap="showActivityModal">
        <text class="label">日常活动系数</text>
        <view class="picker-val">{{activityOptions[activityIndex].label}} ▾</view>
      </view>
 
      <view class="form-item flex justify-between align-center" catchtap="showGoalModal">
        <text class="label">减脂/增肌目标</text>
        <view class="picker-val">{{goalOptions[goalIndex].label}} ▾</view>
      </view>

      <!-- Custom periodic weight goal inputs -->
      <block wx:if="{{goalOptions[goalIndex].key === 'PERIOD'}}">
        <view class="form-item flex justify-between align-center">
          <text class="label">计划目标方向</text>
          <view class="period-direction-toggle flex">
            <view class="dir-btn {{periodDirection === 'LOSE' ? 'active lose' : ''}}" catchtap="onSelectPeriodDirection" data-dir="LOSE">📉 减脂 (减轻)</view>
            <view class="dir-btn {{periodDirection === 'GAIN' ? 'active gain' : ''}}" catchtap="onSelectPeriodDirection" data-dir="GAIN">📈 增重 (增加)</view>
          </view>
        </view>
        <view class="form-item flex justify-between align-center">
          <text class="label">计划周期 (天)</text>
          <input class="input" type="number" placeholder="如 30, 60, 90" value="{{customGoalDays}}" bindinput="onCustomGoalDaysInput" bindblur="onFieldBlur" />
        </view>
        <view class="form-item flex justify-between align-center">
          <text class="label">{{periodDirection === 'LOSE' ? '期望减重斤数 (斤)' : '期望增重斤数 (斤)'}}</text>
          <input class="input" type="digit" placeholder="如 10" value="{{customGoalWeightDisplay}}" bindinput="onCustomGoalWeightInput" bindblur="onFieldBlur" />
        </view>
      </block>

      <!-- Custom abs visualization goal inputs -->
      <block wx:if="{{goalOptions[goalIndex].key === 'ABS'}}">
        <view class="form-item flex justify-between align-center">
          <text class="label">当前体脂率 (%)</text>
          <input class="input" type="digit" placeholder="如 20" value="{{currentBodyFat}}" bindinput="onCurrentBodyFatInput" bindblur="onFieldBlur" />
        </view>
        <view class="form-item flex justify-between align-center">
          <text class="label">期望达成时间 (天)</text>
          <input class="input" type="number" placeholder="如 60, 90" value="{{customGoalDays}}" bindinput="onCustomGoalDaysInput" bindblur="onFieldBlur" />
        </view>
      </block>

      <!-- Health Warning Notification Block -->
      <block wx:if="{{(goalOptions[goalIndex].key === 'PERIOD' || goalOptions[goalIndex].key === 'ABS') && customGoalWarning}}">
        <view style="background-color: rgba(249, 115, 22, 0.08); border: 1rpx solid #F97316; border-radius: 12rpx; padding: 16rpx 24rpx; margin: 10rpx 0 20rpx 0;">
          <text style="color: #EA580C; font-size: 24rpx; line-height: 1.4; display: block; font-weight: 500;">{{customGoalWarning}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 3. 自动计算出的代谢指标 -->
  <view class="glass-card result-card">
    <view class="card-title">系统计算代谢看板</view>
    <view class="result-grid flex">
      <view class="grid-item flex-col align-center flex">
        <text class="val">{{bmr}}</text>
        <text class="lbl">BMR 基础代谢 (kcal)</text>
      </view>
      <view class="grid-item flex-col align-center flex">
        <text class="val">{{tdee}}</text>
        <text class="lbl">TDEE 总消耗 (kcal)</text>
      </view>
    </view>
    <view class="target-box flex-col align-center flex">
      <text class="target-lbl">建议每日摄入预算</text>
      <text class="target-val">{{targetCal}} 千卡/天</text>
      <text class="formula-info">采用 Mifflin-St Jeor 公式精确推算</text>
    </view>

    <!-- 推荐营养素指标 -->
    <view class="nutrients-target-row flex justify-between">
      <view class="nutrient-target-item flex-col align-center flex">
        <text class="nutrient-lbl">推荐蛋白质</text>
        <text class="nutrient-val protein">{{targetProtein}} g</text>
      </view>
      <view class="nutrient-target-item flex-col align-center flex middle-item">
        <text class="nutrient-lbl">推荐碳水</text>
        <text class="nutrient-val carbs">{{targetCarbs}} g</text>
      </view>
      <view class="nutrient-target-item flex-col align-center flex">
        <text class="nutrient-lbl">推荐脂肪</text>
        <text class="nutrient-val fat">{{targetFat}} g</text>
      </view>
    </view>
  </view>

  <!-- 提示信息：身体数据修改自动保存 -->
  <view style="text-align: center; color: #94A3B8; font-size: 22rpx; margin-top: 10rpx; margin-bottom: 20rpx;">
    💡 身体数据修改后将自动保存并更新看板
  </view>

  <!-- 管理员后台快捷入口 (仅管理员显示) -->
  <view class="glass-card" style="margin-bottom: 30rpx; padding: 24rpx; background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(59, 130, 246, 0.1)); border: 1rpx solid rgba(16, 185, 129, 0.3);" wx:if="{{isAdmin}}">
    <view class="flex justify-between align-center" bindtap="openAdminDashboard">
      <view class="flex align-center" style="gap: 16rpx;">
        <text style="font-size: 36rpx;">👑</text>
        <view class="flex-col">
          <text style="font-size: 28rpx; font-weight: 700; color: #0F172A;">开发者运营后台</text>
          <text style="font-size: 22rpx; color: #64748B;">点击查看全量用户使用统计与 AI 额度</text>
        </view>
      </view>
      <text style="font-size: 28rpx; color: #10B981; font-weight: 700;">查看 ❯</text>
    </view>
  </view>

  <view class="glass-card menu-card" style="margin-top: 24rpx; margin-bottom: 40rpx;" wx:if="{{features.user_feedback !== false}}">
    <view class="menu-item flex justify-between align-center" bindtap="openContactModal">
      <view class="flex align-center" style="gap: 16rpx;">
        <text style="font-size: 32rpx;">💬</text>
        <view class="flex-col">
          <text style="font-size: 28rpx; color: #1E293B; font-weight: 600;">联系客服与意见反馈</text>
          <text style="font-size: 22rpx; color: #94A3B8;">如有疑问或使用建议，随时联系官方客服</text>
        </view>
      </view>
      <text style="font-size: 28rpx; color: #EC4899; font-weight: 700;">反馈 ❯</text>
    </view>
  </view>

  <!-- 日常活动系数居中弹窗 -->
  <view class="modal-backdrop {{showActivitySheet ? 'active' : ''}}" catchtap="hideActivityModal" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">选择日常活动系数</text>
        <text class="modal-close" catchtap="hideActivityModal">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y>
        <view class="modal-option {{activityIndex === index ? 'active' : ''}}" 
              wx:for="{{activityOptions}}" wx:key="key" 
              catchtap="selectActivity" data-index="{{index}}">
          <text class="modal-option-label">{{item.label}}</text>
          <icon type="success_no_circle" size="14" color="#10B981" wx:if="{{activityIndex === index}}" />
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 减脂/增肌目标居中弹窗 -->
  <view class="modal-backdrop {{showGoalSheet ? 'active' : ''}}" catchtap="hideGoalModal" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">选择减脂/增肌目标</text>
        <text class="modal-close" catchtap="hideGoalModal">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y>
        <view class="modal-option {{goalIndex === index ? 'active' : ''}}" 
              wx:for="{{goalOptions}}" wx:key="key" 
              catchtap="selectGoal" data-index="{{index}}">
          <text class="modal-option-label">{{item.label}}</text>
          <icon type="success_no_circle" size="14" color="#10B981" wx:if="{{goalIndex === index}}" />
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 积分账单明细弹窗 -->
  <view class="modal-backdrop {{showPointsBillModal ? 'active' : ''}}" catchtap="hidePointsBill" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble" style="max-height: 70%; display: flex; flex-direction: column;">
      <view class="modal-header">
        <text class="modal-title">📋 积分收支明细</text>
        <text class="modal-close" catchtap="hidePointsBill">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y style="flex: 1; padding: 20rpx 0;">
        <view wx:if="{{pointsRecords.length === 0}}" style="text-align: center; color: #94A3B8; padding: 40rpx; font-size: 26rpx;">
          暂无积分收支明细记录
        </view>
        <view wx:else>
          <view class="points-record-item" wx:for="{{pointsRecords}}" wx:key="id" style="display: flex; justify-content: space-between; align-items: center; padding: 20rpx 30rpx; border-bottom: 1rpx solid #F1F5F9;">
            <view style="display: flex; flex-direction: column; flex: 1;">
              <text style="font-size: 26rpx; color: #1E293B; font-weight: 500;">{{item.remark || (item.amount > 0 ? '积分增加' : '积分扣除')}}</text>
              <text style="font-size: 22rpx; color: #94A3B8; margin-top: 6rpx;">{{item.formattedDate}}</text>
            </view>
            <text style="font-size: 28rpx; font-weight: 700; color: {{item.amount > 0 ? '#10B981' : '#EF4444'}};">
              {{item.amount > 0 ? '+' : ''}}{{item.amount}}
            </text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 性别选择居中弹窗 -->
  <view class="modal-backdrop {{showGenderSheet ? 'active' : ''}}" catchtap="hideGenderModal" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">选择性别</text>
        <text class="modal-close" catchtap="hideGenderModal">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y>
        <view class="modal-option {{genderIndex === index ? 'active' : ''}}" 
              wx:for="{{genderOptions}}" wx:key="key" 
              catchtap="selectGender" data-index="{{index}}">
          <text class="modal-option-label">{{item.label}}</text>
          <icon type="success_no_circle" size="14" color="#10B981" wx:if="{{genderIndex === index}}" />
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 训练经验选择居中弹窗 -->
  <view class="modal-backdrop {{showTrainingSheet ? 'active' : ''}}" catchtap="hideTrainingModal" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">选择训练经验等级</text>
        <text class="modal-close" catchtap="hideTrainingModal">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y>
        <view class="modal-option {{trainingIndex === index ? 'active' : ''}}" 
              wx:for="{{trainingOptions}}" wx:key="key" 
              catchtap="selectTraining" data-index="{{index}}">
          <text class="modal-option-label">{{item.label}}</text>
          <icon type="success_no_circle" size="14" color="#10B981" wx:if="{{trainingIndex === index}}" />
        </view>
      </scroll-view>
    </view>
  </view>
</view>
