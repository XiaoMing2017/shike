/* Container with unified premium background gradient */
.container {
  padding: 30rpx 30rpx 60rpx 30rpx;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #F3F6F8 0%, #EBF4F6 100%);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 1. 用户信息卡片 */
.user-info-card {
  margin-top: 10rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 30rpx 40rpx;
}

.user-meta {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.user-info-card .avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  margin-right: 30rpx;
  box-shadow: 0 10rpx 25rpx rgba(100, 116, 139, 0.12);
}

.user-meta .nickname {
  font-size: 36rpx;
  font-weight: 800;
  color: #1E293B;
  letter-spacing: 0.5rpx;
}

.user-meta .user-id {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 8rpx;
  font-weight: 500;
}

/* 2. 身体数据概览卡片 */
.body-overview-card {
  margin-bottom: 24rpx;
  cursor: pointer;
  transition: transform 0.15s ease;
}

.body-overview-card:active {
  transform: scale(0.99);
}

.overview-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 0.5rpx;
}

.btn-edit-capsule {
  font-size: 22rpx;
  font-weight: 700;
  color: #10B981;
  background: rgba(16, 185, 129, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(16, 185, 129, 0.2);
}

.body-stats-grid {
  width: 100%;
  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  gap: 16rpx !important;
  margin-bottom: 12rpx !important;
  box-sizing: border-box !important;
}

.stat-pill {
  width: 100% !important;
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #F1F5F9;
  display: flex;
  flex-direction: column;
}

.stat-lbl {
  font-size: 20rpx;
  color: #94A3B8;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.stat-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #1E293B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.overview-tip {
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  transition: all 0.2s ease;
}

.overview-tip.success {
  background: rgba(16, 185, 129, 0.08);
  border: 1rpx solid rgba(16, 185, 129, 0.25);
}

.overview-tip.success text {
  color: #047857 !important;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 500;
}

.overview-tip.warn {
  background: rgba(249, 115, 22, 0.08);
  border: 1rpx solid rgba(249, 115, 22, 0.3);
}

.overview-tip.warn text {
  color: #C2410C !important;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 500;
}

/* 弹窗中的表单样式 */
.body-edit-dialog {
  width: 88vw !important;
  max-height: 85vh !important;
  display: flex !important;
  flex-direction: column !important;
}

.body-edit-scroll {
  flex: 1;
  max-height: 58vh;
  margin-top: 10rpx;
  box-sizing: border-box;
}

.form-item {
  height: 96rpx;
  border-bottom: 1rpx solid rgba(241, 245, 249, 0.8);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item .label {
  font-size: 26rpx;
  color: #475569;
  font-weight: 600;
}

.form-item .input {
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  color: #1E293B;
  width: 220rpx;
  padding-right: 10rpx;
}

.form-item .picker-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #10B981;
  background-color: rgba(16, 185, 129, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(16, 185, 129, 0.1);
  display: inline-block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 性别与方向切换胶囊 */
.gender-toggle, .period-direction-toggle {
  background: #F1F5F9;
  border-radius: 20rpx;
  padding: 6rpx;
  gap: 8rpx;
}

.dir-btn {
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  color: #64748B;
  font-weight: 600;
  transition: all 0.2s ease;
}

.dir-btn.active.male {
  background: #3B82F6;
  color: #FFFFFF;
}

.dir-btn.active.female {
  background: #EC4899;
  color: #FFFFFF;
}

.dir-btn.active.lose {
  background: #10B981;
  color: #FFFFFF;
}

.dir-btn.active.gain {
  background: #3B82F6;
  color: #FFFFFF;
}

.btn-confirm-body-data {
  width: 100% !important;
  height: 84rpx !important;
  line-height: 84rpx !important;
  background: linear-gradient(135deg, #10B981, #059669) !important;
  color: #FFFFFF !important;
  font-size: 28rpx !important;
  font-weight: 800 !important;
  border-radius: 42rpx !important;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.3) !important;
  padding: 0 !important;
  border: none !important;
  transition: transform 0.15s ease !important;
}

.btn-confirm-body-data:active {
  transform: scale(0.97) !important;
}

/* 3. 计算结果看板 */
.result-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.85) 0%, rgba(240, 253, 250, 0.85) 100%) !important;
  border: 1rpx solid rgba(16, 185, 129, 0.15) !important;
  border-radius: 32rpx !important;
  box-shadow: 0 12rpx 40rpx rgba(16, 185, 129, 0.03) !important;
  margin-bottom: 40rpx;
}

.result-grid {
  width: 100%;
  margin: 10rpx 0 30rpx 0;
  display: flex;
  justify-content: space-between;
}

.grid-item {
  flex: 1;
  text-align: center;
}

.grid-item .val {
  font-size: 48rpx;
  font-weight: 800;
  color: #1E293B;
}

.grid-item .lbl {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 8rpx;
  font-weight: 600;
}

.target-box {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 24rpx 0 0 0;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: none;
  border-top: 1px solid rgba(16, 185, 129, 0.1);
  margin-top: 10rpx;
}

.target-lbl {
  font-size: 24rpx;
  color: #047857;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.target-val {
  font-size: 46rpx;
  font-weight: 800;
  color: #059669;
  margin: 12rpx 0;
  text-shadow: 0 2rpx 4rpx rgba(5, 150, 105, 0.05);
}

.formula-info {
  font-size: 20rpx;
  color: #059669;
  opacity: 0.8;
  font-weight: 600;
}

/* Premium Primary Button Override */
.btn-primary {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%) !important;
  color: #FFFFFF !important;
  font-weight: 700 !important;
  border-radius: 24rpx !important;
  padding: 24rpx 0rpx !important;
  text-align: center !important;
  font-size: 32rpx !important;
  width: 100% !important;
  box-shadow: 0 10rpx 24rpx rgba(16, 185, 129, 0.25) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.1) !important;
  margin-top: 10rpx !important;
  margin-bottom: 50rpx !important;
  transition: all 0.2s ease;
}

.btn-primary:active {
  opacity: 0.95 !important;
  transform: scale(0.98) !important;
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.2) !important;
}

/* Avatar button and Nickname input styling */
.avatar-wrapper {
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  margin: 0 30rpx 0 0 !important;
  line-height: 1 !important;
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 50% !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}

.avatar-wrapper::after {
  border: none !important;
}

.avatar-wrapper .avatar {
  margin-right: 0 !important;
}

.nickname-row {
  display: flex;
  align-items: center;
}

.nickname-input {
  font-size: 36rpx;
  font-weight: 800;
  color: #1E293B;
  letter-spacing: 0.5rpx;
  width: 220rpx;
  max-width: 220rpx;
  height: auto;
  min-height: auto;
  text-align: left !important;
}

.edit-icon {
  font-size: 22rpx;
  color: #94A3B8;
  margin-left: 10rpx;
  opacity: 0.8;
}

/* Sign in button styling */
.btn-signin {
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 30rpx;
  padding: 0 !important;
  width: 150rpx !important;
  height: 60rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border: none !important;
  margin: 0;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.15);
}

.btn-signin::after {
  border: none !important;
}

.btn-signin[disabled] {
  background: #E2E8F0 !important;
  color: #94A3B8 !important;
  box-shadow: none !important;
}

.btn-signin:not([disabled]) {
  background: linear-gradient(135deg, #10B981, #059669) !important;
  color: #FFFFFF !important;
}

.nutrients-target-row {
  margin-top: 30rpx;
  border-top: 1rpx solid rgba(16, 185, 129, 0.1);
  padding-top: 25rpx;
  width: 100%;
  box-sizing: border-box;
}

.nutrient-target-item {
  width: 33.3%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nutrient-target-item.middle-item {
  border-left: 1rpx solid rgba(0, 0, 0, 0.05);
  border-right: 1rpx solid rgba(0, 0, 0, 0.05);
}

.nutrient-lbl {
  font-size: 20rpx;
  color: #64748B;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.nutrient-val {
  font-size: 30rpx;
  font-weight: 800;
}

.nutrient-val.protein {
  color: #10B981;
}

.nutrient-val.carbs {
  color: #3B82F6;
}

.nutrient-val.fat {
  color: #F59E0B;
}

