<view class="container">
  <block wx:if="{{hasTeam}}">
    <!-- 1. 团队挑战概要卡片 (升级为双轨奖池设计) -->
    <view class="glass-card team-status-card">
      <view class="flex justify-between align-center">
        <view class="team-meta">
          <view class="team-title">{{teamName}}</view>
          <view class="team-desc">对赌挑战进行中 (第{{currentDay}}/{{targetDays}}天)</view>
        </view>
        <view class="dual-pot-wrapper flex">
          <view class="pot-badge daily-pot flex-col align-center flex" catchtap="onViewSettlementHistory">
            <text class="pot-val gold-text">{{dailyPot}}</text>
            <text class="pot-lbl">🔥今日瓜分池</text>
          </view>
          <view class="pot-badge final-pot flex-col align-center flex">
            <text class="pot-val">{{finalPot}}</text>
            <text class="pot-lbl">🏆通关总奖池</text>
          </view>
        </view>
      </view>

      <!-- 待领盲盒发光通知条 -->
      <view class="loot-banner flex justify-between align-center" wx:if="{{pendingLoot}}" catchtap="openLootModal">
        <view class="loot-banner-left flex align-center">
          <text class="loot-icon">🎁</text>
          <text class="loot-text">你有 1 份昨夜自律分红盲盒待开启！</text>
        </view>
        <view class="loot-btn-open">开盲盒 ➔</view>
      </view>

      <view class="invite-section">
        <!-- 上行：邀请码与微信好友邀请按钮 -->
        <view class="invite-top-row flex justify-between align-center">
          <view class="invite-code-lbl flex align-center" catchtap="onCopyInviteCode">
            <text>小队邀请码:</text>
            <text class="code">{{inviteCode}}</text>
            <text class="copy-tag">复制</text>
          </view>
          <button class="btn-share" open-type="share" size="mini">➕ 邀请好友</button>
        </view>

        <!-- 下行：快捷功能栏 (瓜分流水、退出队伍) -->
        <view class="invite-bottom-row flex justify-between align-center">
          <view class="quick-action-link flex align-center" catchtap="onViewSettlementHistory">
            <text class="action-icon">📜</text>
            <text class="action-text">每日瓜分流水</text>
          </view>
          <view class="quick-action-link link-quit flex align-center" catchtap="onQuitTeam">
            <text class="action-icon">🚪</text>
            <text class="action-text">退出当前队伍</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 突击查岗倒计时悬浮条（高优先级预警置顶） -->
    <view class="audit-alert-bar flex justify-between align-center" wx:if="{{pendingAudit}}" catchtap="openAuditResponseModal">
      <view class="audit-left flex align-center flex-1">
        <view class="audit-icon-box flex align-center justify-center">
          <text class="audit-icon">🎯</text>
        </view>
        <view class="audit-info-col flex flex-col flex-1">
          <view class="audit-headline flex align-center">
            <text class="audit-title">突击查岗警报！</text>
            <text class="audit-tag">限时30分</text>
          </view>
          <text class="audit-desc">队友突击查岗，超时未上传扣20分</text>
        </view>
      </view>
      <view class="audit-actions flex align-center">
        <view class="audit-pill-btn btn-deflect flex align-center justify-center" catchtap="onDeflectAudit">
          <text>🪞 反弹</text>
        </view>
        <view class="audit-pill-btn btn-respond flex align-center justify-center" catchtap="onGoUploadForAudit">
          <text>拍照打卡</text>
        </view>
      </view>
    </view>

    <!-- 队友催打卡提醒横幅（醒目气泡条） -->
    <view class="nudge-banner-bar flex justify-between align-center" wx:if="{{pendingNudgeAlert}}">
      <view class="nudge-left flex align-center flex-1">
        <view class="nudge-icon-box flex align-center justify-center">
          <text class="nudge-icon">🔔</text>
        </view>
        <view class="nudge-info-col flex flex-col flex-1">
          <view class="nudge-headline flex align-center">
            <text class="nudge-title">队友喊你打卡啦！</text>
          </view>
          <text class="nudge-desc">{{pendingNudgeAlert}}</text>
        </view>
      </view>
      <view class="nudge-actions flex align-center">
        <view class="nudge-pill-btn flex align-center justify-center" catchtap="onGoUploadForNudge">
          <text>去打卡</text>
        </view>
        <view class="nudge-close-btn flex align-center justify-center" catchtap="onDismissNudgeBanner">✕</view>
      </view>
    </view>

    <!-- 玩法 2/3/4 快捷战术工具栏（置于打卡榜上方，首屏黄金位置） -->
    <view class="gamification-toolbar flex justify-between">
      <view class="toolbar-btn shop-btn flex align-center" catchtap="openShopModal">
        <text class="tool-icon">🛒</text>
        <view class="flex-col">
          <text class="tool-title">战术道具店</text>
          <text class="tool-sub">护盾/补签/查岗</text>
        </view>
      </view>
      <view class="toolbar-btn spy-btn flex align-center" catchtap="openSpyModal">
        <text class="tool-icon">🕵️‍♂️</text>
        <view class="flex-col">
          <text class="tool-title">间谍卧底局</text>
          <text class="tool-sub">{{members.length >= 3 ? (spyInfo.roleName || '查看身份') : '3人解锁'}}</text>
        </view>
      </view>
      <view class="toolbar-btn roast-btn flex align-center" catchtap="openRoastModal">
        <text class="tool-icon">🤖</text>
        <view class="flex-col">
          <text class="tool-title">AI 毒舌战报</text>
          <text class="tool-sub">每日MVP与通报</text>
        </view>
      </view>
    </view>

    <!-- 2. 小队打卡排行榜 -->
    <view class="leaderboard-section">
      <view class="section-title flex justify-between align-center">
        <view class="flex align-center">
          <text>小队打卡榜</text>
          <text class="section-sub" style="margin-left: 12rpx;">每日24:00结算</text>
        </view>
        <view class="quick-poster-btn flex align-center" catchtap="onGeneratePoster">
          <text style="margin-right: 6rpx;">📸</text>
          <text>打卡海报</text>
        </view>
      </view>
      <view class="glass-card member-card flex align-center justify-between" wx:for="{{members}}" wx:key="id">
        <view class="member-left flex align-center">
          <view class="rank-num {{index === 0 ? 'top-rank' : ''}}">
            <text wx:if="{{index === 0}}">👑</text>
            <text wx:else>{{index + 1}}</text>
          </view>
          <image class="avatar" src="{{item.avatar}}" mode="aspectFill" binderror="onAvatarError" data-index="{{index}}" />
          <view class="member-meta flex-col flex">
            <text class="member-name">{{item.name}}</text>
            <scroll-view class="progress-ticks-scroll" scroll-x enable-flex>
              <view class="progress-ticks flex">
                <view class="tick {{tick.checked ? 'checked' : ''}}" wx:for="{{item.ticks}}" wx:for-item="tick" wx:key="day">
                  {{tick.checked ? '✓' : ''}}
                </view>
              </view>
            </scroll-view>
          </view>
        </view>
        <view class="member-right flex-col align-center flex">
          <text class="status-text {{item.todayChecked ? 'checked-in' : 'pending'}}">
            {{item.todayChecked ? '今日已达标' : '今日未达标'}}
          </text>
          <text class="success-days">已连续达标 {{item.successCount}} 天</text>
          <block wx:if="{{!item.todayChecked && item.userId !== userId}}">
            <view class="nudge-btn nudged flex align-center justify-center" wx:if="{{item.hasNudged}}">
              <text style="font-size: 20rpx; font-weight: 700; color: #94A3B8;">✓ 已提醒</text>
            </view>
            <view class="nudge-btn flex align-center justify-center" 
                  wx:else
                  catchtap="onNudgeTeammate" 
                  data-user-id="{{item.userId}}" 
                  data-name="{{item.name}}">
              <text style="font-size: 20rpx; font-weight: 700; color: #F59E0B;">🔔 催TA打卡</text>
            </view>
          </block>
        </view>
      </view>
    </view>



    <!-- 玩法 1：自律分红盲盒轮盘抽奖全屏弹窗 -->
    <view class="modal-backdrop loot-modal-backdrop {{showLootModal ? 'active' : ''}}" catchtouchmove="preventBubble">
      <view class="loot-dialog-box flex flex-col align-center" catchtap="preventBubble">
        <!-- 弹窗顶栏：标题、副标题与关闭按钮 -->
        <view class="loot-dialog-header flex justify-between align-start">
          <view class="loot-title-group flex flex-col flex-1">
            <text class="loot-gold-title">🏆 昨夜自律分红盲盒</text>
            <text class="loot-gold-sub">恭喜昨日按时达标 · 快转动轮盘抽取暴击分红！</text>
          </view>
          <view class="loot-header-close flex align-center justify-center" catchtap="closeLootModal" wx:if="{{!isSpinning}}">
            <text>✕</text>
          </view>
        </view>

        <!-- 轮盘主体 -->
        <view class="wheel-outer-wrapper">
          <view class="wheel-circle {{isSpinning ? 'spinning' : ''}}" style="transform: rotate({{wheelAngle}}deg);">
            <view class="wheel-slice slice-1"><text class="slice-text gray">🍃 谢谢惠顾</text></view>
            <view class="wheel-slice slice-2"><text class="slice-text gold">1.5x 暴击</text></view>
            <view class="wheel-slice slice-3"><text class="slice-text orange">2.0x 护盾</text></view>
            <view class="wheel-slice slice-4"><text class="slice-text cyan">💉 补签卡</text></view>
            <view class="wheel-slice slice-5"><text class="slice-text purple">👑 5x 传奇</text></view>
            <view class="wheel-slice slice-6"><text class="slice-text green">1.0x 达标</text></view>
          </view>
          <view class="wheel-pointer">▼</view>
          <view class="wheel-center-btn flex align-center justify-center" catchtap="onSpinLootWheel" wx:if="{{!lootClaimResult}}">
            <text class="spin-text">{{isSpinning ? '抽取中' : 'GO!'}}</text>
          </view>
        </view>

        <!-- 开奖结果呈现 -->
        <view class="loot-result-card flex-col align-center" wx:if="{{lootClaimResult}}">
          <block wx:if="{{lootClaimResult.multiplier === 0}}">
            <text class="result-highlight thanks-color">🍃 谢谢惠顾，再接再厉！</text>
            <text class="result-thanks-tip">今日运气稍逊一筹，坚持自律明日必有大暴击！</text>
            <button class="btn-confirm-reward btn-thanks-confirm" catchtap="onConfirmLootReward">明日再战</button>
          </block>
          <block wx:else>
            <text class="result-highlight">🎉 恭喜斩获 {{lootClaimResult.multiplier}} 倍暴击！</text>
            <view class="result-points-box flex align-center">
              <text class="points-plus">+{{lootClaimResult.finalPoints}}</text>
              <text class="points-unit">积分入账</text>
            </view>
            <view class="item-reward-tag" wx:if="{{lootClaimResult.itemReward && lootClaimResult.itemReward !== 'NONE'}}">
              <text wx:if="{{lootClaimResult.itemReward === 'SHIELD_FRAGMENT'}}">🛡️ 获得【欺骗餐护盾碎片 × 1】</text>
              <text wx:elif="{{lootClaimResult.itemReward === 'SERUM_CARD'}}">💉 获得【血清补签卡 × 1】</text>
              <text wx:elif="{{lootClaimResult.itemReward === 'AVATAR_FRAME'}}">👑 解锁【全站金色自律头像框】</text>
            </view>
            <button class="btn-confirm-reward" catchtap="onConfirmLootReward">开心收下</button>
          </block>
        </view>

        <!-- 底部稍后开启操作位：居中优雅胶囊 -->
        <view class="loot-dialog-footer flex align-center justify-center" wx:if="{{!lootClaimResult && !isSpinning}}">
          <view class="loot-close-pill flex align-center justify-center" catchtap="closeLootModal">
            <text>稍后开启</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 每日瓜分流水弹窗 -->
    <view class="modal-backdrop {{showHistoryModal ? 'active' : ''}}" catchtap="onCloseHistoryModal" catchtouchmove="preventBubble">
      <view class="modal-dialog history-dialog" catchtap="preventBubble">
        <view class="modal-header">
          <text class="modal-title">📜 小队每日瓜分战报</text>
          <text class="modal-close" catchtap="onCloseHistoryModal">✕</text>
        </view>
        <scroll-view class="history-list-scroll" scroll-y>
          <view class="history-item glass-card" wx:for="{{settlementHistory}}" wx:key="id">
            <view class="history-meta flex justify-between align-center">
              <text class="history-date">📅 {{item.settlementDate}} 战况</text>
              <text class="history-pool gold-text">罚金池 {{item.penaltyPool}} 积分</text>
            </view>
            <view class="history-stats flex justify-between align-center">
              <text class="stat-green">✅ {{item.successMembers}} 人达标</text>
              <text class="stat-red">❌ {{item.failedMembers}} 人违约</text>
              <text class="stat-reward">每人均分 +{{item.perPersonReward}} 分</text>
            </view>
            <view class="history-summary" wx:if="{{item.summaryText}}">{{item.summaryText}}</view>
          </view>
          <view class="history-empty" wx:if="{{!settlementHistory || settlementHistory.length === 0}}">
            <text>暂无历史结算，首日结算将在今晚 24:00 自动开启！</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- Off-screen Canvas for Poster Generation -->
    <canvas type="2d" id="posterCanvas" style="width: 375px; height: 500px; position: fixed; left: -9999px; top: -9999px;" width="750" height="1000"></canvas>
  </block>

  <block wx:else>
    <!-- 无小队时的欢迎与指引 -->
    <view class="welcome-header flex-col align-center">
      <text class="emoji-logo">🏆</text>
      <text class="welcome-title">咔嚓算卡·5人对赌挑战</text>
      <text class="welcome-subtitle">自律太难？拉上好友建立契约，每日卡路里打卡挑战，输者罚分，赢者分池！</text>
    </view>

    <!-- 加入队伍卡片 -->
    <view class="glass-card action-card">
      <view class="card-title">🔑 输入邀请码加入队伍</view>
      <view class="input-group flex">
        <input class="invite-input" placeholder="输入6位邀请码" value="{{inputInviteCode}}" bindinput="onInviteCodeInput" maxlength="6" />
        <button class="btn-join" catchtap="onJoinTeamByCode">立即加入</button>
      </view>
    </view>

    <!-- 创建队伍卡片 -->
    <view class="glass-card action-card">
      <view class="card-title">🆕 创建我的打卡队伍</view>
      <view class="form-item">
        <text class="form-label">队伍名称</text>
        <input class="form-input" placeholder="例如：7天减脂冲刺组" value="{{createTeamName}}" bindinput="onTeamNameInput" maxlength="15" />
      </view>
      <view class="form-item" catchtap="showTargetDaysModal">
        <text class="form-label">挑战周期</text>
        <view class="picker-value flex justify-between align-center">
          <text>{{targetDaysOptions[targetDaysIndex]}} 天挑战</text>
          <text class="arrow">▼</text>
        </view>
      </view>
      <button class="btn-create" catchtap="onCreateNewTeam">创建新队伍</button>
    </view>
  </block>

  <!-- 挑战周期居中弹窗 -->
  <view class="modal-backdrop {{showTargetDaysSheet ? 'active' : ''}}" catchtap="hideTargetDaysModal" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">选择挑战周期</text>
        <text class="modal-close" catchtap="hideTargetDaysModal">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y>
        <view class="modal-option theme-indigo {{targetDaysIndex === index ? 'active' : ''}}" 
              wx:for="{{targetDaysOptions}}" wx:key="*this" 
              catchtap="selectTargetDays" data-index="{{index}}">
          <text class="modal-option-label">{{item}} 天挑战</text>
          <icon type="success_no_circle" size="14" color="#6366F1" wx:if="{{targetDaysIndex === index}}" />
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 分享海报弹窗 -->
  <view class="modal-backdrop {{showSharePosterModal ? 'active' : ''}}" catchtap="hideSharePosterModal" catchtouchmove="preventBubble">
    <view class="modal-dialog poster-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">分享打卡海报</text>
        <text class="modal-close" catchtap="hideSharePosterModal">✕</text>
      </view>
      
      <!-- 海报样式切换 -->
      <view class="poster-tabs">
        <view class="poster-tab {{activeTemplate === 'morandi' ? 'active' : ''}}" catchtap="switchTemplate" data-template="morandi">🌿 莫兰迪极简</view>
        <view class="poster-tab {{activeTemplate === 'vogue' ? 'active' : ''}}" catchtap="switchTemplate" data-template="vogue">📸 杂志封面</view>
        <view class="poster-tab {{activeTemplate === 'receipt' ? 'active' : ''}}" catchtap="switchTemplate" data-template="receipt">🧾 热量账单</view>
      </view>

      <view class="poster-preview-container">
        <image class="poster-preview-img" src="{{tempPosterPath}}" mode="aspectFit" />
      </view>
      <view class="poster-action-buttons">
        <view class="btn-action-save" catchtap="onSavePosterClick">💾 保存海报到相册</view>
        <button class="btn-action-friend" open-type="share">✉️ 发送给微信好友</button>
        <view class="btn-action-share" catchtap="onSharePosterClick">📸 发微信朋友圈 / 图文分享</view>
      </view>
    </view>
  </view>

  <!-- 玩法 3：战术道具店抽屉模态框 -->
  <view class="modal-backdrop {{showShopModal ? 'active' : ''}}" catchtap="closeShopModal" catchtouchmove="preventBubble">
    <view class="modal-dialog shop-dialog" catchtap="preventBubble">
      <view class="modal-header flex justify-between align-center">
        <view class="flex align-center">
          <text class="modal-title-emoji">🛒</text>
          <text class="modal-title">对赌战术道具店</text>
        </view>
        <view class="flex align-center">
          <view class="shop-balance-pill flex align-center">
            <text class="balance-label">可用</text>
            <text class="balance-num">{{userPoints !== undefined ? userPoints : 0}}</text>
            <text class="balance-coin">🪙</text>
          </view>
          <text class="modal-close" catchtap="closeShopModal">✕</text>
        </view>
      </view>
      <scroll-view class="shop-list-scroll" scroll-y enable-passive>
        <view class="shop-item-card flex align-center" wx:for="{{shopItems}}" wx:key="itemType">
          <!-- 道具图标：现代微弧方圆徽章 -->
          <view class="item-avatar-box flex align-center justify-center icon-bg-{{item.itemType}}">
            <text class="item-emoji">{{item.icon}}</text>
          </view>

          <!-- 道具信息主体：标题与饱满功能描述 -->
          <view class="item-main-content flex-col flex-1">
            <view class="item-header-line flex align-center">
              <text class="item-clean-name">{{item.name}}</text>
              <text class="item-owned-pill" wx:if="{{item.owned > 0}}">拥有 {{item.owned}}</text>
            </view>
            <text class="item-clean-desc">{{item.desc}}</text>
          </view>

          <!-- 右侧购买决策单元：上方价格 + 下方操作胶囊（支持重复购买与立即使用） -->
          <view class="item-action-wrapper flex-col align-end justify-center">
            <view class="item-price-row flex align-center">
              <text class="price-num">{{item.price}}</text>
              <text class="price-unit">积分</text>
            </view>

            <!-- 场景 A：拥有该道具 -> 均提供【购买】与【使用】横向双精巧微胶囊 -->
            <view class="item-btn-row flex align-center" wx:if="{{item.owned > 0}}">
              <view class="btn-action-pill btn-buy-addon flex align-center justify-center" 
                    catchtap="onBuyItem" data-item-type="{{item.itemType}}">
                <text class="btn-text">购买</text>
              </view>
              <view class="btn-action-pill btn-use-primary flex align-center justify-center" 
                    catchtap="onUseItem" data-item-type="{{item.itemType}}">
                <text class="btn-text btn-text-white">使用</text>
              </view>
            </view>

            <!-- 场景 B：未拥有 -> 单胶囊【兑换】 -->
            <view class="btn-action-pill btn-buy-primary flex align-center justify-center" 
                  wx:else 
                  catchtap="onBuyItem" data-item-type="{{item.itemType}}">
              <text class="btn-text">兑换</text>
            </view>
          </view>
        </view>
        <view class="shop-scroll-bottom-spacer"></view>
      </scroll-view>
    </view>
  </view>

  <!-- 玩法 2：减脂卧底间谍局模态框 -->
  <view class="modal-backdrop {{showSpyModal ? 'active' : ''}}" catchtap="closeSpyModal" catchtouchmove="preventBubble">
    <view class="modal-dialog spy-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">🕵️‍♂️ 减脂卧底·间谍局</text>
        <text class="modal-close" catchtap="closeSpyModal">✕</text>
      </view>
      <!-- 1. 人数未满 3 人：未解锁引导提示卡片 -->
      <view class="spy-locked-box flex flex-col align-center" wx:if="{{!spyInfo.enabled}}">
        <view class="spy-locked-avatar-wrap flex align-center justify-center">
          <text class="spy-locked-avatar">🕵️‍♂️</text>
          <view class="spy-locked-badge">🔒</view>
        </view>
        <text class="spy-locked-headline">间谍卧底局未解锁</text>
        
        <!-- 人数状态胶囊 -->
        <view class="spy-need-pill flex align-center justify-center">
          <text class="need-curr">当前队伍 {{spyInfo.totalMembers || members.length || 1}} 人</text>
          <text class="need-sep">·</text>
          <text class="need-target">还差 {{3 - (spyInfo.totalMembers || members.length || 1)}} 人开局</text>
        </view>

        <!-- 趣味玩法规则速递 -->
        <view class="spy-locked-card flex flex-col">
          <view class="rule-item flex align-start">
            <view class="rule-icon-box flex align-center justify-center">
              <text class="rule-icon">🎲</text>
            </view>
            <view class="rule-info-col flex flex-col">
              <view class="rule-title-row">
                <text class="rule-title">满 3 人系统随机指定卧底</text>
              </view>
              <text class="rule-desc">凑齐 3 名队员自动开局，系统将在所有队员中秘密指定 1 名潜伏捣蛋鬼。</text>
            </view>
          </view>
          <view class="rule-item flex align-start">
            <view class="rule-icon-box flex align-center justify-center">
              <text class="rule-icon">😈</text>
            </view>
            <view class="rule-info-col flex flex-col">
              <view class="rule-title-row">
                <text class="rule-title">卧底匿名投毒诱惑</text>
              </view>
              <text class="rule-desc">卧底每天可匿名向小队广播美食诱惑，暗中引诱大家破防吃超标！</text>
            </view>
          </view>
          <view class="rule-item flex align-start">
            <view class="rule-icon-box flex align-center justify-center">
              <text class="rule-icon">🏆</text>
            </view>
            <view class="rule-info-col flex flex-col">
              <view class="rule-title-row">
                <text class="rule-title">周末公投瓜分奖池</text>
              </view>
              <text class="rule-desc">周日全员投票抓卧底：指认成功平分双倍奖池；若卧底成功潜伏则独吞大奖！</text>
            </view>
          </view>
        </view>

        <!-- 邀请好友按钮组 -->
        <view class="spy-locked-footer flex flex-col align-center">
          <button class="btn-spy-invite flex align-center justify-center" open-type="share">
            <text class="invite-btn-text">➕ 邀请微信好友 (差 {{3 - (spyInfo.totalMembers || members.length || 1)}} 人开局) 🚀</text>
          </button>
          <view class="spy-copy-pill flex align-center justify-center" catchtap="onCopyInviteCode">
            <text>复制小队邀请码: {{inviteCode || '获取中...'}} 📋</text>
          </view>
        </view>
      </view>

      <!-- 2. 人数已达标 (>= 3 人)：进入正常卧底局 -->
      <view class="spy-content-box flex-col align-center" wx:else>
        <view class="spy-identity-card flex-col align-center">
          <text class="spy-role-title">{{spyInfo.roleName}}</text>
          <text class="spy-role-tip">{{spyInfo.roleTip}}</text>
        </view>


        <!-- 卧底专属：发挑衅操作 -->
        <view class="spy-action-section flex-col" wx:if="{{spyInfo.isSpy}}">
          <text class="section-hint">作为卧底，你今天可以匿名投毒诱惑队友（午餐/晚餐各限1次）：</text>
          <block wx:if="{{spyInfo.canPostTaunt !== false}}">
            <input class="taunt-input" placeholder="输入{{spyInfo.currentPeriodName || '当前时段'}}诱惑台词(如:炸鸡奶茶走起?)" value="{{inputSpyTaunt}}" bindinput="onSpyTauntInput" maxlength="35" />
            <button class="btn-send-taunt" catchtap="onSendSpyTaunt">🔥 发送【{{spyInfo.currentPeriodName || '本时段'}}】诱惑广播</button>
          </block>
          <view class="taunt-posted-tip flex align-center justify-center" wx:else>
            <text>⏳ {{spyInfo.currentPeriodName || '当前时段'}}已发布挑衅广播，下个时段再来投毒！</text>
          </view>
        </view>

        <!-- 平民专属：投票抓卧底 -->
        <view class="spy-vote-section" wx:if="{{!spyInfo.hasVoted}}">
          <text class="section-hint">指认潜伏的捣蛋鬼（选择怀疑的队友）：</text>
          <view class="vote-candidates flex justify-between">
            <view class="candidate-btn {{selectedSuspectId === item.userId ? 'selected' : ''}}" 
                  wx:for="{{members}}" wx:key="id" 
                  wx:if="{{item.userId !== userId}}" 
                  catchtap="selectSuspect" data-id="{{item.userId}}">
              <text>{{item.name}}</text>
            </view>
          </view>
          <button class="btn-cast-vote" catchtap="onCastSpyVote" disabled="{{!selectedSuspectId}}">🗳️ 投票指认TA</button>
        </view>
        <view class="spy-voted-tip" wx:else>
          <text>✅ 你今天已完成指认投票！已累计 {{spyInfo.voteCount}} 人参与公投！</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 玩法 4：AI 每日毒舌战报模态框 -->
  <!-- 玩法 4：AI 每日毒舌战报模态框 -->
  <view class="modal-backdrop {{showRoastModal ? 'active' : ''}}" catchtap="closeRoastModal" catchtouchmove="preventBubble">
    <view class="modal-dialog roast-dialog" catchtap="preventBubble">
      <view class="modal-header flex justify-between align-center">
        <text class="modal-title">🌶️ AI 毒舌私教每日审判</text>
        <text class="modal-close" catchtap="closeRoastModal">✕</text>
      </view>
      <view class="roast-card-wrapper flex-col" wx:if="{{todayRoast}}">
        <text class="roast-main-title">{{todayRoast.title}}</text>
        
        <!-- 审判对决双徽章：杜绝换行，单行溢出省略 -->
        <view class="roast-badges flex justify-between">
          <view class="roast-badge mvp-badge flex align-center">
            <text class="badge-icon">👑</text>
            <text class="badge-role">控卡战神:</text>
            <text class="badge-name">{{todayRoast.mvpName || '虚位以待'}}</text>
          </view>
          <view class="roast-badge slacker-badge flex align-center">
            <text class="badge-icon">🚨</text>
            <text class="badge-role">偷吃现形:</text>
            <text class="badge-name">{{todayRoast.slackerName || '全员稳健'}}</text>
          </view>
        </view>

        <!-- 毒舌正文 -->
        <view class="roast-content-text">{{todayRoast.content}}</view>
        
        <!-- 毒舌扎心一击金句框 -->
        <view class="roast-quote-box flex align-start">
          <text class="punchline-chili">🌶️</text>
          <view class="flex-col flex-1">
            <text class="punchline-tag">毒舌扎心一击</text>
            <text class="roast-quote">“{{todayRoast.quote}}”</text>
          </view>
        </view>

        <!-- 微信群公开处刑转发按钮 -->
        <button class="btn-share-roast" open-type="share">📢 发到微信群公开处刑</button>
      </view>
    </view>
  </view>

  <!-- 悬浮灵动卧底广播胶囊 (形态 A：吸附右侧，发布时弹入 + 动态微光呼吸) -->
  <view class="spy-floating-container" wx:if="{{spyInfo && spyInfo.todayTaunt}}">
    <!-- 展开的详细挑衅气泡卡片 -->
    <view class="spy-bubble-card {{showSpyTauntBubble ? 'show' : ''}}">
      <view class="bubble-header flex justify-between align-center">
        <view class="flex align-center" style="gap: 8rpx;">
          <text class="bubble-title-icon">🕵️</text>
          <text class="bubble-title">卧底·{{spyInfo.tauntPeriodName || '今日挑衅'}}广播</text>
        </view>
        <view class="bubble-close-btn" catchtap="onCloseSpyTauntBubble">✕</view>
      </view>
      
      <view class="bubble-body">
        <text class="bubble-quote-text">“{{spyInfo.todayTaunt}}”</text>
      </view>

      <view class="bubble-footer flex justify-between align-center">
        <text class="bubble-hint">来自潜伏队友的匿名投毒</text>
        <view class="bubble-vote-btn flex align-center" catchtap="onQuickGoVoteFromTaunt">
          <text>🗳️ 抓TA投票 ></text>
        </view>
      </view>
      <!-- 气泡指示三角小箭头 -->
      <view class="bubble-arrow"></view>
    </view>

    <!-- 灵动悬浮胶囊按钮 (发微光动效) -->
    <view class="spy-floating-capsule flex align-center {{hasReadTaunt ? 'calm' : 'glow-breathing'}}" 
          catchtap="onToggleSpyTauntBubble">
      <view class="capsule-icon-wrap">
        <text class="capsule-icon">🕵️</text>
        <view class="capsule-badge-dot" wx:if="{{!hasReadTaunt}}"></view>
      </view>
      <view class="capsule-text-col flex-col">
        <text class="capsule-main-text">卧底挑衅</text>
        <text class="capsule-sub-text">{{hasReadTaunt ? '点击查看' : '有新诱惑!'}}</text>
      </view>
    </view>
  </view>
</view>

