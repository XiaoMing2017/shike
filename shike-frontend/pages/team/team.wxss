/* 分享海报弹窗特有样式 */
.poster-dialog {
  width: 660rpx !important;
  max-width: 90%;
  padding: 30rpx 40rpx 40rpx 40rpx !important;
}

.poster-preview-container {
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgba(248, 250, 252, 0.4);
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.5);
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.poster-preview-img {
  width: 320rpx;
  height: 426rpx;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 25rpx rgba(0, 0, 0, 0.12);
  background-color: #F8FAFC;
}

.poster-tabs {
  display: flex;
  background: rgba(15, 23, 42, 0.05);
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  gap: 6rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.02);
}

.poster-tab {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
  color: #64748B;
  padding: 14rpx 0;
  border-radius: 16rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.poster-tab.active {
  background: #FFFFFF;
  color: #4F46E5;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.poster-action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}

.btn-action-save, .btn-action-share, .btn-action-friend {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 20rpx;
  transition: all 0.2s ease;
  box-sizing: border-box;
  padding: 0 !important;
  margin: 0 !important;
  width: 100% !important;
}

.btn-action-save {
  background: rgba(255, 255, 255, 0.85);
  color: #4F46E5;
  border: 1rpx solid rgba(99, 102, 241, 0.25);
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.05);
}

.btn-action-save:active {
  background: rgba(255, 255, 255, 0.95);
  transform: scale(0.98);
}

.btn-action-friend {
  background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
  color: #FFFFFF;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(99, 102, 241, 0.2);
}

.btn-action-friend:active {
  opacity: 0.95;
  transform: scale(0.98);
}

.btn-action-share {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.2);
}

.btn-action-share:active {
  opacity: 0.95;
  transform: scale(0.98);
}

.nudge-btn {
  margin-top: 8rpx;
  padding: 6rpx 16rpx;
  background: rgba(245, 158, 11, 0.12);
  border: 1rpx solid rgba(245, 158, 11, 0.4);
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.nudge-btn:active {
  transform: scale(0.95);
  background: rgba(245, 158, 11, 0.25);
}

/* =========================================================================
   玩法 1：双轨奖池、待领盲盒发光条与轮盘抽奖样式
   ========================================================================= */

.dual-pot-wrapper {
  gap: 12rpx;
}

.pot-badge.daily-pot {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.25) 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.5);
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.15);
}

.pot-badge.final-pot {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.12) 0%, rgba(79, 70, 229, 0.2) 100%);
  border: 1rpx solid rgba(99, 102, 241, 0.4);
}

.gold-text {
  color: #D97706 !important;
  font-weight: 900;
}

.history-link {
  font-size: 22rpx;
  color: #6366F1;
  font-weight: 600;
  margin-right: 16rpx;
  text-decoration: underline;
}

/* 待领盲盒发光横幅 */
.loot-banner {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(90deg, #FEF3C7 0%, #FDE68A 100%);
  border: 1rpx solid #F59E0B;
  border-radius: 16rpx;
  animation: pulseGlow 2s infinite ease-in-out;
}

@keyframes pulseGlow {
  0%, 100% { box-shadow: 0 0 10rpx rgba(245, 158, 11, 0.3); }
  50% { box-shadow: 0 0 24rpx rgba(245, 158, 11, 0.7); }
}

.loot-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.loot-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #92400E;
}

.loot-btn-open {
  padding: 6rpx 16rpx;
  background: #D97706;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 20rpx;
}

/* 盲盒轮盘抽奖弹窗：顶级黑金游戏化开奖质感 */
.loot-modal-backdrop {
  z-index: 1000;
}

.loot-dialog-box {
  width: 660rpx;
  background: linear-gradient(180deg, #1E1B4B 0%, #0F172A 100%);
  border: 2rpx solid rgba(245, 158, 11, 0.5);
  border-radius: 36rpx;
  padding: 36rpx 28rpx 32rpx;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.7);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loot-dialog-header {
  width: 100%;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
}

.loot-title-group {
  min-width: 0;
}

.loot-gold-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #FBBF24;
  text-shadow: 0 2rpx 10rpx rgba(251, 191, 36, 0.4);
  line-height: 1.3;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.loot-gold-sub {
  display: block;
  font-size: 21rpx;
  color: #94A3B8;
  line-height: 1.4;
}

.loot-header-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.08);
  margin-left: 16rpx;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.loot-header-close text {
  font-size: 30rpx;
  color: #94A3B8;
  line-height: 1;
}

.loot-header-close:active {
  background: rgba(255, 255, 255, 0.18);
}

/* 轮盘主体：绝对居中 */
.wheel-outer-wrapper {
  position: relative;
  width: 450rpx;
  height: 450rpx;
  margin: 16rpx auto 26rpx;
  align-self: center;
  box-sizing: border-box;
}

.wheel-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  background: #312E81;
  border: 8rpx solid #F59E0B;
  box-sizing: border-box;
  box-shadow: 0 0 36rpx rgba(245, 158, 11, 0.45);
  transition: transform 2.2s cubic-bezier(0.15, 0.9, 0.3, 1);
}

.wheel-slice {
  position: absolute;
  width: 50%;
  height: 50%;
  transform-origin: 100% 100%;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid rgba(255, 255, 255, 0.12);
}

.slice-1 { transform: rotate(0deg) skew(30deg); background: #2A2474; }
.slice-2 { transform: rotate(60deg) skew(30deg); background: #4338CA; }
.slice-3 { transform: rotate(120deg) skew(30deg); background: #4F46E5; }
.slice-4 { transform: rotate(180deg) skew(30deg); background: #3730A3; }
.slice-5 { transform: rotate(240deg) skew(30deg); background: #5B21B6; }
.slice-6 { transform: rotate(300deg) skew(30deg); background: #3B2E96; }

.slice-text {
  font-size: 19rpx;
  font-weight: 800;
  color: #FFFFFF;
  transform: skew(-30deg) rotate(-30deg);
  margin-top: 32rpx;
  margin-left: 20rpx;
  white-space: nowrap;
}

.slice-text.gray { color: #E2E8F0; opacity: 0.9; }
.slice-text.gold { color: #FBBF24; }
.slice-text.orange { color: #F97316; }
.slice-text.cyan { color: #38BDF8; }
.slice-text.purple { color: #E879F9; }
.slice-text.green { color: #34D399; }

.wheel-pointer {
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  color: #EF4444;
  z-index: 10;
  filter: drop-shadow(0 2rpx 8rpx rgba(0, 0, 0, 0.7));
}

