  width: 114rpx;
  height: 114rpx;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.45);
  z-index: 5;
  transition: transform 0.15s ease;
}

