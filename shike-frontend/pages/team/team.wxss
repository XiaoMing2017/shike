  color: #059669;
  font-weight: 700;
  padding: 16rpx;
  background: #D1FAE5;
  border-radius: 16rpx;
  width: 100%;
  text-align: center;
}

/* AI 毒舌战报弹窗：潮流辛辣对赌战报风 */
.roast-dialog {
  width: 686rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  overflow: hidden;
}

.roast-card-wrapper {
  background: linear-gradient(160deg, #FFFBEB 0%, #FEF2F2 60%, #FFF1F2 100%);
  border: 1.5rpx solid #FECDD3;
  border-radius: 28rpx;
  padding: 30rpx 26rpx;
  box-shadow: 0 10rpx 26rpx rgba(244, 63, 94, 0.08);
}

.roast-main-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #9F1239;
  line-height: 1.4;
  margin-bottom: 22rpx;
}

.roast-badges {
  margin-bottom: 22rpx;
  gap: 12rpx;
}

.roast-badge {
  flex: 1;
  padding: 10rpx 14rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  min-width: 0;
  white-space: nowrap;
}

.badge-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.badge-role {
  font-size: 20rpx;
  font-weight: 800;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.badge-name {
  font-size: 20rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mvp-badge { 
  background: #DCFCE7; 
  color: #15803D; 
  border: 1rpx solid #86EFAC;
}

.slacker-badge { 
  background: #FFE4E6; 
  color: #BE123C; 
  border: 1rpx solid #FDA4AF;
}

.roast-content-text {
  font-size: 24rpx;
  color: #4C0519;
  line-height: 1.68;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  padding: 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(244, 63, 94, 0.15);
}

/* 毒舌扎心一击金句框 */
.roast-quote-box {
  background: linear-gradient(135deg, #FFF1F2 0%, #FFE4E6 100%);
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  margin-bottom: 26rpx;
  border: 1.5rpx solid #FDA4AF;
  border-left: 8rpx solid #E11D48;
}

.punchline-chili {
  font-size: 32rpx;
  margin-right: 12rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
}

.punchline-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #BE123C;
  margin-bottom: 4rpx;
}

.roast-quote {
  font-size: 22rpx;
  font-weight: 800;
  color: #881337;
  line-height: 1.4;
  font-style: italic;
}

.btn-share-roast {
  background: linear-gradient(135deg, #E11D48 0%, #BE123C 100%);
  color: #FFFFFF !important;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 38rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(225, 29, 72, 0.35);
  border: none;
  letter-spacing: 0.5rpx;
}

.btn-share-roast:active {
  transform: scale(0.96);
  opacity: 0.9;
}

