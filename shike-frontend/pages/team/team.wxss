.container {
  padding: 30rpx 30rpx calc(220rpx + env(safe-area-inset-bottom)) 30rpx;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #F3F6F8 0%, #EBF4F6 100%);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 1. 团队挑战概要卡片 */
.team-status-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(245, 243, 255, 0.9) 100%);
  border: 1rpx solid rgba(99, 102, 241, 0.15);
}

.team-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
}

.team-desc {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 6rpx;
}

.pot-badge {
  background-color: #6366F1;
  color: #FFFFFF;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  min-width: 100rpx;
}

.pot-val {
  font-size: 36rpx;
  font-weight: 800;
}

.pot-lbl {
  font-size: 16rpx;
  opacity: 0.8;
  margin-top: 2rpx;
}

.invite-section {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.invite-top-row {
  width: 100%;
}

.invite-code-lbl {
  font-size: 24rpx;
  color: #475569;
  white-space: nowrap;
}

.invite-code-lbl .code {
  font-weight: 800;
  color: #4F46E5;
  background-color: #EEF2FF;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
  letter-spacing: 1rpx;
}

.copy-tag {
  font-size: 20rpx;
  color: #6366F1;
  background: rgba(99, 102, 241, 0.1);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  font-weight: 600;
}

.btn-share {
  background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%) !important;
  color: #FFFFFF !important;
  font-size: 22rpx !important;
  border-radius: 30rpx !important;
  padding: 10rpx 24rpx !important;
  margin: 0 !important;
  border: none !important;
  font-weight: 700 !important;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.25) !important;
  white-space: nowrap !important;
}

.invite-bottom-row {
  width: 100%;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(99, 102, 241, 0.15);
}

.quick-action-link {
  font-size: 22rpx;
  color: #4F46E5;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(99, 102, 241, 0.05);
  white-space: nowrap;
  transition: all 0.2s ease;
}

.quick-action-link:active {
  opacity: 0.7;
  transform: scale(0.97);
}

.quick-action-link.link-quit {
  color: #EF4444;
  background: rgba(239, 68, 68, 0.06);
}

.quick-action-link .action-icon {
  margin-right: 6rpx;
}

/* 2. 小队打卡榜 */
.leaderboard-section {
  margin-top: 10rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 20rpx;
}

.member-card {
  /* Inherits glass-card, removed solid white background override */
}

.rank-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #94A3B8;
  width: 40rpx;
  text-align: center;
  margin-right: 16rpx;
}

.rank-num.top-rank {
  font-size: 34rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid #F1F5F9;
  margin-right: 20rpx;
}

.member-left {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  overflow: hidden;
}

.member-meta {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.member-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.progress-ticks-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 10rpx;
}

.progress-ticks {
  display: inline-flex;
  align-items: center;
}

.tick {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  border-radius: 6rpx;
  border: 1rpx solid #CBD5E1;
  margin-right: 6rpx;
  font-size: 18rpx;
  color: #94A3B8;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  background-color: #F8FAFC;
  box-sizing: border-box;
}

.tick.checked {
  background-color: #E6FDF4;
  border-color: #10B981;
  color: #10B981;
  font-weight: 800;
}

.member-right {
  min-width: 140rpx;
  margin-top: -10rpx;
}

.status-text {
  font-size: 24rpx;
  font-weight: 700;
}

.status-text.checked-in {
  color: #10B981;
}

.status-text.pending {
  color: #EF4444;
}

.success-days {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 8rpx;
}

.footer-actions {
  margin-top: 40rpx;
  gap: 16rpx;
}

.btn-action {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 24rpx;
  font-weight: 700;
  font-size: 26rpx;
  border: none;
  padding: 0 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.btn-secondary {
  background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
  color: #FFFFFF;
  box-shadow: 0 10rpx 20rpx rgba(99, 102, 241, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.btn-secondary:active {
  opacity: 0.95;
  transform: scale(0.97);
  box-shadow: 0 6rpx 12rpx rgba(99, 102, 241, 0.15);
}

.btn-quit {
  background: rgba(254, 242, 242, 0.65);
  color: #EF4444;
  border: 1rpx solid rgba(239, 68, 68, 0.25);
  box-shadow: 0 8rpx 20rpx rgba(239, 68, 68, 0.03);
}

.btn-quit:active {
  background: rgba(254, 242, 242, 0.95);
  transform: scale(0.97);
}

