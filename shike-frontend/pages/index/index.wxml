<view class="container {{(showPlanModal || showWaterSheet || showNutritionModal || showAiResultModal || showExerciseModal || showMealOptionSheet || showOilOptionSheet || showViewModeSheet) ? 'page-lock' : ''}}">
  <!-- 0. 顶部导航/状态栏 -->
  <view class="app-header flex justify-between align-center">
    <view class="header-icon-btn" catchtap="showViewModeModal">
      <text>{{viewModeOptions[viewModeIndex]}} ▾</text>
    </view>
    <view class="header-title-wrapper flex flex-col align-center">
      <text class="header-title">咔嚓算卡</text>
      <text class="header-date">{{currentDateStr}}</text>
    </view>
    <view class="header-avatar-btn" catchtap="onTapAvatar">
      <image class="header-avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view class="avatar-dot"></view>
    </view>
  </view>

  <!-- 紧急扣分预警/提醒栏 -->
  <view class="nudge-warning-bar flex justify-between align-center" wx:if="{{showLateCheckinWarning}}">
    <view class="flex align-center" style="gap: 12rpx;">
      <text style="font-size: 28rpx; animation: pulse 1.5s infinite;">⚠️</text>
      <text style="font-size: 22rpx; color: #DC2626; font-weight: 700;">小队扣分预警：今晚24点结算，未打卡将扣除了100积分！</text>
    </view>
    <view class="btn-quick-photo" catchtap="onQuickPhotoRecord">📸 打卡</view>
  </view>

  <!-- 🥤 智能饮水按时提醒栏 -->
  <view class="water-reminder-bar flex justify-between align-center" wx:if="{{showWaterReminderBar}}">
    <view class="water-reminder-left flex align-center">
      <text class="water-reminder-text">{{waterReminderMsg}}</text>
    </view>
    <view class="water-reminder-right flex align-center">
      <view class="btn-quick-water" catchtap="onQuickAddWater250">💧 +250ml</view>
      <text class="water-reminder-close" catchtap="onDismissWaterReminder">✕</text>
    </view>
  </view>


  <block wx:if="{{viewModeIndex === 0}}">
    <!-- 1. 今日热量大环形看板 -->
    <view class="calorie-board-container align-center flex-col flex">
      <view class="calorie-ring-wrapper">
        <view class="ring-outer-glow"></view>
        <view class="ring-glass-disc"></view>
        <view class="ring-inner-disc"></view>
        <canvas type="2d" id="calorieCanvas" class="calorie-canvas {{(showNewFeatureModal || showPlanModal || showNutritionModal || showAiResultModal || showExerciseModal || showMealOptionSheet || showOilOptionSheet || showWaterSheet || showViewModeSheet) ? 'canvas-hidden' : ''}}"></canvas>
        <view class="ring-content flex-col align-center flex">
          <text class="ring-label {{isOverLimit ? 'over-limit-lbl' : (progressPercent <= 15 ? 'danger-lbl' : (progressPercent <= 40 ? 'warning-lbl' : ''))}}">{{ringLabel}}</text>
          <text class="ring-value {{isOverLimit ? 'over-limit-val' : (progressPercent <= 15 ? 'danger-val' : (progressPercent <= 40 ? 'warning-val' : ''))}}">{{remainingCal}}</text>
          <text class="ring-unit">千卡</text>
        </view>
      </view>
      <!-- 同行并排：已摄入 / 目标 / 运动打卡胶囊 -->
      <view class="calorie-detail-text flex align-center justify-center flex-wrap" style="gap: 10rpx;">
        <text>已摄入 <text class="bold-text">{{consumedCal}}</text> / 目标 <text class="bold-text">{{targetCal}}</text></text>
        <text class="calorie-inline-slash">/</text>
        <view class="exercise-inline-capsule flex align-center" catchtap="openAddExerciseModal">
          <text class="capsule-icon">🏃</text>
          <block wx:if="{{exerciseCal > 0}}">
            <text class="capsule-text">运动 <text class="capsule-val">+{{exerciseCal}}</text></text>
          </block>
          <block wx:else>
            <text class="capsule-text">记运动</text>
          </block>
          <text class="capsule-add-plus">+</text>
        </view>
      </view>
    </view>

    <!-- 新人引导完善档案横幅 -->
    <view class="guide-banner flex justify-between align-center" wx:if="{{showProfileGuide}}" catchtap="goToProfile">
      <view class="guide-text flex align-center">
        <text class="guide-emoji">📋</text>
        <view class="guide-desc flex flex-col">
          <text class="guide-title">完善个人健康档案</text>
          <text class="guide-subtitle">定制您专属的每日热量预算与营养素目标</text>
        </view>
      </view>
      <text class="guide-arrow">立即去完善 ></text>
    </view>

    <!-- 2. 三大营养素并列占比条 -->
    <view class="glass-card nutrients-card" catchtap="openNutritionDetailModal">
      <view class="nutrients-header-row flex justify-between align-center">
        <text class="nutrients-header-title">三大营养素分布</text>
        <view class="nutrients-diag-trigger flex align-center" wx:if="{{features.diet_diagnosis !== false}}">
          <text class="diag-trigger-icon">💡</text>
          <text class="diag-trigger-text">AI 营养诊断 ></text>
        </view>
      </view>

      <view class="macronutrient-bar">
        <view class="bar-segment carbs" style="width: {{nutrients.carbsPercent}}%;"></view>
        <view class="bar-segment protein" style="width: {{nutrients.proteinPercent}}%;"></view>
        <view class="bar-segment fat" style="width: {{nutrients.fatPercent}}%;"></view>
      </view>

      <view class="macronutrient-labels flex justify-between">
        <view class="label-item flex align-center">
          <view class="bullet carbs"></view>
          <view class="label-text flex-col flex">
            <text class="lbl-title">碳水 (目标{{nutrients.targetCarbs}}g)</text>
            <text class="lbl-val">{{nutrients.carbs}}g <text class="lbl-pct">({{nutrients.carbsPercent}}%)</text></text>
          </view>
        </view>
        <view class="label-item flex align-center">
          <view class="bullet protein"></view>
          <view class="label-text flex-col flex">
            <text class="lbl-title">蛋白 (目标{{nutrients.targetProtein}}g)</text>
            <text class="lbl-val">{{nutrients.protein}}g <text class="lbl-pct">({{nutrients.proteinPercent}}%)</text></text>
          </view>
        </view>
        <view class="label-item flex align-center">
          <view class="bullet fat"></view>
          <view class="label-text flex-col flex">
            <text class="lbl-title">脂肪 (目标{{nutrients.targetFat}}g)</text>
            <text class="lbl-val">{{nutrients.fat}}g <text class="lbl-pct">({{nutrients.fatPercent}}%)</text></text>
          </view>
        </view>
      </view>
    </view>

    <!-- 🎯 专属 AI 运动与饮食计划快捷入口卡片 -->
    <view class="glass-card ai-plan-entry-card flex justify-between align-center" catchtap="openPlanModal" wx:if="{{features.ai_plan !== false}}">
      <view class="ai-plan-left flex align-center">
        <view class="ai-plan-badge flex align-center justify-center">🎯</view>
        <view class="ai-plan-info flex flex-col justify-center">
          <view class="ai-plan-header-row flex align-center">
            <text class="ai-plan-title">AI 专属定制计划</text>
            <text class="ai-plan-tag">RD/CSCS认证</text>
          </view>
          <text class="ai-plan-sub">基于您的身体档案与阶段目标精准推算</text>
        </view>
      </view>
      <view class="ai-plan-arrow-btn flex align-center justify-center">
        <text class="arrow-text">查看计划 ›</text>
      </view>
    </view>

    <!-- 3. 横向滑动三餐打卡记录卡片 -->
    <view class="meal-section">
      <view class="section-header flex justify-between align-center">
        <view class="flex align-center" style="gap: 12rpx;">
          <text class="section-title">今日三餐记录</text>
          <text class="poster-link-btn" catchtap="onGeneratePoster" wx:if="{{features.poster_share !== false}}">📸 晒餐海报</text>
        </view>
        <text class="history-link-btn" catchtap="onTapHistory">历史记录 ></text>
      </view>
      <scroll-view class="meal-scroll-row" scroll-x="true" enable-flex="true">
        <view class="meal-card-item" wx:for="{{meals}}" wx:key="type" catchtap="onScanMeal" data-type="{{item.type}}">
          <view class="meal-img-wrapper">
            <image class="meal-card-img" src="{{item.image}}" mode="aspectFill" />
          </view>
          <text class="meal-card-name">{{item.name}}</text>
          <text class="meal-card-time">{{item.time}}</text>
          <text class="meal-card-cal {{item.recorded ? 'recorded' : ''}}">{{item.recorded ? item.calories + '千卡' : '点击记录'}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 4. 今日运动打卡卡片 -->
    <view class="exercise-section">
      <view class="section-header flex justify-between align-center">
        <view class="flex align-center" style="gap: 12rpx;">
          <text class="section-title">今日运动记录</text>
          <text class="exercise-count-badge" wx:if="{{exercises.length > 0}}">{{exercises.length}} 项</text>
        </view>
        <text class="add-exercise-btn" catchtap="openAddExerciseModal">+ 记录运动</text>
      </view>
      
      <view class="glass-card exercise-card">
        <block wx:if="{{exercises.length > 0}}">
          <scroll-view class="exercise-scroll-box" scroll-y="true" enhanced="true" show-scrollbar="false">
            <view class="exercise-list">
              <view class="exercise-item flex justify-between align-center" wx:for="{{exercises}}" wx:key="id">
                <view class="exercise-info flex align-center">
                  <text class="exercise-icon" style="background: {{item.bg || 'rgba(14, 165, 233, 0.1)'}};">{{item.emoji}}</text>
                  <view class="exercise-details flex flex-col">
                    <text class="exercise-name">{{item.cleanActivityName || item.activityName}}</text>
                    <text class="exercise-time">{{item.durationMinutes}} 分钟</text>
                  </view>
                </view>
                <view class="exercise-right flex align-center">
                  <text class="exercise-cal" style="color: {{item.color || '#0EA5E9'}};">-{{item.caloriesBurned}} kcal</text>
                  <view class="exercise-delete-btn" catchtap="onDeleteExercise" data-id="{{item.id}}">✕</view>
                </view>
              </view>
            </view>
          </scroll-view>
        </block>
        <block wx:else>
          <view class="exercise-empty flex flex-col align-center justify-center" catchtap="openAddExerciseModal">
            <text class="exercise-empty-icon">🏃‍♂️</text>
            <text class="exercise-empty-text">今天还没有运动，点击记录开始抵扣热量</text>
          </view>
        </block>
      </view>
    </view>
  </block>

  <!-- 5. 近7天热量周看板 -->
  <block wx:if="{{viewModeIndex === 1}}">
    <!-- 顶部快捷返回导航条 -->
    <view class="back-to-today-bar flex justify-between align-center" catchtap="switchToDayMode">
      <view class="flex align-center" style="gap: 12rpx;">
        <text class="back-icon">←</text>
        <text class="back-title">返回今日热量大环</text>
      </view>
      <text class="back-badge">今日打卡 ></text>
    </view>

    <!-- Summary Card (本周概览总览卡片) -->
    <view class="glass-card week-summary-card">
      <view class="week-summary-header flex justify-between align-center">
        <view class="week-period-box flex align-center">
          <text class="week-period-icon">📅</text>
          <text class="week-period-text">{{weekDashboardData.startDate || '本周'}} ~ {{weekDashboardData.endDate || '今天'}}</text>
        </view>
        <view class="health-rating-badge flex align-center">
          <text class="rating-star">⭐</text>
          <text class="rating-text">{{weekDashboardData.healthRating || 'A 保持良好'}}</text>
        </view>
      </view>

      <!-- 4大关键指标网格 -->
      <view class="week-metrics-grid flex flex-wrap justify-between">
        <view class="metric-item flex flex-col align-center">
          <text class="metric-val">{{weekDashboardData.avgDailyIntake || 0}} <text class="metric-unit">kcal</text></text>
          <text class="metric-lbl">周日均摄入</text>
        </view>
        <view class="metric-item flex flex-col align-center">
          <text class="metric-val">{{weekDashboardData.avgDailyBurned || 0}} <text class="metric-unit">kcal</text></text>
          <text class="metric-lbl">周日均运动</text>
        </view>
        <view class="metric-item flex flex-col align-center">
          <text class="metric-val deficit-val">{{weekDashboardData.accumulatedDeficit || 0}} <text class="metric-unit">kcal</text></text>
          <text class="metric-lbl">本周创缺口</text>
        </view>
        <view class="metric-item flex flex-col align-center">
          <text class="metric-val">{{weekDashboardData.checkinCount || 0}} <text class="metric-unit">天 / 7天</text></text>
          <text class="metric-lbl">记录天数</text>
        </view>
      </view>

      <!-- Evaluation message quote box -->
      <view class="week-eval-box" wx:if="{{weekDashboardData.evaluationMessage}}">
        <text class="eval-text">💡 {{weekDashboardData.evaluationMessage}}</text>
      </view>
    </view>

    <!-- 本周体重变化小结卡片 -->
    <view class="glass-card week-weight-card" bindtap="openWeightModal">
      <view class="weight-card-header flex justify-between align-center">
        <view class="flex align-center" style="gap: 10rpx;">
          <text class="weight-icon">⚖️</text>
          <text class="weight-card-title">本周体重记录与变动</text>
        </view>
        <view class="record-weight-btn flex align-center" catchtap="openWeightModal">
          <text>+ 记录今天体重</text>
        </view>
      </view>
      
      <view class="weight-metrics-row flex justify-between align-center" style="margin-top: 16rpx;">
        <view class="weight-metric-box flex-1">
          <text class="w-lbl">周初体重</text>
          <text class="w-val">{{weekDashboardData.weightStart ? weekDashboardData.weightStart + ' kg' : '--'}}</text>
        </view>
        <view class="weight-arrow-box flex flex-col align-center justify-center">
          <text class="w-change-badge {{weekDashboardData.weightChange < 0 ? 'loss' : (weekDashboardData.weightChange > 0 ? 'gain' : 'flat')}}">{{weekDashboardData.weightChange ? (weekDashboardData.weightChange > 0 ? '+' + weekDashboardData.weightChange : weekDashboardData.weightChange) + ' kg' : '持平'}}</text>
          <text class="w-arrow">➔</text>
        </view>
        <view class="weight-metric-box flex-1 text-right">
          <text class="w-lbl">最新记录</text>
          <text class="w-val highlight">{{weekDashboardData.weightLatest ? weekDashboardData.weightLatest + ' kg' : '--'}}</text>
        </view>
      </view>
    </view>

    <!-- 7-Day Bar Chart Card (7天柱状对比图卡片) -->
    <view class="glass-card week-chart-card">
      <view class="week-card-title flex align-center">
        <text class="card-title-text">📊 本周每日热量摄入与消耗对比</text>
      </view>

      <view class="chart-container flex justify-between align-end">
        <block wx:for="{{weekDashboardData.dailyDetails}}" wx:key="date">
          <view class="chart-col flex flex-col align-center flex-1">
            <text class="bar-top-val">{{item.intake > 0 ? item.intake : '-'}}</text>
            <view class="bar-track flex flex-col justify-end align-center">
              <view class="bar-fill-intake {{item.intake > (item.target || 2000) ? 'surplus-bar' : 'deficit-bar'}}" 
                    style="height: {{item.intake ? ((item.intake / 2600) * 100 > 100 ? 100 : (item.intake / 2600) * 100) : 0}}%;">
              </view>
            </view>
            <view class="status-badge {{item.intake > (item.target || 2000) ? 'status-surplus' : (item.intake > 0 ? 'status-deficit' : 'status-normal')}}">
              <text class="status-badge-text">{{item.intake > (item.target || 2000) ? '超标' : (item.intake > 0 ? '达标' : '未记录')}}</text>
            </view>
            <view class="day-label-box flex align-center">
              <text class="day-label-text {{item.isToday ? 'today-text' : ''}}">{{item.dayOfWeek || item.dayName || item.day || '周'}}</text>
              <text class="today-badge" wx:if="{{item.isToday}}">今天</text>
            </view>
          </view>
        </block>
      </view>
      <view class="chart-legend flex justify-center align-center">
        <view class="legend-item flex align-center">
          <view class="legend-dot green-dot"></view>
          <text class="legend-text">热量赤字/达标</text>
        </view>
        <view class="legend-item flex align-center">
          <view class="legend-dot orange-dot"></view>
          <text class="legend-text">热量盈余</text>
        </view>
      </view>
    </view>

    <!-- Macro Ratio Card (三大营养素占比卡片) -->
    <view class="glass-card week-macro-card">
      <view class="week-card-title flex align-center justify-between">
        <text class="card-title-text">🥗 周平均三大营养素结构</text>
      </view>

      <view class="week-macro-bar flex">
        <view class="macro-segment protein-seg" style="width: {{weekDashboardData.proteinRatio || 0}}%;"></view>
        <view class="macro-segment carbs-seg" style="width: {{weekDashboardData.carbsRatio || 0}}%;"></view>
        <view class="macro-segment fat-seg" style="width: {{weekDashboardData.fatRatio || 0}}%;"></view>
      </view>

      <view class="week-macro-details flex justify-between">
        <view class="macro-detail-item flex align-center">
          <view class="macro-bullet protein-bullet"></view>
          <view class="macro-info flex flex-col">
            <text class="macro-name">蛋白质</text>
            <text class="macro-val">{{weekDashboardData.avgProtein || 0}}g <text class="macro-pct">({{weekDashboardData.proteinRatio || 0}}%)</text></text>
          </view>
        </view>
        <view class="macro-detail-item flex align-center">
          <view class="macro-bullet carbs-bullet"></view>
          <view class="macro-info flex flex-col">
            <text class="macro-name">碳水</text>
            <text class="macro-val">{{weekDashboardData.avgCarbs || 0}}g <text class="macro-pct">({{weekDashboardData.carbsRatio || 0}}%)</text></text>
          </view>
        </view>
        <view class="macro-detail-item flex align-center">
          <view class="macro-bullet fat-bullet"></view>
          <view class="macro-info flex flex-col">
            <text class="macro-name">脂肪</text>
            <text class="macro-val">{{weekDashboardData.avgFat || 0}}g <text class="macro-pct">({{weekDashboardData.fatRatio || 0}}%)</text></text>
          </view>
        </view>
      </view>
    </view>

  </block>

  <!-- 6. 30天月度健康战报看板 -->
  <block wx:if="{{viewModeIndex === 2}}">
    <!-- 顶部快捷返回导航条 -->
    <view class="back-to-today-bar flex justify-between align-center" catchtap="switchToDayMode">
      <view class="flex align-center" style="gap: 12rpx;">
        <text class="back-icon">←</text>
        <text class="back-title">返回今日热量大环</text>
      </view>
      <text class="back-badge">今日打卡 ></text>
    </view>

    <!-- Month Summary Card (月度概览总览卡片) -->
    <view class="glass-card week-summary-card month-summary-card">
      <view class="week-summary-header flex justify-between align-center">
        <view class="week-period-box flex align-center">
          <text class="week-period-icon">📅</text>
          <text class="week-period-text">{{monthDashboardData.yearMonthStr || '2026年08月'}}·健康战报</text>
        </view>
        <view class="health-rating-badge flex align-center">
          <text class="rating-star">⭐</text>
          <text class="rating-text">{{monthDashboardData.healthRating || 'A+ 30天蜕变先锋'}}</text>
        </view>
      </view>

      <!-- 4大关键指标网格 -->
      <view class="week-metrics-grid flex flex-wrap justify-between">
        <view class="metric-item flex flex-col align-center">
          <text class="metric-val">{{monthDashboardData.avgDailyIntake || 0}} <text class="metric-unit">kcal</text></text>
          <text class="metric-lbl">月日均摄入</text>
        </view>
        <view class="metric-item flex flex-col align-center">
          <text class="metric-val">{{monthDashboardData.avgDailyBurned || 0}} <text class="metric-unit">kcal</text></text>
          <text class="metric-lbl">月日均运动</text>
        </view>
        <view class="metric-item flex flex-col align-center">
          <text class="metric-val {{monthDashboardData.accumulatedDeficit < 0 ? 'surplus-val' : 'deficit-val'}}">{{monthDashboardData.accumulatedDeficit || 0}} <text class="metric-unit">kcal</text></text>
          <text class="metric-lbl">本月创缺口</text>
        </view>
        <view class="metric-item flex flex-col align-center">
          <text class="metric-val">{{monthDashboardData.checkinCount || 0}} <text class="metric-unit">天 ({{monthDashboardData.checkinRate || 0}}%)</text></text>
          <text class="metric-lbl">月打卡天数</text>
        </view>
      </view>

      <!-- Evaluation message quote box -->
      <view class="week-eval-box" wx:if="{{monthDashboardData.evaluationMessage}}">
        <text class="eval-text">💡 {{monthDashboardData.evaluationMessage}}</text>
      </view>
    </view>

    <!-- 月度 30 天体重变化趋势卡片 -->
    <view class="glass-card month-weight-card" bindtap="openWeightModal">
      <view class="weight-card-header flex justify-between align-center">
        <view class="flex align-center" style="gap: 10rpx;">
          <text class="weight-icon">📈</text>
          <text class="weight-card-title">30天体重变化趋势与成果</text>
        </view>
        <view class="record-weight-btn flex align-center" catchtap="openWeightModal">
          <text>+ 记录体重</text>
        </view>
      </view>
      
      <view class="month-weight-summary-grid flex justify-between align-center" style="margin-top: 16rpx;">
        <view class="m-w-item flex-1">
          <text class="m-w-lbl">月初体重</text>
          <text class="m-w-val">{{monthDashboardData.weightStart ? monthDashboardData.weightStart + ' kg' : '--'}}</text>
        </view>
        <view class="m-w-item flex-1 text-center">
          <text class="m-w-lbl">最高 / 最低</text>
          <text class="m-w-val m-w-range">{{monthDashboardData.maxWeight ? monthDashboardData.maxWeight : '--'}} / {{monthDashboardData.minWeight ? monthDashboardData.minWeight + ' kg' : '--'}}</text>
        </view>
        <view class="m-w-item flex-1 text-right">
          <text class="m-w-lbl">本月净减重</text>
          <text class="m-w-val highlight-change {{monthDashboardData.totalWeightChange < 0 ? 'loss' : (monthDashboardData.totalWeightChange > 0 ? 'gain' : 'flat')}}">{{monthDashboardData.totalWeightChange ? (monthDashboardData.totalWeightChange > 0 ? '+' + monthDashboardData.totalWeightChange : monthDashboardData.totalWeightChange) + ' kg' : '持平'}}</text>
        </view>
      </view>
    </view>

    <!-- 4-Week Trend Bar Chart Card (4周趋势对比图卡片) -->
    <view class="glass-card week-chart-card month-chart-card">
      <view class="week-card-title flex align-center">
        <text class="card-title-text">📊 月度周趋势对比 (按周洞察)</text>
      </view>

      <view class="chart-container flex justify-around align-end">
        <block wx:for="{{monthDashboardData.weeklyTrends}}" wx:key="weekName">
          <view class="chart-col flex flex-col align-center flex-1">
            <text class="bar-top-val">{{(item.avgIntake || item.intake) > 0 ? (item.avgIntake || item.intake) : '-'}}</text>
            <view class="bar-track flex flex-col justify-end align-center">
              <view class="bar-fill-intake {{(item.avgIntake || item.intake) > (item.target || 2000) ? 'surplus-bar' : 'deficit-bar'}}" 
                    style="height: {{(item.avgIntake || item.intake) ? (((item.avgIntake || item.intake) / 2600) * 100 > 100 ? 100 : ((item.avgIntake || item.intake) / 2600) * 100) : 0}}%;">
              </view>
            </view>
            <view class="status-badge {{(item.avgIntake || item.intake) > (item.target || 2000) ? 'status-surplus' : ((item.avgIntake || item.intake) > 0 ? 'status-deficit' : 'status-normal')}}">
              <text class="status-badge-text">{{(item.avgIntake || item.intake) > (item.target || 2000) ? '超标' : ((item.avgIntake || item.intake) > 0 ? '达标' : '未记录')}}</text>
            </view>
            <view class="day-label-box month-week-label-box flex flex-col align-center">
              <text class="day-label-text">{{item.weekName}}</text>
              <text class="week-period-sub" wx:if="{{item.weekPeriod}}">{{item.weekPeriod}}</text>
            </view>
          </view>
        </block>
      </view>
      <view class="chart-legend flex justify-center align-center">
        <view class="legend-item flex align-center">
          <view class="legend-dot green-dot"></view>
          <text class="legend-text">热量赤字/达标</text>
        </view>
        <view class="legend-item flex align-center">
          <view class="legend-dot orange-dot"></view>
          <text class="legend-text">热量盈余</text>
        </view>
      </view>
    </view>

    <!-- Monthly Macro Breakdown Card (月三大营养素占比卡片) -->
    <view class="glass-card week-macro-card month-macro-card">
      <view class="week-card-title flex align-center justify-between">
        <text class="card-title-text">🥗 月平均三大营养素结构</text>
      </view>

      <view class="week-macro-bar flex">
        <view class="macro-segment protein-seg" style="width: {{monthDashboardData.proteinRatio || 0}}%;"></view>
        <view class="macro-segment carbs-seg" style="width: {{monthDashboardData.carbsRatio || 0}}%;"></view>
        <view class="macro-segment fat-seg" style="width: {{monthDashboardData.fatRatio || 0}}%;"></view>
      </view>

      <view class="week-macro-details flex justify-between">
        <view class="macro-detail-item flex align-center">
          <view class="macro-bullet protein-bullet"></view>
          <view class="macro-info flex flex-col">
            <text class="macro-name">蛋白质</text>
            <text class="macro-val">{{monthDashboardData.avgProtein || 0}}g <text class="macro-pct">({{monthDashboardData.proteinRatio || 0}}%)</text></text>
          </view>
        </view>
        <view class="macro-detail-item flex align-center">
          <view class="macro-bullet carbs-bullet"></view>
          <view class="macro-info flex flex-col">
            <text class="macro-name">碳水</text>
            <text class="macro-val">{{monthDashboardData.avgCarbs || 0}}g <text class="macro-pct">({{monthDashboardData.carbsRatio || 0}}%)</text></text>
          </view>
        </view>
        <view class="macro-detail-item flex align-center">
          <view class="macro-bullet fat-bullet"></view>
          <view class="macro-info flex flex-col">
            <text class="macro-name">脂肪</text>
            <text class="macro-val">{{monthDashboardData.avgFat || 0}}g <text class="macro-pct">({{monthDashboardData.fatRatio || 0}}%)</text></text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 视图模式选择居中弹窗 -->
  <view class="modal-backdrop {{showViewModeSheet ? 'active' : ''}}" catchtap="hideViewModeModal" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">选择看板视图</text>
        <text class="modal-close" catchtap="hideViewModeModal">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y>
        <view class="modal-option {{viewModeIndex === index ? 'active' : ''}}" 
              wx:for="{{viewModeOptions}}" wx:key="*this" 
              catchtap="selectViewMode" data-index="{{index}}">
          <text class="modal-option-label">{{item}}看板</text>
          <icon type="success_no_circle" size="14" color="#10B981" wx:if="{{viewModeIndex === index}}" />
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 添加运动录入居中弹窗 -->
  <view class="modal-backdrop {{showExerciseModal ? 'active' : ''}}" catchtap="closeAddExerciseModal" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">记录运动</text>
        <text class="modal-close" catchtap="closeAddExerciseModal">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y>
        <view class="form-group" catchtap="openExerciseTypeSheet">
          <text class="form-label">运动类型</text>
          <view class="picker-value-box flex justify-between align-center">
            <text>{{exerciseTypeOptions[exerciseTypeIndex].name}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </view>

        <view class="form-group">
          <text class="form-label">运动时长 (分钟)</text>
          <input class="form-input" type="number" placeholder="输入运动时长" value="{{exerciseDuration}}" bindinput="onExerciseDurationInput" />
        </view>

        <view class="form-group">
          <text class="form-label">消耗热量 (kcal)</text>
          <input class="form-input" type="digit" placeholder="自动根据MET计算或手动微调" value="{{exerciseCalories}}" bindinput="onExerciseCaloriesInput" />
          <text class="form-tip">💡 基于估算公式，您也可以根据运动手环数据手动修改数值</text>
        </view>

        <view class="ai-result-actions" style="margin-top: 40rpx; width: 100%;">
          <button class="ai-result-btn cancel" catchtap="closeAddExerciseModal">取消</button>
          <button class="ai-result-btn confirm" catchtap="submitExercise">确定</button>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 选择运动类型弹窗 -->
  <view class="modal-backdrop {{showExerciseTypeSheet ? 'active' : ''}}" style="z-index: 1100;" catchtap="closeExerciseTypeSheet" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">选择运动类型</text>
        <text class="modal-close" catchtap="closeExerciseTypeSheet">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y style="max-height: 480rpx;">
        <view class="modal-option {{exerciseTypeIndex === index ? 'active' : ''}}" 
              wx:for="{{exerciseTypeOptions}}" wx:key="name" 
              catchtap="selectExerciseType" data-index="{{index}}">
          <text class="modal-option-label">{{item.name}}</text>
          <icon type="success_no_circle" size="14" color="#10B981" wx:if="{{exerciseTypeIndex === index}}" />
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 选择记录方式居中弹窗 -->
  <view class="modal-backdrop {{showMealOptionSheet ? 'active' : ''}}" catchtap="hideMealOptionModal" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">记录{{currentMealName}}</text>
        <text class="modal-close" catchtap="hideMealOptionModal">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y>
        <!-- 提示词引导输入框 -->
        <view class="modal-hint-box">
          <input class="modal-hint-input" placeholder="补充说明（可选，如：肉包、少油面条）" value="{{mealHint}}" bindinput="onMealHintInput" placeholder-style="color: #94A3B8;" />
          <view class="quick-tags-container">
            <view class="quick-tag {{mealHint === tag ? 'active' : ''}}" 
                  wx:for="{{quickTags}}" 
                  wx:key="*this" 
                  wx:for-item="tag"
                  catchtap="tapQuickTag" 
                  data-tag="{{tag}}">
              {{tag}}
            </view>
          </view>
        </view>
        <view class="modal-option" catchtap="selectMealOption" data-option="camera">
          <view style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <text class="modal-option-label">📷 拍照识别 (AI)</text>
            <text style="font-size: 22rpx; color: #EF4444; background: #FEE2E2; padding: 4rpx 12rpx; border-radius: 6rpx; font-weight: 500; margin-right: 20rpx;">-5 积分</text>
          </view>
        </view>
        <view class="modal-option" catchtap="selectMealOption" data-option="album">
          <view style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <text class="modal-option-label">🖼️ 从相册选择 (AI)</text>
            <text style="font-size: 22rpx; color: #EF4444; background: #FEE2E2; padding: 4rpx 12rpx; border-radius: 6rpx; font-weight: 500; margin-right: 20rpx;">-5 积分</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 选择油脂修正居中弹窗 -->
  <view class="modal-backdrop {{showOilOptionSheet ? 'active' : ''}}" catchtap="hideOilOptionModal" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">选择油量级别 (热量校准)</text>
        <text class="modal-close" catchtap="hideOilOptionModal">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y>
        <view class="modal-option" catchtap="selectOilOption" data-level="LIGHT">
          <text class="modal-option-label">🍃 清淡少油 (脂肪-15%, 热量-10%)</text>
        </view>
        <view class="modal-option" catchtap="selectOilOption" data-level="MODERATE">
          <text class="modal-option-label">🍲 适中普通 (无修正)</text>
        </view>
        <view class="modal-option" catchtap="selectOilOption" data-level="HEAVY">
          <text class="modal-option-label">🌶️ 重油多盐 (脂肪+20%, 热量+15%)</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- AI 识别结果磨砂弹窗 -->
  <view class="modal-backdrop {{showAiResultModal ? 'active' : ''}}" catchtouchmove="preventBubble">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">{{aiResultSuccess ? '🍽️ AI 识别成功' : '⚠️ 识别提示'}}</text>
        <text class="modal-close" catchtap="hideAiResultModal">✕</text>
      </view>
      <view class="ai-result-body">
        <block wx:if="{{aiResultSuccess}}">
          <!-- 可编辑食材列表 -->
          <view class="editable-food-list" style="margin: 12rpx 0; width: 100%;">
            <scroll-view class="food-list-scroll" scroll-y style="height: 420rpx;">
              <view class="food-item-card" wx:for="{{aiFoodItems}}" wx:key="index">
                <view class="food-item-row-top">
                  <input class="food-input name" value="{{item.name}}" bindinput="onFoodItemNameInput" data-index="{{index}}" placeholder="食材名称" />
                  <view class="input-unit-container weight">
                    <input class="food-input weight" type="digit" value="{{item.weight}}" bindinput="onFoodItemWeightInput" data-index="{{index}}" />
                    <text class="input-unit">g</text>
                  </view>
                  <view class="input-unit-container calories">
                    <input class="food-input calories" type="digit" value="{{item.calories}}" bindinput="onFoodItemCaloriesInput" data-index="{{index}}" />
                    <text class="input-unit">kcal</text>
                  </view>
                  <view class="food-delete-btn" catchtap="deleteFoodItem" data-index="{{index}}">✕</view>
                </view>
                
                <view class="food-item-row-bottom">
                  <view class="nutrient-input-box protein">
                    <text class="nutrient-emoji">🥩</text>
                    <text class="nutrient-label">蛋白</text>
                    <input class="nutrient-val" type="digit" value="{{item.protein}}" bindinput="onFoodItemProteinInput" data-index="{{index}}" />
                    <text class="nutrient-unit">g</text>
                  </view>
                  <view class="nutrient-input-box fat">
                    <text class="nutrient-emoji">🥑</text>
                    <text class="nutrient-label">脂肪</text>
                    <input class="nutrient-val" type="digit" value="{{item.fat}}" bindinput="onFoodItemFatInput" data-index="{{index}}" />
                    <text class="nutrient-unit">g</text>
                  </view>
                  <view class="nutrient-input-box carbs">
                    <text class="nutrient-emoji">🍞</text>
                    <text class="nutrient-label">碳水</text>
                    <input class="nutrient-val" type="digit" value="{{item.carbs}}" bindinput="onFoodItemCarbsInput" data-index="{{index}}" />
                    <text class="nutrient-unit">g</text>
                  </view>
                </view>

                <!-- 模糊匹配词典匹配提示 -->
                <view class="match-suggestion-toast" wx:if="{{item.matched && item.matched.name !== item.name}}" catchtap="applyMatchSuggestion" data-index="{{index}}">
                  💡 匹配到估量：1{{item.matched.unit}}{{item.matched.name}} ≈ {{item.matched.weight}}g (点击套用)
                </view>
              </view>
            </scroll-view>
            
            <!-- 新增食材按钮 -->
            <view class="add-food-row" catchtap="addNewFoodItem">
              <text class="add-food-btn">+ 添加食材</text>
            </view>
            
            <!-- 常见食材估重助手小卡片 -->
            <view class="portion-helper-card">
              <view class="portion-helper-title">💡 常见食物估量助手</view>
              <view class="portion-helper-tags">
                <view class="portion-helper-tag" wx:for="{{helperFoods}}" wx:key="name" catchtap="addHelperFood" data-name="{{item.name}}">
                  + {{item.name}} (1{{item.unit}})
                </view>
              </view>
            </view>

            <!-- 三大营养素总量汇总 -->
            <view class="ai-result-macro-row">
              <view class="macro-badge protein">
                <text class="macro-dot">🥩</text>
                <text class="macro-label">蛋白</text>
                <text class="macro-value">{{aiResultProtein || 0}}g</text>
              </view>
              <view class="macro-badge fat">
                <text class="macro-dot">🥑</text>
                <text class="macro-label">脂肪</text>
                <text class="macro-value">{{aiResultFat || 0}}g</text>
              </view>
              <view class="macro-badge carbs">
                <text class="macro-dot">🍞</text>
                <text class="macro-label">碳水</text>
                <text class="macro-value">{{aiResultCarbs || 0}}g</text>
              </view>
            </view>

            <view class="ai-result-cal-row">
              <text class="ai-result-cal-label">估算总热量</text>
              <text class="ai-result-cal-value">{{aiResultCalories}} kcal</text>
            </view>
            <view class="ai-result-hint">确认后将选择油量级别并保存记录</view>
          </view>
        </block>
          <block wx:else>
            <view class="ai-result-icon fail">❌</view>
            <view class="ai-result-fail-msg">{{aiResultMessage}}</view>
            <view class="ai-result-hint">请拍摄含有食物或饮品的照片</view>
          </block>
        </view>
        <view class="ai-result-actions flex">
          <view class="ai-result-btn cancel" catchtap="hideAiResultModal">取消</view>
          <view class="ai-result-btn confirm {{aiResultSuccess ? '' : 'fail'}}" catchtap="onAiResultConfirm">
            {{aiResultSuccess ? '选择油量' : '知道了'}}
          </view>
      </view>
    </view>
  </view>

  <!-- 悬浮饮水气泡 (支持拖拽移动) -->
  <movable-area class="fab-movable-area">
    <movable-view class="fab-movable-view" direction="all" x="{{fabX}}" y="{{fabY}}" out-of-bounds="{{false}}">
      <view class="water-fab {{(showNewFeatureModal || showPlanModal || showWaterSheet || showNutritionModal || showAiResultModal || showExerciseModal || showMealOptionSheet || showOilOptionSheet || showViewModeSheet) ? 'hide' : ''}}" catchtap="openWaterSheet">
        <view class="water-fab-inner">
          <view class="water-fab-fill" style="height: {{waterFillHeight}}%;">
            <view class="fab-wave fab-wave1"></view>
            <view class="fab-wave fab-wave2"></view>
          </view>
          <view class="water-fab-highlight"></view>
          <view class="water-fab-content">
            <text class="water-fab-pct">{{waterPercent}}%</text>
          </view>
        </view>
      </view>
    </movable-view>
  </movable-area>

  <!-- 底部饮水抽屉 -->
  <view class="water-sheet-mask {{showWaterSheet ? 'active' : ''}}" catchtap="closeWaterSheet">
    <view class="water-sheet" catchtap="preventBubble">
      <view class="water-sheet-handle"></view>
      <text class="water-sheet-title">💧 今日饮水</text>

      <!-- 动态水杯 -->
      <view class="water-cup-wrapper">
        <view class="water-cup">
          <view class="water-fill" style="height: {{waterFillHeight}}%;">
            <view class="wave wave1"></view>
            <view class="wave wave2"></view>
          </view>
          <view class="cup-label">
            <text class="cup-amount">{{waterAmount}}</text>
            <text class="cup-unit">ml</text>
          </view>
        </view>
      </view>

      <view class="water-stats">
        <text class="water-stats-text">目标 {{waterTarget}} ml · 已完成 {{waterPercent}}%</text>
      </view>

      <!-- 快捷操作按钮 -->
      <view class="water-actions">
        <view class="water-btn minus" catchtap="onWaterReduce" data-amount="250">
          <text>- 250ml</text>
        </view>
        <view class="water-btn plus" catchtap="onWaterAdd" data-amount="250">
          <text>+ 250ml 🥛</text>
        </view>
        <view class="water-btn plus big" catchtap="onWaterAdd" data-amount="500">
          <text>+ 500ml 🚀</text>
        </view>
      </view>

      <!-- 🔔 微信服务通知订阅授权卡片 -->
      <view class="water-subscribe-card flex justify-between align-center" catchtap="onSubscribeWaterPush">
        <view class="water-sub-left">
          <text class="water-sub-icon">🔔</text>
          <view class="water-sub-text">
            <text class="water-sub-title">微信聊天框定时提醒</text>
            <text class="water-sub-desc">{{waterSubQuota > 0 ? '每天 10:30 / 15:30 / 20:00 自动推送' : '开启后每天 3 次定时喝水提醒'}}</text>
          </view>
        </view>
        <view class="water-sub-badge {{waterSubQuota > 0 ? 'active' : ''}}">
          <text class="water-sub-badge-text">{{waterSubQuota > 0 ? '剩 ' + waterSubQuota + ' 次' : '点击开启'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 2.2 全景营养诊断仪表盘弹窗 (适配整体清新极简磨砂风) -->
  <view class="modal-backdrop {{showNutritionModal ? 'active' : ''}}" catchtap="closeNutritionDetailModal" catchtouchmove="preventBubble">
    <view class="modal-dialog nutrition-modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">🥗 今日营养全景诊断</text>
        <text class="modal-close" catchtap="closeNutritionDetailModal">✕</text>
      </view>
      <scroll-view class="modal-content" scroll-y style="max-height: 60vh;">
        <view class="diag-section">
          <text class="diag-sec-title">📊 摄入与目标比对</text>
          <view class="diag-grid">
            <view class="diag-grid-item">
              <text class="diag-label">热量收支</text>
              <text class="diag-val {{consumedCal > targetCal ? 'text-red' : 'text-green'}}">{{consumedCal}} / {{targetCal}} kcal</text>
            </view>
            <view class="diag-grid-item">
              <text class="diag-label">碳水化合物</text>
              <text class="diag-val">{{nutrients.carbs}} / {{nutrients.targetCarbs}}g</text>
            </view>
            <view class="diag-grid-item">
              <text class="diag-label">蛋白质</text>
              <text class="diag-val {{nutrients.protein < nutrients.targetProtein * 0.75 ? 'text-yellow' : 'text-green'}}">{{nutrients.protein}} / {{nutrients.targetProtein}}g</text>
            </view>
            <view class="diag-grid-item">
              <text class="diag-label">脂肪</text>
              <text class="diag-val {{nutrients.fat > nutrients.targetFat ? 'text-red' : 'text-green'}}">{{nutrients.fat}} / {{nutrients.targetFat}}g</text>
            </view>
          </view>
        </view>

        <view class="diag-section" style="margin-top: 24rpx;" wx:if="{{aiExpertComment}}">
          <text class="diag-sec-title">🤖 专家级 AI 深度点评</text>
          <view class="ai-comment-card">
            <text class="ai-comment-text">{{aiExpertComment}}</text>
          </view>
        </view>

        <view class="diag-section" style="margin-top: 24rpx;">
          <view class="flex justify-between align-center" style="margin-bottom: 16rpx;">
            <text class="diag-sec-title">💡 膳食调优与补充建议</text>
            <button class="btn-ai-diag-trigger" catchtap="onGenerateAiDiagnosis" loading="{{isDiagnosing}}" wx:if="{{features.diet_diagnosis !== false}}">
              {{isDiagnosing ? '分析中...' : '🤖 AI 深度诊断 (15积分)'}}
            </button>
          </view>
          <view class="diag-list">
            <view class="diag-card-row" wx:for="{{nutritionInsights}}" wx:key="id">
              <view class="diag-badge-line flex align-center">
                <text class="insight-badge {{item.badgeClass}}">{{item.badge}}</text>
                <text class="diag-card-title">{{item.title}}</text>
              </view>
              <text class="diag-card-desc">{{item.suggestion}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 海报离屏绘制 Canvas -->
  <canvas type="2d" id="posterCanvas" style="width: 375px; height: 500px; position: fixed; left: -9999px; top: -9999px;" width="750" height="1000"></canvas>

  <!-- 📸 晒餐海报生成弹窗 (适配全局浅色磨砂风) -->
  <view class="modal-backdrop {{showPosterModal ? 'active' : ''}}" catchtap="closePosterModal" catchtouchmove="preventBubble">
    <view class="modal-dialog poster-dialog" catchtap="preventBubble">
      <view class="modal-header flex justify-between align-center">
        <text class="modal-title">📸 生成每日晒餐海报</text>
        <text class="modal-close" catchtap="closePosterModal">✕</text>
      </view>

      <view class="poster-tabs flex justify-around">
        <view class="poster-tab {{activeTemplate === 'morandi' ? 'active' : ''}}" catchtap="switchTemplate" data-template="morandi">🌿 莫兰迪极简</view>
        <view class="poster-tab {{activeTemplate === 'vogue' ? 'active' : ''}}" catchtap="switchTemplate" data-template="vogue">📸 杂志封面</view>
        <view class="poster-tab {{activeTemplate === 'receipt' ? 'active' : ''}}" catchtap="switchTemplate" data-template="receipt">🧾 热量账单</view>
      </view>

      <view class="poster-preview-container flex justify-center align-center">
        <image class="poster-preview-img" src="{{tempPosterPath}}" mode="aspectFit" wx:if="{{tempPosterPath}}" />
        <view class="poster-loading flex flex-col align-center justify-center" wx:else>
          <text class="loading-icon" style="font-size: 48rpx; margin-bottom: 12rpx;">🎨</text>
          <text class="loading-text" style="font-size: 24rpx; color: #64748B;">正在生成高质感海报...</text>
        </view>
      </view>

      <!-- 📷 照片选择/更换操作区 -->
      <view class="poster-photo-picker flex align-center justify-center">
        <view class="photo-pick-btn" catchtap="onChoosePosterPhoto">
          📷 {{posterFoodImg ? '换一张照片' : '选择美食照片'}}
        </view>
        <view class="photo-remove-btn" catchtap="onRemovePosterPhoto" wx:if="{{posterFoodImg}}">
          ✕ 移除照片
        </view>
      </view>

      <view class="poster-action-buttons flex justify-between">
        <button class="poster-btn save" catchtap="savePosterToAlbum">💾 保存相册</button>
        <button class="poster-btn share" open-type="share">✉️ 发送好友</button>
        <button class="poster-btn timeline" catchtap="onSharePosterClick">📸 发朋友圈</button>
      </view>
    </view>
  </view>

  <!-- 🎯 专属 AI 运动与饮食计划弹窗 (全景专业风) -->
  <view class="modal-backdrop {{showPlanModal ? 'active' : ''}}" catchtap="closePlanModal" catchtouchmove="preventBubble">
    <view class="modal-dialog plan-modal-dialog" catchtap="preventBubble">
      <view class="modal-header flex justify-between align-center">
        <view class="flex align-center" style="gap: 12rpx;">
          <text class="modal-title">🎯 专属 AI 运动与饮食计划</text>
        </view>
        <text class="modal-close" catchtap="closePlanModal">✕</text>
      </view>

      <!-- 原生可滑动滚动容器 -->
      <scroll-view class="plan-modal-body" scroll-y="true" enhanced="true" show-scrollbar="false">
        <view class="plan-loading-box flex flex-col align-center justify-center" wx:if="{{planLoading}}">
          <text class="loading-icon" style="font-size: 54rpx; margin-bottom: 16rpx;">🤖</text>
          <text style="font-size: 26rpx; color: #475569; font-weight: 600;">顶级专家 AI 正在根据您的档案推算计划...</text>
          <text style="font-size: 22rpx; color: #94A3B8; margin-top: 8rpx;">遵守 RD/CSCS 知识库准则 · 匹配 Zone2 有氧与抗阻容量</text>
        </view>

        <block wx:elif="{{!planData}}">
          <!-- 未生成计划引导卡片 (由用户主动触发生成) -->
          <view class="un-generated-plan-box flex flex-col align-center justify-center" style="padding: 60rpx 30rpx; text-align: center;">
            <text style="font-size: 80rpx; margin-bottom: 24rpx;">🔮</text>
            <text style="font-size: 32rpx; font-weight: 700; color: #0F172A; margin-bottom: 16rpx;">定制专属 7 天运动与膳食食谱</text>
            <text style="font-size: 26rpx; color: #64748B; line-height: 1.6; margin-bottom: 36rpx; max-width: 90%;">
              基于您的性别、年龄、身高体重、体脂率与训练经验，由顶级 AI 导师与 RD/CSCS 专家知识库为您定制专属 7 天运动安排与 28 餐中式家常食谱！
            </text>
            <view style="font-size: 24rpx; color: #059669; background: rgba(16,185,129,0.12); padding: 12rpx 28rpx; border-radius: 30rpx; margin-bottom: 40rpx; font-weight: 600; border: 1rpx solid rgba(16,185,129,0.2);">
              {{planStatus.isFirstTime ? '✨ 首次生成专属计划【免费】' : '🤖 重新定制消耗 100 契约积分 (当前剩余 ' + (planStatus.userPoints || 0) + ' 分)'}}
            </view>
            <button catchtap="onGeneratePlanClick" style="width: 85%; height: 92rpx; line-height: 92rpx; background: linear-gradient(135deg, #10B981, #059669); color: #ffffff; font-size: 32rpx; font-weight: 700; border-radius: 46rpx; box-shadow: 0 10rpx 25rpx rgba(16,185,129,0.35);">
              {{planStatus.isFirstTime ? '✨ 免费生成专属 7 天计划' : '🤖 重新定制计划 (消耗100积分)'}}
            </button>
          </view>
        </block>

        <block wx:else>
          <!-- 专家点评 Summary Card -->
          <view class="plan-summary-card" wx:if="{{planData.summary}}">
            <view class="flex align-center" style="gap: 8rpx; margin-bottom: 8rpx;">
              <text style="font-size: 26rpx;">🩺</text>
              <text class="summary-title">专家诊断与建议</text>
            </view>
            <text class="summary-content">{{planData.summary}}</text>
          </view>

          <!-- 计划 Tab 切换 -->
          <view class="plan-tabs flex justify-between">
            <view class="plan-tab {{planActiveTab === 'workout' ? 'active' : ''}}" catchtap="switchPlanTab" data-tab="workout">
              🏋️ 7天运动安排
            </view>
            <view class="plan-tab {{planActiveTab === 'diet' ? 'active' : ''}}" catchtap="switchPlanTab" data-tab="diet">
              🥗 每日膳食推荐
            </view>
          </view>

          <!-- Tab 1: 7天运动计划 -->
          <view class="plan-tab-content" wx:if="{{planActiveTab === 'workout'}}">
            <!-- 星期选择横轴 -->
            <scroll-view class="days-scroll flex" scroll-x="true" enable-flex="true">
              <view class="day-chip {{planDayIndex === index ? 'active' : ''}} {{todayPlanDayIndex === index ? 'today' : ''}}" wx:for="{{planData.workoutPlan}}" wx:key="day" catchtap="switchPlanDay" data-index="{{index}}">
                <text class="day-chip-name">{{item.day}}</text>
                <text class="day-chip-today" wx:if="{{todayPlanDayIndex === index}}">今天</text>
                <text class="day-chip-dot" wx:elif="{{item.isRestDay}}">休息</text>
              </view>
            </scroll-view>

            <!-- 选中日期的运动清单 -->
            <view class="day-workout-card" wx:if="{{planData.workoutPlan[planDayIndex]}}">
              <view class="day-focus-header flex justify-between align-center">
                <text class="day-focus-title">🎯 训练焦点：{{planData.workoutPlan[planDayIndex].focus}}</text>
                <text class="rest-badge" wx:if="{{planData.workoutPlan[planDayIndex].isRestDay}}">😴 深度恢复</text>
              </view>

              <view class="workout-items-list">
                <view class="workout-item-card flex justify-between align-center" wx:for="{{planData.workoutPlan[planDayIndex].items}}" wx:key="name">
                  <view class="workout-item-left flex flex-col">
                    <view class="flex align-center" style="gap: 12rpx;">
                      <text class="workout-item-name">{{item.name}}</text>
                      <text class="workout-item-meta">{{item.duration}}分钟 · {{item.calories}}kcal</text>
                    </view>
                    <text class="workout-item-detail" wx:if="{{item.detail}}">💡 {{item.detail}}</text>
                  </view>
                  <view class="btn-checkin-exercise {{checkedPlanExercisesMap[item.cleanName] ? 'checked' : ''}}" catchtap="{{checkedPlanExercisesMap[item.cleanName] ? '' : 'onAddPlanExercise'}}" data-name="{{item.name}}" data-duration="{{item.duration}}" data-calories="{{item.calories}}">
                    {{checkedPlanExercisesMap[item.cleanName] ? '✓ 已打卡' : '＋打卡'}}
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- Tab 2: 每日膳食计划 -->
          <view class="plan-tab-content" wx:if="{{planActiveTab === 'diet'}}">
            <!-- 7天膳食日期选择横轴 -->
            <scroll-view class="days-scroll flex" scroll-x="true" enable-flex="true">
              <view class="day-chip {{planDayIndex === index ? 'active' : ''}} {{todayPlanDayIndex === index ? 'today' : ''}}" wx:for="{{planData.workoutPlan}}" wx:key="day" catchtap="switchPlanDay" data-index="{{index}}">
                <text class="day-chip-name">{{item.day}}</text>
                <text class="day-chip-today" wx:if="{{todayPlanDayIndex === index}}">今天</text>
              </view>
            </scroll-view>

            <view class="diet-meals-list">
              <!-- 早餐 -->
              <view class="diet-meal-card" wx:if="{{activeDietPlan.breakfast}}">
                <view class="diet-meal-header flex justify-between align-center">
                  <text class="meal-tag breakfast">🌅 早餐 · {{activeDietPlan.breakfast.title}}</text>
                  <text class="meal-cal">{{activeDietPlan.breakfast.calories}} kcal</text>
                </view>
                <text class="meal-portion-hint" wx:if="{{activeDietPlan.breakfast.portionHint}}">✋ 估算推荐: {{activeDietPlan.breakfast.portionHint}}</text>
                <view class="meal-foods-tags flex flex-wrap">
                  <text class="food-tag" wx:for="{{activeDietPlan.breakfast.foods}}" wx:key="*this">{{item}}</text>
                </view>
              </view>

              <!-- 午餐 -->
              <view class="diet-meal-card" wx:if="{{activeDietPlan.lunch}}">
                <view class="diet-meal-header flex justify-between align-center">
                  <text class="meal-tag lunch">☀️ 午餐 · {{activeDietPlan.lunch.title}}</text>
                  <text class="meal-cal">{{activeDietPlan.lunch.calories}} kcal</text>
                </view>
                <text class="meal-portion-hint" wx:if="{{activeDietPlan.lunch.portionHint}}">✋ 估算推荐: {{activeDietPlan.lunch.portionHint}}</text>
                <view class="meal-foods-tags flex flex-wrap">
                  <text class="food-tag" wx:for="{{activeDietPlan.lunch.foods}}" wx:key="*this">{{item}}</text>
                </view>
              </view>

              <!-- 晚餐 -->
              <view class="diet-meal-card" wx:if="{{activeDietPlan.dinner}}">
                <view class="diet-meal-header flex justify-between align-center">
                  <text class="meal-tag dinner">🌙 晚餐 · {{activeDietPlan.dinner.title}}</text>
                  <text class="meal-cal">{{activeDietPlan.dinner.calories}} kcal</text>
                </view>
                <text class="meal-portion-hint" wx:if="{{activeDietPlan.dinner.portionHint}}">✋ 估算推荐: {{activeDietPlan.dinner.portionHint}}</text>
                <view class="meal-foods-tags flex flex-wrap">
                  <text class="food-tag" wx:for="{{activeDietPlan.dinner.foods}}" wx:key="*this">{{item}}</text>
                </view>
              </view>

              <!-- 加餐 -->
              <view class="diet-meal-card" wx:if="{{activeDietPlan.snack}}">
                <view class="diet-meal-header flex justify-between align-center">
                  <text class="meal-tag snack">🥤 加餐 · {{activeDietPlan.snack.title}}</text>
                  <text class="meal-cal">{{activeDietPlan.snack.calories}} kcal</text>
                </view>
                <text class="meal-portion-hint" wx:if="{{activeDietPlan.snack.portionHint}}">✋ 估算推荐: {{activeDietPlan.snack.portionHint}}</text>
                <view class="meal-foods-tags flex flex-wrap">
                  <text class="food-tag" wx:for="{{activeDietPlan.snack.foods}}" wx:key="*this">{{item}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>

      <view class="plan-footer-actions flex justify-between align-center">
        <button class="btn-refresh-plan" catchtap="onRefreshPlan" wx:if="{{planData}}">🤖 重新定制 (100积分)</button>
        <button class="btn-close-plan" catchtap="closePlanModal" style="{{!planData ? 'width: 100%;' : ''}}">完成</button>
      </view>
    </view>
  </view>

  <!-- 💥 全新升级：新功能上线重磅引导弹窗 (后台动态可调) -->
  <view class="new-feature-mask flex justify-center align-center" wx:if="{{showNewFeatureModal && (announcementConfig ? announcementConfig.enabled !== false : true)}}" catchtap="closeNewFeatureModal">
    <view class="new-feature-card flex flex-col align-center" catchtap="preventBubble">
      <view class="new-feature-header flex flex-col align-center">
        <view class="new-feature-badge-top">{{announcementConfig.badgeText || 'v2.0 重磅升级'}}</view>
        <text class="new-feature-title">{{announcementConfig.title || '🎉 专属 AI 助手全新上线'}}</text>
        <text class="new-feature-subtitle">{{announcementConfig.subtitle || '精细化膳食、运动打卡与诊断全面开启'}}</text>
      </view>

      <view class="new-feature-list flex flex-col">
        <block wx:if="{{announcementConfig && announcementConfig.items && announcementConfig.items.length > 0}}">
          <view class="feature-item-row flex align-center" wx:for="{{announcementConfig.items}}" wx:key="index">
            <view class="feature-icon-box bg-purple flex align-center justify-center">{{item.icon || '🚀'}}</view>
            <view class="feature-item-info flex flex-col">
              <text class="feature-item-title">{{item.title}}</text>
              <text class="feature-item-desc">{{item.desc}}</text>
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="feature-item-row flex align-center">
            <view class="feature-icon-box bg-purple flex align-center justify-center">🤖</view>
            <view class="feature-item-info flex flex-col">
              <text class="feature-item-title">7天 AI 专属运动与食谱</text>
              <text class="feature-item-desc">精准推荐每日3~4个动作与接地气食谱</text>
            </view>
          </view>

          <view class="feature-item-row flex align-center">
            <view class="feature-icon-box bg-amber flex align-center justify-center">💡</view>
            <view class="feature-item-info flex flex-col">
              <text class="feature-item-title">AI 专家级营养健康诊断</text>
              <text class="feature-item-desc">评估三大营养占比，针对性给出指导</text>
            </view>
          </view>

          <view class="feature-item-row flex align-center">
            <view class="feature-icon-box bg-green flex align-center justify-center">📸</view>
            <view class="feature-item-info flex flex-col">
              <text class="feature-item-title">高颜值晒餐海报</text>
              <text class="feature-item-desc">一键生成精美饮食打卡图，分享朋友圈</text>
            </view>
          </view>
        </block>
      </view>

      <view class="new-feature-actions flex flex-col align-center">
        <button class="btn-primary-launch" catchtap="onLaunchAnnouncementAction">{{announcementConfig.buttonText || '✨ 立即体验 AI 计划'}}</button>
        <text class="btn-dismiss-text" catchtap="closeNewFeatureModal">知道了，先逛逛</text>
      </view>
    </view>
  </view>

  <!-- 记录体重 Modal 弹窗 -->
  <view class="weight-modal-mask flex justify-center align-center" wx:if="{{showWeightModal}}" catchtouchmove="preventTouchMove">
    <view class="glass-card weight-modal-dialog">
      <view class="weight-modal-header flex justify-between align-center">
        <text class="weight-modal-title">⚖️ 记录当前体重</text>
        <text class="weight-modal-close" bindtap="closeWeightModal">×</text>
      </view>
      <view class="weight-input-box flex align-center justify-center">
        <input class="weight-input" type="digit" placeholder="50.0" value="{{inputWeightValue}}" bindinput="onWeightInput" focus />
        <text class="weight-unit-lbl">kg</text>
      </view>
      <view class="weight-quick-tags flex justify-center flex-wrap" style="gap: 12rpx; margin-top: 16rpx;">
        <view class="quick-tag" bindtap="quickAdjustWeight" data-step="-0.5">-0.5kg</view>
        <view class="quick-tag" bindtap="quickAdjustWeight" data-step="-0.2">-0.2kg</view>
        <view class="quick-tag" bindtap="quickAdjustWeight" data-step="0.2">+0.2kg</view>
        <view class="quick-tag" bindtap="quickAdjustWeight" data-step="0.5">+0.5kg</view>
      </view>
      <view class="weight-modal-actions flex justify-between" style="gap: 20rpx; margin-top: 28rpx;">
        <button class="btn-cancel" bindtap="closeWeightModal">取消</button>
        <button class="btn-submit" bindtap="submitWeightRecord">确认保存</button>
      </view>
    </view>
  </view>

</view>
