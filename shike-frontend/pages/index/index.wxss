.container {
  padding: 30rpx 40rpx 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #F3F6F8 0%, #EBF4F6 100%);
  min-height: 100vh;
  box-sizing: border-box;
}

.container.page-lock {
  height: 100vh;
  overflow: hidden;
}

/* 0. 顶部导航/状态栏 */
.app-header {
  width: 100%;
  padding: 10rpx 0 30rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-icon-btn {
  font-size: 36rpx;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 24rpx rgba(148, 163, 184, 0.05);
}

.header-title-wrapper {
  text-align: center;
}

.header-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1E293B;
  letter-spacing: 2rpx;
}

.header-date {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 6rpx;
  font-weight: 600;
}

.header-avatar-btn {
  position: relative;
  width: 68rpx;
  height: 68rpx;
}

.header-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.avatar-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 12rpx;
  height: 12rpx;
  background-color: #EF4444;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
}

/* 1. 今日热量大环形看板 */
.calorie-board-container {
  width: 100%;
  margin: 26rpx 0 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.calorie-ring-wrapper {
  width: 392rpx;
  height: 392rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.ring-outer-glow {
  position: absolute;
  width: 362rpx;
  height: 362rpx;
  border-radius: 181rpx;
  box-sizing: border-box;
  background: rgba(248, 252, 253, 0.82);
  box-shadow:
    0 26rpx 48rpx rgba(100, 116, 139, 0.12),
    0 0 42rpx rgba(255, 255, 255, 0.9);
  z-index: 1;
  overflow: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.ring-glass-disc {
  position: absolute;
  width: 286rpx;
  height: 286rpx;
  border-radius: 143rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(231, 240, 245, 0.72));
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow:
    inset 18rpx 18rpx 34rpx rgba(148, 163, 184, 0.12),
    inset -18rpx -18rpx 34rpx rgba(255, 255, 255, 0.96),
    0 18rpx 46rpx rgba(100, 116, 139, 0.12);
  z-index: 2;
  overflow: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.ring-inner-disc {
  position: absolute;
  width: 216rpx;
  height: 216rpx;
  border-radius: 108rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  box-shadow:
    inset 0 10rpx 18rpx rgba(255, 255, 255, 0.88),
    0 12rpx 34rpx rgba(148, 163, 184, 0.12);
  z-index: 3;
  overflow: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.calorie-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 392rpx;
  height: 392rpx;
  z-index: 4;
  background: transparent !important;
  transition: opacity 0.2s ease;
}

.calorie-canvas.canvas-hidden {
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

.ring-content {
  position: absolute;
  z-index: 5;
  text-align: center;
  width: 220rpx;
  height: 220rpx;
  justify-content: center;
  background: transparent !important;
}

.ring-label {
  font-size: 28rpx;
  color: #334155;
  font-weight: 700;
  letter-spacing: 0;
  background: transparent !important;
}

.ring-value {
  font-size: 82rpx;
  line-height: 1;
  font-weight: 500;
  color: #171827;
  margin: 10rpx 0 8rpx 0;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  background: transparent !important;
}

.ring-unit {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 700;
  background: transparent !important;
}

.over-limit-lbl {
  color: #EF4444 !important;
}

.over-limit-val {
  color: #EF4444 !important;
}

.danger-lbl {
  color: #EF4444 !important;
}

.danger-val {
  color: #EF4444 !important;
}

.warning-lbl {
  color: #D97706 !important;
}

.warning-val {
  color: #D97706 !important;
}

.nudge-warning-bar {
  margin: 16rpx 24rpx 0 24rpx;
  padding: 16rpx 20rpx;
  background: rgba(254, 242, 242, 0.95);
  border: 1rpx solid rgba(239, 68, 68, 0.4);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.15);
}

.btn-quick-photo {
  padding: 8rpx 18rpx;
  background: linear-gradient(135deg, #EF4444, #DC2626);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 10rpx rgba(239, 68, 68, 0.3);
}

.btn-quick-photo:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.water-reminder-bar {
  margin: 16rpx 24rpx 0 24rpx;
  padding: 16rpx 20rpx;
  background: rgba(239, 246, 255, 0.95);
  border: 1rpx solid rgba(59, 130, 246, 0.35);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.12);
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.water-reminder-left {
  flex: 1;
  margin-right: 16rpx;
  min-width: 0;
  display: flex;
  align-items: center;
}

.water-reminder-text {
  font-size: 22rpx;
  color: #1D4ED8;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}

.water-reminder-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.btn-quick-water {
  padding: 8rpx 18rpx;
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 10rpx rgba(59, 130, 246, 0.3);
}

.btn-quick-water:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.water-reminder-close {
  font-size: 24rpx;
  color: #93C5FD;
  padding: 4rpx 10rpx;
  font-weight: 700;
}

.water-reminder-close:active {
  color: #1D4ED8;
}

.water-subscribe-card {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #F0F9FF;
  border: 1rpx solid #BAE6FD;
  border-radius: 20rpx;
  box-sizing: border-box;
  width: 100%;
}

.water-subscribe-card:active {
  transform: scale(0.98);
  background: #E0F2FE;
}

.water-sub-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-right: 16rpx;
  min-width: 0;
}

.water-sub-icon {
  font-size: 34rpx;
  flex-shrink: 0;
}

.water-sub-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.water-sub-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0369A1;
  line-height: 1.3;
  white-space: nowrap;
}

.water-sub-desc {
  font-size: 18rpx;
  color: #64748B;
  margin-top: 4rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.water-sub-badge {
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #0284C7, #0369A1);
  border-radius: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(3, 105, 161, 0.25);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.water-sub-badge-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
  white-space: nowrap;
}

.water-sub-badge.active {
  background: linear-gradient(135deg, #10B981, #059669);
  box-shadow: 0 4rpx 10rpx rgba(16, 185, 129, 0.25);
}

.calorie-detail-text {
  font-size: 26rpx;
  color: #1F2937;
  margin-top: 14rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.bold-text {
  color: #111827;
  font-weight: 700;
}

.calorie-inline-slash {
  color: #94A3B8;
  font-weight: 500;
  font-size: 24rpx;
}

/* 🏃 同行单行运动胶囊样式 */
.exercise-inline-capsule {
  background: linear-gradient(135deg, rgba(14, 165, 233, 0.12) 0%, rgba(56, 189, 248, 0.18) 100%);
  border: 1.5rpx solid rgba(14, 165, 233, 0.35);
  border-radius: 20rpx;
  padding: 4rpx 14rpx 4rpx 10rpx;
  gap: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(14, 165, 233, 0.12);
  transition: all 0.2s ease;
  display: inline-flex;
}

.exercise-inline-capsule:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.capsule-icon {
  font-size: 24rpx;
}

.capsule-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #0284C7;
}

.capsule-val {
  font-size: 24rpx;
  font-weight: 800;
  color: #0EA5E9;
}

.capsule-add-plus {
  font-size: 22rpx;
  font-weight: 900;
  color: #FFFFFF;
  background: #0EA5E9;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 4rpx;
  line-height: 1;
}

/* 2. 三大营养素并列占比条 */
.nutrients-card {
  background: rgba(255, 255, 255, 0.65) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.6) !important;
  border-radius: 32rpx !important;
  padding: 20rpx 30rpx 24rpx 30rpx !important;
  margin-bottom: 40rpx !important;
  box-shadow: 0 10rpx 30rpx rgba(148, 163, 184, 0.03) !important;
}

.nutrients-header-row {
  margin-bottom: 16rpx;
  width: 100%;
}

.nutrients-header-title {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.nutrients-diag-trigger {
  background: rgba(59, 130, 246, 0.08);
  border: 1rpx solid rgba(59, 130, 246, 0.2);
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  transition: all 0.2s ease;
}

.nutrients-diag-trigger:active {
  transform: scale(0.95);
  background: rgba(59, 130, 246, 0.16);
}

.diag-trigger-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.diag-trigger-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #2563EB;
}

.macronutrient-bar {
  display: flex;
  height: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #E2E8F0;
  margin-bottom: 24rpx;
  width: 100%;
}

.bar-segment {
  height: 100%;
  transition: width 0.3s ease;
}

.bar-segment.carbs {
  background: linear-gradient(90deg, #2DD4BF, #0D9488);
}

.bar-segment.protein {
  background: linear-gradient(90deg, #818CF8, #4F46E5);
}

.bar-segment.fat {
  background: linear-gradient(90deg, #C084FC, #9333EA);
}

.macronutrient-labels {
  width: 100%;
}

.label-item {
  display: flex;
  align-items: center;
}

.bullet {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.bullet.carbs {
  background-color: #0D9488;
}

.bullet.protein {
  background-color: #4F46E5;
}

.bullet.fat {
  background-color: #9333EA;
}

.label-text {
  display: flex;
  flex-direction: column;
}

.lbl-title {
  font-size: 20rpx;
  color: #94A3B8;
  font-weight: 600;
}

.lbl-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
  margin-top: 4rpx;
}

.lbl-pct {
  font-size: 18rpx;
  color: #94A3B8;
  font-weight: 500;
  margin-left: 4rpx;
}

/* 3. 横向滑动三餐打卡记录卡片 */
.meal-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1E293B;
  letter-spacing: 1rpx;
}

.history-link-btn {
  font-size: 24rpx;
  color: #10B981;
  font-weight: 700;
  padding: 5rpx 15rpx;
}

.history-link-btn:active {
  opacity: 0.7;
}

.meal-scroll-row {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  width: 100%;
  box-sizing: border-box;
  padding: 10rpx 0;
}

.meal-card-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 196rpx;
  padding: 16rpx 12rpx 14rpx 12rpx;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 26rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 20rpx rgba(148, 163, 184, 0.03);
  box-sizing: border-box;
  text-align: center;
}

.meal-card-item:last-child {
  margin-right: 0;
}

.meal-img-wrapper {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #F8FAFC;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  overflow: hidden;
}

.meal-card-img {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
}

.meal-card-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 2rpx;
}

.meal-card-time {
  font-size: 18rpx;
  color: #94A3B8;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.meal-card-cal {
  font-size: 18rpx;
  font-weight: 700;
  color: #64748B;
  background-color: #F1F5F9;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.meal-card-cal.recorded {
  color: #10B981;
  background-color: #E6FDF4;
}

/* ===================== 悬浮饮水气泡 ===================== */
.fab-movable-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 999;
  background: transparent;
}
.fab-movable-view {
  width: 92rpx;
  height: 92rpx;
  pointer-events: auto;
}
.water-fab {
  width: 92rpx;
  height: 92rpx;
  animation: fabFloat 4s ease-in-out infinite;
  transition: opacity 0.3s, transform 0.3s;
  filter: drop-shadow(0 12rpx 22rpx rgba(37, 99, 235, 0.22));
  -webkit-filter: drop-shadow(0 12rpx 22rpx rgba(37, 99, 235, 0.22));
}
.water-fab.hide {
  opacity: 0;
  transform: scale(0.5);
  pointer-events: none;
}
.water-fab-inner {
  width: 92rpx;
  height: 92rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(150deg, rgba(239, 249, 255, 0.92), rgba(191, 219, 254, 0.72));
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  box-shadow:
    inset 0 8rpx 18rpx rgba(255, 255, 255, 0.72),
    inset 0 -10rpx 18rpx rgba(37, 99, 235, 0.12);
}
.water-fab-fill {
  position: absolute;
  left: -8rpx;
  right: -8rpx;
  bottom: -2rpx;
  min-height: 0;
  max-height: 108%;
  background: linear-gradient(180deg, #67E8F9 0%, #38BDF8 46%, #3B82F6 100%);
  transition: height 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
  z-index: 1;
}
.fab-wave {
  position: absolute;
  top: -12rpx;
  left: -50%;
  width: 200%;
  height: 24rpx;
  border-radius: 50%;
}
.fab-wave1 {
  background: rgba(255, 255, 255, 0.42);
  animation: fabWaveAni 2.5s ease-in-out infinite;
}
.fab-wave2 {
  top: -8rpx;
  background: rgba(255, 255, 255, 0.24);
  animation: fabWaveAni 3.5s ease-in-out infinite reverse;
}
.water-fab-highlight {
  position: absolute;
  top: 16rpx;
  left: 22rpx;
  width: 14rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.62);
  transform: rotate(24deg);
  z-index: 3;
  pointer-events: none;
}
@keyframes fabWaveAni {
  0%   { transform: translateX(0)   rotate(0deg); }
  50%  { transform: translateX(25%) rotate(3deg); }
  100% { transform: translateX(0)   rotate(0deg); }
}
.water-fab-inner::after {
  content: '';
  position: absolute;
  left: 9rpx;
  right: 9rpx;
  top: 9rpx;
  bottom: 9rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  z-index: 1;
  pointer-events: none;
}
.water-fab-content {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
}
.water-fab-pct {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 900;
  text-shadow: 0 2rpx 7rpx rgba(30, 64, 175, 0.5);
}
@keyframes fabFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

/* ===================== 底部饮水抽屉遮罩 ===================== */
.water-sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1050;
  background: rgba(15, 23, 42, 0);
  pointer-events: none;
  transition: background 0.35s;
}
.water-sheet-mask.active {
  background: rgba(15, 23, 42, 0.45);
  pointer-events: auto;
}

/* ===================== 抽屉主体 ===================== */
.water-sheet {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  z-index: 1051;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 40rpx 40rpx 0 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.8);
  padding: 20rpx 40rpx 60rpx 40rpx;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -16rpx 64rpx rgba(15, 23, 42, 0.08);
}
.water-sheet-mask.active .water-sheet {
  transform: translateY(0);
}
.water-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(203, 213, 225, 0.8);
  margin: 0 auto 24rpx auto;
}
.water-sheet-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #1E293B;
  margin-bottom: 32rpx;
}

/* ===================== 动态水杯 ===================== */
.water-cup-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}
.water-cup {
  position: relative;
  width: 240rpx;
  height: 320rpx;
  border-radius: 16rpx 16rpx 40rpx 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.25);
  box-shadow: 
    0 16rpx 40rpx rgba(148, 163, 184, 0.06), 
    inset 0 4rpx 12rpx rgba(255, 255, 255, 0.5),
    0 0 0 1rpx rgba(226, 232, 240, 0.8);
}
.water-cup::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.6);
}
.water-fill {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, #38BDF8 0%, #6366F1 100%);
  transition: height 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  min-height: 0;
  max-height: 100%;
}

/* 波浪动画 */
.wave {
  position: absolute;
  top: -20rpx;
  left: -50%;
  width: 200%;
  height: 40rpx;
  border-radius: 43%;
}
.wave1 {
  background: rgba(255,255,255,0.3);
  animation: waveAni 2.5s ease-in-out infinite;
}
.wave2 {
  background: rgba(255,255,255,0.18);
  animation: waveAni 3.5s ease-in-out infinite reverse;
  top: -14rpx;
}
@keyframes waveAni {
  0%   { transform: translateX(0)   rotate(0deg); }
  50%  { transform: translateX(25%) rotate(3deg); }
  100% { transform: translateX(0)   rotate(0deg); }
}

