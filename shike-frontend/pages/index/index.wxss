/* ===================== 今日运动记录 ===================== */
.exercise-section {
  width: 100%;
  margin-top: 36rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.add-exercise-btn {
  font-size: 24rpx;
  color: #0EA5E9;
  font-weight: 700;
  background: rgba(14, 165, 233, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
}

.exercise-card {
  margin-top: 20rpx;
  padding: 24rpx 32rpx;
}

.exercise-list {
  display: flex;
  flex-direction: column;
}

.exercise-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.4);
}

.exercise-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.exercise-item:first-child {
  padding-top: 0;
}

.exercise-info {
  display: flex;
  flex: 1;
}

.exercise-icon {
  width: 64rpx;
  height: 64rpx;
  background: rgba(14, 165, 233, 0.1);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.exercise-details {
  display: flex;
}

.exercise-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #1E293B;
  line-height: 1.3;
}

.exercise-time {
  font-size: 18rpx;
  color: #94A3B8;
  font-weight: 500;
  margin-top: 4rpx;
}

.exercise-right {
  display: flex;
}

.exercise-cal {
  font-size: 26rpx;
  font-weight: 800;
  color: #0EA5E9;
}

.exercise-delete-btn {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(241, 245, 249, 0.8);
  color: #94A3B8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
  margin-left: 20rpx;
  transition: background 0.2s;
}

.exercise-delete-btn:active {
  background: #F1F5F9;
  color: #EF4444;
}

.exercise-empty {
  padding: 40rpx 0;
  text-align: center;
}

.exercise-empty-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
  opacity: 0.7;
}

.exercise-empty-text {
  font-size: 22rpx;
  color: #94A3B8;
  font-weight: 500;
}

