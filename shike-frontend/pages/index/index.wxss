.container {
  padding: 30rpx 40rpx 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #F3F6F8 0%, #EBF4F6 100%);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 0. 顶部导航/状态栏 */
.app-header {
  width: 100%;
  padding: 10rpx 0 30rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-icon-btn {
  font-size: 36rpx;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 24rpx rgba(148, 163, 184, 0.05);
}

.header-title-wrapper {
  text-align: center;
}

.header-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1E293B;
  letter-spacing: 2rpx;
}

.header-date {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 6rpx;
  font-weight: 600;
}

.header-avatar-btn {
  position: relative;
  width: 68rpx;
  height: 68rpx;
}

.header-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.avatar-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 12rpx;
  height: 12rpx;
  background-color: #EF4444;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
}

/* 1. 今日热量大环形看板 */
.calorie-board-container {
  width: 100%;
  margin: 26rpx 0 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.calorie-ring-wrapper {
  width: 392rpx;
  height: 392rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.ring-outer-glow {
  position: absolute;
  width: 362rpx;
  height: 362rpx;
  border-radius: 181rpx;
  box-sizing: border-box;
  background: rgba(248, 252, 253, 0.82);
  box-shadow:
    0 26rpx 48rpx rgba(100, 116, 139, 0.12),
    0 0 42rpx rgba(255, 255, 255, 0.9);
  z-index: 1;
  overflow: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.ring-glass-disc {
  position: absolute;
  width: 286rpx;
  height: 286rpx;
  border-radius: 143rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(231, 240, 245, 0.72));
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow:
    inset 18rpx 18rpx 34rpx rgba(148, 163, 184, 0.12),
    inset -18rpx -18rpx 34rpx rgba(255, 255, 255, 0.96),
    0 18rpx 46rpx rgba(100, 116, 139, 0.12);
  z-index: 2;
  overflow: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.ring-inner-disc {
  position: absolute;
  width: 216rpx;
  height: 216rpx;
  border-radius: 108rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  box-shadow:
    inset 0 10rpx 18rpx rgba(255, 255, 255, 0.88),
    0 12rpx 34rpx rgba(148, 163, 184, 0.12);
  z-index: 3;
  overflow: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.calorie-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 392rpx;
  height: 392rpx;
  z-index: 4;
  background: transparent !important;
}

.ring-content {
  position: absolute;
  z-index: 5;
  text-align: center;
  width: 220rpx;
  height: 220rpx;
  justify-content: center;
  background: transparent !important;
}

.ring-label {
  font-size: 28rpx;
  color: #334155;
  font-weight: 700;
  letter-spacing: 0;
  background: transparent !important;
}

.ring-value {
  font-size: 82rpx;
  line-height: 1;
  font-weight: 500;
  color: #171827;
  margin: 10rpx 0 8rpx 0;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  background: transparent !important;
}

.ring-unit {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 700;
  background: transparent !important;
}

.over-limit-lbl {
  color: #EF4444 !important;
}

.over-limit-val {
  color: #EF4444 !important;
}

.calorie-detail-text {
  font-size: 26rpx;
  color: #1F2937;
  margin-top: 18rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.bold-text {
  color: #111827;
  font-weight: 700;
}

/* 2. 三大营养素并列占比条 */
.nutrients-card {
  background: rgba(255, 255, 255, 0.65) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.6) !important;
  border-radius: 32rpx !important;
  padding: 24rpx 30rpx !important;
  margin-bottom: 40rpx !important;
  box-shadow: 0 10rpx 30rpx rgba(148, 163, 184, 0.03) !important;
}

.macronutrient-bar {
  display: flex;
  height: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #E2E8F0;
  margin-bottom: 24rpx;
  width: 100%;
}

.bar-segment {
  height: 100%;
  transition: width 0.3s ease;
}

.bar-segment.carbs {
  background: linear-gradient(90deg, #2DD4BF, #0D9488);
}

.bar-segment.protein {
  background: linear-gradient(90deg, #818CF8, #4F46E5);
}

.bar-segment.fat {
  background: linear-gradient(90deg, #C084FC, #9333EA);
}

.macronutrient-labels {
  width: 100%;
}

.label-item {
  display: flex;
  align-items: center;
}

.bullet {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.bullet.carbs {
  background-color: #0D9488;
}

.bullet.protein {
  background-color: #4F46E5;
}

.bullet.fat {
  background-color: #9333EA;
}

.label-text {
  display: flex;
  flex-direction: column;
}

.lbl-title {
  font-size: 20rpx;
  color: #94A3B8;
  font-weight: 600;
}

.lbl-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
  margin-top: 4rpx;
}

.lbl-pct {
  font-size: 18rpx;
  color: #94A3B8;
  font-weight: 500;
  margin-left: 4rpx;
}

/* 3. 横向滑动三餐打卡记录卡片 */
.meal-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1E293B;
  letter-spacing: 1rpx;
}

.history-link-btn {
  font-size: 24rpx;
  color: #10B981;
  font-weight: 700;
  padding: 5rpx 15rpx;
}

.history-link-btn:active {
  opacity: 0.7;
}

.meal-scroll-row {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  width: 100%;
  box-sizing: border-box;
  padding: 10rpx 0;
}

.meal-card-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 196rpx;
  padding: 36rpx 16rpx 28rpx 16rpx;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 36rpx;
  flex-shrink: 0;
  box-shadow: 0 10rpx 30rpx rgba(148, 163, 184, 0.04);
  box-sizing: border-box;
  text-align: center;
}

.meal-card-item:last-child {
  margin-right: 0;
}

.meal-img-wrapper {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #F8FAFC;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
}

.meal-card-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.meal-card-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 4rpx;
}

.meal-card-time {
  font-size: 20rpx;
  color: #94A3B8;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.meal-card-cal {
  font-size: 20rpx;
  font-weight: 700;
  color: #64748B;
  background-color: #F1F5F9;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.meal-card-cal.recorded {
  color: #10B981;
  background-color: #E6FDF4;
}

/* ===================== 悬浮饮水气泡 ===================== */
.water-fab {
  position: fixed;
  right: 34rpx;
  bottom: 186rpx;
  z-index: 999;
  animation: fabFloat 4s ease-in-out infinite;
  transition: opacity 0.3s, transform 0.3s;
  filter: drop-shadow(0 12rpx 22rpx rgba(37, 99, 235, 0.22));
  -webkit-filter: drop-shadow(0 12rpx 22rpx rgba(37, 99, 235, 0.22));
}
.water-fab.hide {
  opacity: 0;
  transform: scale(0.5);
  pointer-events: none;
}
.water-fab-inner {
  width: 92rpx;
  height: 92rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(150deg, rgba(239, 249, 255, 0.92), rgba(191, 219, 254, 0.72));
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  box-shadow:
    inset 0 8rpx 18rpx rgba(255, 255, 255, 0.72),
    inset 0 -10rpx 18rpx rgba(37, 99, 235, 0.12);
}
.water-fab-fill {
  position: absolute;
  left: -8rpx;
  right: -8rpx;
  bottom: -2rpx;
  min-height: 0;
  max-height: 108%;
  background: linear-gradient(180deg, #67E8F9 0%, #38BDF8 46%, #3B82F6 100%);
  transition: height 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
  z-index: 1;
}
.fab-wave {
  position: absolute;
  top: -12rpx;
  left: -50%;
  width: 200%;
  height: 24rpx;
  border-radius: 50%;
}
.fab-wave1 {
  background: rgba(255, 255, 255, 0.42);
  animation: fabWaveAni 2.5s ease-in-out infinite;
}
.fab-wave2 {
  top: -8rpx;
  background: rgba(255, 255, 255, 0.24);
  animation: fabWaveAni 3.5s ease-in-out infinite reverse;
}
.water-fab-highlight {
  position: absolute;
  top: 16rpx;
  left: 22rpx;
  width: 14rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.62);
  transform: rotate(24deg);
  z-index: 3;
  pointer-events: none;
}
@keyframes fabWaveAni {
  0%   { transform: translateX(0)   rotate(0deg); }
  50%  { transform: translateX(25%) rotate(3deg); }
  100% { transform: translateX(0)   rotate(0deg); }
}
.water-fab-inner::after {
  content: '';
  position: absolute;
  left: 9rpx;
  right: 9rpx;
  top: 9rpx;
  bottom: 9rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  z-index: 1;
  pointer-events: none;
}
.water-fab-content {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
}
.water-fab-pct {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 900;
  text-shadow: 0 2rpx 7rpx rgba(30, 64, 175, 0.5);
}
@keyframes fabFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

/* ===================== 底部饮水抽屉遮罩 ===================== */
.water-sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1050;
  background: rgba(15, 23, 42, 0);
  pointer-events: none;
  transition: background 0.35s;
}
.water-sheet-mask.active {
  background: rgba(15, 23, 42, 0.45);
  pointer-events: auto;
}

/* ===================== 抽屉主体 ===================== */
.water-sheet {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  z-index: 1051;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 40rpx 40rpx 0 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.8);
  padding: 20rpx 40rpx 60rpx 40rpx;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -16rpx 64rpx rgba(15, 23, 42, 0.08);
}
.water-sheet-mask.active .water-sheet {
  transform: translateY(0);
}
.water-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(203, 213, 225, 0.8);
  margin: 0 auto 24rpx auto;
}
.water-sheet-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #1E293B;
  margin-bottom: 32rpx;
}

/* ===================== 动态水杯 ===================== */
.water-cup-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}
.water-cup {
  position: relative;
  width: 240rpx;
  height: 320rpx;
  border-radius: 16rpx 16rpx 40rpx 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.25);
  box-shadow: 
    0 16rpx 40rpx rgba(148, 163, 184, 0.06), 
    inset 0 4rpx 12rpx rgba(255, 255, 255, 0.5),
    0 0 0 1rpx rgba(226, 232, 240, 0.8);
}
.water-cup::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.6);
}
.water-fill {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, #38BDF8 0%, #6366F1 100%);
  transition: height 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  min-height: 0;
  max-height: 100%;
}

/* 波浪动画 */
.wave {
  position: absolute;
  top: -20rpx;
  left: -50%;
  width: 200%;
  height: 40rpx;
  border-radius: 43%;
}
.wave1 {
  background: rgba(255,255,255,0.3);
  animation: waveAni 2.5s ease-in-out infinite;
}
.wave2 {
  background: rgba(255,255,255,0.18);
  animation: waveAni 3.5s ease-in-out infinite reverse;
  top: -14rpx;
}
@keyframes waveAni {
  0%   { transform: translateX(0)   rotate(0deg); }
  50%  { transform: translateX(25%) rotate(3deg); }
  100% { transform: translateX(0)   rotate(0deg); }
}

.cup-label {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.cup-amount {
  font-size: 52rpx;
  font-weight: 900;
  color: #FFF;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  line-height: 1.1;
}
.cup-unit {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  font-weight: 700;
}

/* ===================== 数据统计行 ===================== */
.water-stats {
  text-align: center;
  margin-bottom: 32rpx;
}
.water-stats-text {
  font-size: 26rpx;
  color: #64748B;
  font-weight: 600;
}

/* ===================== 操作按钮组 ===================== */
.water-actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}
.water-btn {
  flex: 1;
  max-width: 220rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  transition: transform 0.15s, box-shadow 0.15s;
}
.water-btn:active {
  transform: scale(0.94);
}
.water-btn.minus {
  background: rgba(241, 245, 249, 0.8);
  color: #64748B;
  border: 1rpx solid rgba(226, 232, 240, 0.8);
}
.water-btn.plus {
  background: linear-gradient(135deg, #2DD4BF 0%, #10B981 100%);
  color: #FFF;
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.2);
}
.water-btn.plus.big {
  background: linear-gradient(135deg, #0EA5E9 0%, #2563EB 100%);
  color: #FFF;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.25);
}

/* ===================== AI 识别结果弹窗 ===================== */
.ai-result-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.editable-food-list {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.45);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  padding: 16rpx 20rpx;
  overflow: hidden;
}

.editable-food-header {
  display: flex;
  font-size: 22rpx;
  color: #64748B;
  font-weight: 700;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(203, 213, 225, 0.4);
  margin-bottom: 12rpx;
  align-items: center;
}

.food-header-col-name {
  flex: 3;
}

.food-header-col-weight {
  flex: 2;
  text-align: center;
}

.food-header-col-cal {
  flex: 2.2;
  text-align: center;
}

.food-header-col-del {
  width: 44rpx;
}

.food-list-scroll {
  width: 100%;
  height: 220rpx;
}

.food-item-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 8rpx;
  width: 100%;
}

.food-input {
  height: 54rpx;
  font-size: 26rpx;
  color: #1E293B;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(203, 213, 225, 0.6);
  border-radius: 12rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.food-input.name {
  flex: 3;
}

.food-input.weight {
  flex: 2;
  text-align: center;
}

.food-input.calories {
  flex: 2.2;
  text-align: center;
}

.food-delete-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #EF4444;
  font-size: 24rpx;
  font-weight: bold;
  background: rgba(239, 68, 68, 0.08);
  border-radius: 50%;
}

.food-delete-btn:active {
  transform: scale(0.9);
}

.match-suggestion-toast {
  width: 100%;
  font-size: 20rpx;
  color: #10B981;
  background-color: #E6FDF4;
  border: 1rpx solid rgba(16, 185, 129, 0.2);
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  margin-top: 4rpx;
  box-sizing: border-box;
}

.add-food-row {
  display: flex;
  justify-content: center;
  margin: 16rpx 0;
}

.add-food-btn {
  font-size: 24rpx;
  color: #10B981;
  font-weight: 700;
  background: rgba(16, 185, 129, 0.08);
  border: 1rpx dashed rgba(16, 185, 129, 0.4);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
}

.add-food-btn:active {
  transform: scale(0.95);
}

.portion-helper-card {
  background: rgba(248, 250, 252, 0.6);
  border-radius: 16rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  padding: 12rpx 16rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.portion-helper-title {
  font-size: 20rpx;
  color: #64748B;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.portion-helper-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.portion-helper-tag {
  font-size: 18rpx;
  color: #475569;
  background: #FFF;
  border: 1rpx solid #E2E8F0;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.portion-helper-tag:active {
  background: #F1F5F9;
}

.ai-result-cal-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(203, 213, 225, 0.4);
  width: 100%;
}

.ai-result-cal-label {
  font-size: 26rpx;
  color: #64748B;
  font-weight: 700;
}

.ai-result-cal-value {
  font-size: 30rpx;
  color: #10B981;
  font-weight: 800;
}

.ai-result-hint {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 12rpx;
  width: 100%;
}

.ai-result-icon.fail {
  font-size: 80rpx;
