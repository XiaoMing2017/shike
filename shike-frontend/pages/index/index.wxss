  line-height: 1.6;
  font-weight: 500;
}

/* ---------------------------------------------------- */
/* 5. 近7天热量周看板 Styles */
/* ---------------------------------------------------- */

.dashboard-header .card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1E293B;
  letter-spacing: 0.5rpx;
}

/* 概览总览卡片 Summary Card */
.week-summary-card {
  background: rgba(255, 255, 255, 0.75) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.8) !important;
  border-radius: 32rpx !important;
  padding: 28rpx 32rpx !important;
  margin-bottom: 28rpx !important;
  box-shadow: 0 12rpx 36rpx rgba(148, 163, 184, 0.08) !important;
}

.week-summary-header {
  margin-bottom: 24rpx;
}

.week-period-box {
  gap: 8rpx;
}

.week-period-icon {
  font-size: 26rpx;
}

.week-period-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #475569;
}

.health-rating-badge {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  gap: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.25);
}

.rating-star {
  font-size: 22rpx;
}

.rating-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.week-metrics-grid {
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.week-metrics-grid .metric-item {
  width: 47%;
  background: rgba(248, 250, 252, 0.85);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  border-radius: 24rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
}

.metric-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F172A;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  white-space: nowrap;
  line-height: 1.2;
}

.metric-val.deficit-val {
  color: #10B981;
}

.metric-unit {
  font-size: 18rpx;
  font-weight: 600;
  color: #64748B;
  margin-left: 2rpx;
}

.metric-lbl {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 6rpx;
  font-weight: 600;
}

.week-eval-box {
  background: rgba(245, 158, 11, 0.08);
  border-left: 6rpx solid #F59E0B;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-top: 14rpx;
}

.eval-text {
  font-size: 24rpx;
  color: #B45309;
  line-height: 1.5;
  font-weight: 600;
}

/* 7天柱状图表卡片 Bar Chart Card */
.week-chart-card {
  background: rgba(255, 255, 255, 0.75) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.8) !important;
  border-radius: 32rpx !important;
  padding: 28rpx 24rpx 24rpx 24rpx !important;
  margin-bottom: 28rpx !important;
  box-shadow: 0 12rpx 36rpx rgba(148, 163, 184, 0.08) !important;
}

.week-card-title .card-title-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #1E293B;
}

.chart-container {
  height: 270rpx;
  margin-top: 24rpx;
  padding-bottom: 8rpx;
}

.chart-col {
  height: 100%;
}

.bar-top-val {
  font-size: 18rpx;
  font-weight: 700;
  color: #64748B;
  margin-bottom: 6rpx;
}

.bar-track {
  width: 36rpx;
  height: 150rpx;
  background: rgba(226, 232, 240, 0.6);
  border-radius: 18rpx;
  position: relative;
  overflow: hidden;
}

.bar-fill-intake {
  width: 100%;
  border-radius: 18rpx;
  transition: height 0.4s ease;
}

.bar-fill-intake.deficit-bar {
  background: linear-gradient(180deg, #34D399 0%, #10B981 100%);
}

.bar-fill-intake.surplus-bar {
  background: linear-gradient(180deg, #FBBF24 0%, #F59E0B 100%);
}

.status-badge {
  margin-top: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.status-badge.status-deficit {
  background: #ECFDF5;
}

.status-badge.status-deficit .status-badge-text {
  color: #047857;
}

.status-badge.status-surplus {
  background: #FFFBEB;
}

.status-badge.status-surplus .status-badge-text {
  color: #B45309;
}

.status-badge-text {
  font-size: 18rpx;
  font-weight: 800;
}

.day-label-box {
  margin-top: 8rpx;
  gap: 4rpx;
}

.day-label-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #64748B;
}

.day-label-text.today-text {
  color: #10B981;
  font-weight: 800;
}

.today-badge {
  background: #10B981;
  color: #FFFFFF;
  font-size: 16rpx;
  font-weight: 700;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
}

.chart-legend {
  margin-top: 24rpx;
  gap: 36rpx;
  border-top: 1rpx dashed rgba(203, 213, 225, 0.6);
  padding-top: 18rpx;
}

.legend-item {
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.green-dot {
  background: #10B981;
}

.legend-dot.orange-dot {
  background: #F59E0B;
}

.legend-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #64748B;
}

/* 三大营养素占比卡片 Macro Card */
.week-macro-card {
  background: rgba(255, 255, 255, 0.75) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.8) !important;
  border-radius: 32rpx !important;
  padding: 28rpx 32rpx !important;
  margin-bottom: 40rpx !important;
  box-shadow: 0 12rpx 36rpx rgba(148, 163, 184, 0.08) !important;
}

.week-macro-bar {
  height: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F1F5F9;
  margin: 24rpx 0;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.macro-segment {
  height: 100%;
  transition: width 0.4s ease;
}

.macro-segment.protein-seg {
  background: #3B82F6;
}

.macro-segment.carbs-seg {
  background: #10B981;
}

.macro-segment.fat-seg {
  background: #F59E0B;
}

.week-macro-details {
  margin-top: 10rpx;
}

.macro-detail-item {
  gap: 12rpx;
}

.macro-bullet {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.macro-bullet.protein-bullet {
  background: #3B82F6;
}

.macro-bullet.carbs-bullet {
  background: #10B981;
}

.macro-bullet.fat-bullet {
  background: #F59E0B;
}

.macro-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748B;
}

.macro-val {
  font-size: 24rpx;
  font-weight: 800;
  color: #0F172A;
  margin-top: 2rpx;
}

.macro-pct {
  font-size: 20rpx;
  font-weight: 600;
  color: #64748B;
}

/* 快捷返回导航条 Back Bar */
.back-to-today-bar {
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(16, 185, 129, 0.3);
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.1);
}

.back-icon {
  font-size: 28rpx;
  font-weight: 900;
  color: #10B981;
}

.back-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #0F172A;
}

.back-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: #10B981;
}

/* 修复未记录/正常状态标签 */
.status-badge.status-normal {
  background: #F1F5F9;
}

.status-badge.status-normal .status-badge-text {
  color: #94A3B8;
}

/* 底部返回大按钮 Bottom Button */
.back-to-day-bottom-btn {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 36rpx;
  padding: 28rpx 0;
  margin: 36rpx 10rpx 60rpx 10rpx;
  box-shadow: 0 12rpx 36rpx rgba(16, 185, 129, 0.3);
  gap: 12rpx;
}

.back-to-day-bottom-btn .btn-icon {
  font-size: 32rpx;
}

.back-to-day-bottom-btn .btn-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

/* 月看板 Month Dashboard Specific Styles */
.month-summary-card {
  margin-bottom: 28rpx !important;
}

.month-chart-card {
  margin-bottom: 28rpx !important;
}

.month-chart-card .chart-container {
  width: 100% !important;
  display: flex !important;
  justify-content: space-around !important;
  align-items: flex-end !important;
  box-sizing: border-box !important;
  padding: 0 10rpx !important;
}

.month-chart-card .chart-col {
  flex: 1 !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  min-width: 0 !important;
}

.month-chart-card .bar-track {
  width: 44rpx !important;
  height: 150rpx !important;
  background: rgba(241, 245, 249, 0.95) !important;
  border-radius: 22rpx !important;
  position: relative !important;
  overflow: hidden !important;
}

.month-chart-card .bar-fill-intake {
  width: 100% !important;
  border-radius: 22rpx !important;
}

.month-macro-card {
  margin-bottom: 28rpx !important;
}

.month-week-label-box {
  margin-top: 10rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.day-label-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #334155;
}

.week-period-sub {
  font-size: 18rpx;
  color: #94A3B8;
  margin-top: 2rpx;
  font-weight: 500;
  white-space: nowrap;
  letter-spacing: -0.5rpx;
}

.metric-val.surplus-val {
  color: #F59E0B;
}

/* 体重周期卡片与弹窗 CSS */
.week-weight-card, .month-weight-card {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
}

.weight-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}

.record-weight-btn {
  font-size: 22rpx;
  font-weight: 700;
  color: #10B981;
  background: #ECFDF5;
  border: 1rpx solid #A7F3D0;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

.weight-metrics-row {
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: none;
  overflow: hidden;
}

.weight-metric-box .w-lbl, .m-w-lbl {
  font-size: 20rpx;
  color: #64748B;
  display: block;
}

.weight-metric-box .w-val, .m-w-val {
  font-size: 32rpx;
  font-weight: 800;
  color: #1E293B;
  margin-top: 4rpx;
  display: block;
}

.weight-metric-box .w-val.highlight {
  color: #10B981;
}

.w-change-badge {
  font-size: 22rpx;
  font-weight: 800;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  box-shadow: none;
}

.w-change-badge.loss {
  color: #10B981;
  background: #ECFDF5;
}

.w-change-badge.gain {
  color: #EF4444;
  background: #FEF2F2;
}

.w-change-badge.flat {
  color: #64748B;
  background: #F1F5F9;
  box-shadow: none;
}

.highlight-change.loss {
  color: #10B981;
  background: transparent;
}

.highlight-change.gain {
  color: #EF4444;
  background: transparent;
}

.highlight-change.flat {
  color: #64748B;
  background: transparent;
}

.w-arrow {
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 2rpx;
}

.month-weight-summary-grid {
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

/* 体重 Modal 弹窗 */
.weight-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(8px);
  z-index: 1000;
}

.weight-modal-dialog {
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 36rpx;
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.3);
}

.weight-modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
}

.weight-modal-close {
  font-size: 40rpx;
  color: #94A3B8;
  padding: 0 10rpx;
}

.weight-input-box {
  background: #F1F5F9;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  margin-top: 24rpx;
}

.weight-input {
  font-size: 48rpx;
  font-weight: 800;
  color: #10B981;
  text-align: center;
  width: 200rpx;
}

.weight-unit-lbl {
  font-size: 28rpx;
  font-weight: 700;
  color: #64748B;
  margin-left: 8rpx;
}

.quick-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #475569;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
}

.btn-cancel {
  background: #F1F5F9;
  color: #64748B;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 20rpx;
  flex: 1;
}

.btn-submit {
  background: linear-gradient(135deg, #10B981, #059669);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 20rpx;
  flex: 1.5;
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.3);
}

