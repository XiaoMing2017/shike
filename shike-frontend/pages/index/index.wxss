.form-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #475569;
  margin-bottom: 12rpx;
}

.form-input {
  background: rgba(241, 245, 249, 0.7);
  border: 1.5rpx solid rgba(226, 232, 240, 0.8);
  border-radius: 20rpx;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #1E293B;
  font-weight: 600;
}

.picker-value-box {
  background: rgba(241, 245, 249, 0.7);
  border: 1.5rpx solid rgba(226, 232, 240, 0.8);
